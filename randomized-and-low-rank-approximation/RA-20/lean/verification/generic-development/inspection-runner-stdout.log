theorem NLA.RA20.generic_data_intersection_proved : ∀ (q : NLA.RA20.Poly 3),
  (∃ U, Matrix.IsSymm U ∧ (MvPolynomial.eval (NLA.RA20.coordinates U)) q ≠ 0) →
    ∃ U, NLA.RA20.GenericData U ∧ (MvPolynomial.eval (NLA.RA20.coordinates U)) q ≠ 0 :=
fun q hq =>
  Exists.casesOn hq fun U h =>
    And.casesOn h fun hU hqU =>
      let f := (MvPolynomial.rename NLA.RA20.symmetricParameterIndex) q;
      have hf := fun hfzero =>
        hqU
          (have h := NLA.RA20.eval_rename_symmetricParameter (NLA.RA20.symmetricDataCoordinates U) q;
          id
            (fun h =>
              Eq.symm
                (Eq.mp
                  (congrArg (fun _a => _a = (MvPolynomial.eval (NLA.RA20.coordinates U)) q)
                    (map_zero (MvPolynomial.eval (NLA.RA20.symmetricDataCoordinates U))))
                  (Eq.mp
                    (congrArg
                      (fun _a =>
                        (MvPolynomial.eval (NLA.RA20.symmetricDataCoordinates U)) _a =
                          (MvPolynomial.eval (NLA.RA20.coordinates U)) q)
                      hfzero)
                    h)))
            (Eq.mp
              (congrArg
                (fun _a =>
                  (MvPolynomial.eval (NLA.RA20.symmetricDataCoordinates U))
                      ((MvPolynomial.rename NLA.RA20.symmetricParameterIndex) q) =
                    (MvPolynomial.eval (NLA.RA20.coordinates _a)) q)
                (NLA.RA20.symmetricParameter_reconstruct U hU))
              h));
      let g := f * MvPolynomial.X 3 * MvPolynomial.X 4 * MvPolynomial.X 5;
      have hg :=
        id
          (mul_ne_zero (mul_ne_zero (mul_ne_zero hf (MvPolynomial.X_ne_zero 3)) (MvPolynomial.X_ne_zero 4))
            (MvPolynomial.X_ne_zero 5));
      have hex :=
        Decidable.byContradiction fun hn =>
          hg
            (MvPolynomial.funext fun z =>
              Eq.mpr (id (congrArg (Eq ((MvPolynomial.eval z) g)) (map_zero (MvPolynomial.eval z))))
                (Eq.mp
                  (Eq.trans (Mathlib.Tactic.Push.not_exists._simp_1 fun z => (MvPolynomial.eval z) g ≠ 0)
                    (forall_congr fun z => Classical.not_not._simp_2))
                  hn z));
      Exists.casesOn hex fun z hz =>
        have hproduct :=
          Eq.mpr
            (id
              (congrFun' (congrArg Ne (congrArg (HMul.hMul ((MvPolynomial.eval z) f)) (mul_assoc (z 3) (z 4) (z 5))))
                0))
            (Eq.mp
              (congrFun'
                (congrArg Ne
                  (Eq.trans
                    (Eq.trans
                      (congrArg (⇑(MvPolynomial.eval z))
                        (Eq.trans (mul_assoc (f * MvPolynomial.X 3) (MvPolynomial.X 4) (MvPolynomial.X 5))
                          (mul_assoc f (MvPolynomial.X 3) (MvPolynomial.X 4 * MvPolynomial.X 5))))
                      (map_mul (MvPolynomial.eval z) f (MvPolynomial.X 3 * (MvPolynomial.X 4 * MvPolynomial.X 5))))
                    (congrArg (HMul.hMul ((MvPolynomial.eval z) f))
                      (Eq.trans (map_mul (MvPolynomial.eval z) (MvPolynomial.X 3) (MvPolynomial.X 4 * MvPolynomial.X 5))
                        (congr (congrArg HMul.hMul (MvPolynomial.eval_X 3))
                          (Eq.trans (map_mul (MvPolynomial.eval z) (MvPolynomial.X 4) (MvPolynomial.X 5))
                            (congr (congrArg HMul.hMul (MvPolynomial.eval_X 4)) (MvPolynomial.eval_X 5))))))))
                0)
              hz);
        And.casesOn (mul_ne_zero_iff.mp hproduct) fun hfz hcoords =>
          Exists.intro (NLA.RA20.symmetricParameter z)
            ⟨⟨NLA.RA20.symmetricParameter_isSymm z, id hcoords⟩,
              id
                (fun hfz =>
                  Eq.mp (congrArg (fun _a => _a ≠ 0) (NLA.RA20.eval_rename_symmetricParameter z q))
                    (Eq.mp
                      (congrArg (fun _a => (MvPolynomial.eval z) _a ≠ 0)
                        (have this := rfl;
                        this))
                      hfz))
                hfz⟩

