        NLA.KE04.column._proof_1))
    ((i : Fin n) → (fun (x : Fin n) => Real) i) fun (i : Fin n) => M i j
def NLA.KE04.act : {n m : Nat} →
  (M : NLA.KE04.Rect n m) →
    @LinearMap.{0, 0, 0, 0} Real Real Real.semiring Real.semiring
      (@RingHom.id.{0} Real (@Semiring.toNonAssocSemiring.{0} Real Real.semiring)) (NLA.KE04.Vec m) (NLA.KE04.Vec n)
