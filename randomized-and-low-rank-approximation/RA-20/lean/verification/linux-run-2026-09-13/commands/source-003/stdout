                  "source_lock_sha256": digest(LOCK), "tool_receipt": receipt,
                  "result": "comparator-accepted", "semantic_review": "not-performed-by-this-command"}
        (logdir / "result.json").write_text(json.dumps(result, indent=2) + "\n")
