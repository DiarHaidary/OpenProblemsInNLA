                                (Mathlib.Tactic.Ring.Common.mul_pf_left mu (Nat.rawCast 1)
                                  (Mathlib.Tactic.Ring.Common.mul_pf_right b (Nat.rawCast 1)
                                    (Mathlib.Meta.NormNum.IsInt.to_raw_eq
                                      (Mathlib.Meta.NormNum.isInt_mul (Eq.refl HMul.hMul)
                                        (Mathlib.Meta.NormNum.IsNat.to_isInt (Mathlib.Meta.NormNum.IsNat.of_raw ℝ 1))
                                        (Mathlib.Meta.NormNum.IsInt.of_raw ℝ (Int.negOfNat 1))
                                        (Eq.refl (Int.negOfNat 1))))))
                                (Mathlib.Tactic.Ring.Common.mul_zero (mu ^ Nat.rawCast 1 * Nat.rawCast 1))
                                (Mathlib.Tactic.Ring.Common.add_pf_add_zero
                                  (mu ^ Nat.rawCast 1 * (b ^ Nat.rawCast 1 * (Int.negOfNat 1).rawCast) + 0)))
                              (Mathlib.Tactic.Ring.Common.add_pf_add_gt
                                (mu ^ Nat.rawCast 1 * (b ^ Nat.rawCast 1 * (Int.negOfNat 1).rawCast))
                                (Mathlib.Tactic.Ring.Common.add_pf_add_zero (mu ^ Nat.rawCast 2 * Nat.rawCast 1 + 0))))
                            (Mathlib.Tactic.Ring.Common.add_mul
                              (Mathlib.Tactic.Ring.Common.mul_add
                                (Mathlib.Tactic.Ring.Common.mul_pf_right mu (Nat.rawCast 1)
                                  (Mathlib.Tactic.Ring.Common.mul_pf_left a (Nat.rawCast 1)
                                    (Mathlib.Meta.NormNum.IsInt.to_raw_eq
                                      (Mathlib.Meta.NormNum.isInt_mul (Eq.refl HMul.hMul)
                                        (Mathlib.Meta.NormNum.IsInt.of_raw ℝ (Int.negOfNat 1))
                                        (Mathlib.Meta.NormNum.IsNat.to_isInt (Mathlib.Meta.NormNum.IsNat.of_raw ℝ 1))
                                        (Eq.refl (Int.negOfNat 1))))))
                                (Mathlib.Tactic.Ring.Common.mul_add
                                  (Mathlib.Tactic.Ring.Common.mul_pf_left a (Nat.rawCast 1)
                                    (Mathlib.Tactic.Ring.Common.mul_pf_right b (Nat.rawCast 1)
                                      (Mathlib.Meta.NormNum.IsNat.to_raw_eq
                                        (Mathlib.Meta.NormNum.IsInt.to_isNat
                                          (Mathlib.Meta.NormNum.isInt_mul (Eq.refl HMul.hMul)
                                            (Mathlib.Meta.NormNum.IsInt.of_raw ℝ (Int.negOfNat 1))
                                            (Mathlib.Meta.NormNum.IsInt.of_raw ℝ (Int.negOfNat 1))
                                            (Eq.refl (Int.ofNat 1)))))))
                                  (Mathlib.Tactic.Ring.Common.mul_zero (a ^ Nat.rawCast 1 * (Int.negOfNat 1).rawCast))
                                  (Mathlib.Tactic.Ring.Common.add_pf_add_zero
                                    (a ^ Nat.rawCast 1 * (b ^ Nat.rawCast 1 * Nat.rawCast 1) + 0)))
                                (Mathlib.Tactic.Ring.Common.add_pf_add_lt
                                  (mu ^ Nat.rawCast 1 * (a ^ Nat.rawCast 1 * (Int.negOfNat 1).rawCast))
                                  (Mathlib.Tactic.Ring.Common.add_pf_zero_add
                                    (a ^ Nat.rawCast 1 * (b ^ Nat.rawCast 1 * Nat.rawCast 1) + 0))))
                              (Mathlib.Tactic.Ring.Common.zero_mul
                                (mu ^ Nat.rawCast 1 * Nat.rawCast 1 +
                                  (b ^ Nat.rawCast 1 * (Int.negOfNat 1).rawCast + 0)))
                              (Mathlib.Tactic.Ring.Common.add_pf_add_zero
                                (mu ^ Nat.rawCast 1 * (a ^ Nat.rawCast 1 * (Int.negOfNat 1).rawCast) +
                                  (a ^ Nat.rawCast 1 * (b ^ Nat.rawCast 1 * Nat.rawCast 1) + 0))))
                            (Mathlib.Tactic.Ring.Common.add_pf_add_gt
                              (mu ^ Nat.rawCast 1 * (a ^ Nat.rawCast 1 * (Int.negOfNat 1).rawCast))
                              (Mathlib.Tactic.Ring.Common.add_pf_add_lt
                                (mu ^ Nat.rawCast 1 * (b ^ Nat.rawCast 1 * (Int.negOfNat 1).rawCast))
                                (Mathlib.Tactic.Ring.Common.add_pf_add_lt (mu ^ Nat.rawCast 2 * Nat.rawCast 1)
                                  (Mathlib.Tactic.Ring.Common.add_pf_zero_add
                                    (a ^ Nat.rawCast 1 * (b ^ Nat.rawCast 1 * Nat.rawCast 1) + 0)))))))
                        (Mathlib.Tactic.Ring.cast_pos (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_one))
                        (Mathlib.Tactic.Ring.Common.add_mul
                          (Mathlib.Tactic.Ring.Common.mul_add
                            (Mathlib.Tactic.Ring.Common.mul_pf_left mu (Nat.rawCast 1)
                              (Mathlib.Tactic.Ring.Common.mul_pf_left a (Nat.rawCast 1)
                                (Mathlib.Meta.NormNum.IsInt.to_raw_eq
                                  (Mathlib.Meta.NormNum.isInt_mul (Eq.refl HMul.hMul)
                                    (Mathlib.Meta.NormNum.IsInt.of_raw ℝ (Int.negOfNat 1))
                                    (Mathlib.Meta.NormNum.IsNat.to_isInt (Mathlib.Meta.NormNum.IsNat.of_raw ℝ 1))
                                    (Eq.refl (Int.negOfNat 1))))))
                            (Mathlib.Tactic.Ring.Common.mul_zero
                              (mu ^ Nat.rawCast 1 * (a ^ Nat.rawCast 1 * (Int.negOfNat 1).rawCast)))
                            (Mathlib.Tactic.Ring.Common.add_pf_add_zero
                              (mu ^ Nat.rawCast 1 * (a ^ Nat.rawCast 1 * (Int.negOfNat 1).rawCast) + 0)))
                          (Mathlib.Tactic.Ring.Common.add_mul
                            (Mathlib.Tactic.Ring.Common.mul_add
                              (Mathlib.Tactic.Ring.Common.mul_pf_left mu (Nat.rawCast 1)
                                (Mathlib.Tactic.Ring.Common.mul_pf_left b (Nat.rawCast 1)
                                  (Mathlib.Meta.NormNum.IsInt.to_raw_eq
                                    (Mathlib.Meta.NormNum.isInt_mul (Eq.refl HMul.hMul)
                                      (Mathlib.Meta.NormNum.IsInt.of_raw ℝ (Int.negOfNat 1))
                                      (Mathlib.Meta.NormNum.IsNat.to_isInt (Mathlib.Meta.NormNum.IsNat.of_raw ℝ 1))
                                      (Eq.refl (Int.negOfNat 1))))))
                              (Mathlib.Tactic.Ring.Common.mul_zero
                                (mu ^ Nat.rawCast 1 * (b ^ Nat.rawCast 1 * (Int.negOfNat 1).rawCast)))
                              (Mathlib.Tactic.Ring.Common.add_pf_add_zero
                                (mu ^ Nat.rawCast 1 * (b ^ Nat.rawCast 1 * (Int.negOfNat 1).rawCast) + 0)))
                            (Mathlib.Tactic.Ring.Common.add_mul
                              (Mathlib.Tactic.Ring.Common.mul_add
                                (Mathlib.Tactic.Ring.Common.mul_pf_left mu (Nat.rawCast 2)
                                  (Mathlib.Meta.NormNum.IsNat.to_raw_eq
                                    (Mathlib.Meta.NormNum.isNat_mul (Eq.refl HMul.hMul)
                                      (Mathlib.Meta.NormNum.IsNat.of_raw ℝ 1) (Mathlib.Meta.NormNum.IsNat.of_raw ℝ 1)
                                      (Eq.refl 1))))
                                (Mathlib.Tactic.Ring.Common.mul_zero (mu ^ Nat.rawCast 2 * Nat.rawCast 1))
                                (Mathlib.Tactic.Ring.Common.add_pf_add_zero (mu ^ Nat.rawCast 2 * Nat.rawCast 1 + 0)))
                              (Mathlib.Tactic.Ring.Common.add_mul
