  ⟨reducedCoordinateEquiv, reducedCoordinateEquiv_mk_X⟩

#assert_trust kernel hollow_rank_le_two
#assert_trust kernel abcPolynomial_squarefree
#assert_trust kernel abcIdeal_vanishing
