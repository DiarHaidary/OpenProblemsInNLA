theorem NLA.RA20.hollow_variety_semantics_proved : (∀ (a b c : ℂ),
    (NLA.RA20.hollow a b c).det = 2 * a * b * c ∧ (NLA.RA20.hollow a b c ∈ NLA.RA20.variety 3 3 ↔ a * b * c = 0)) ∧
  ∀ (X : NLA.RA20.Mat 3),
    X ∈ NLA.RA20.variety 3 3 ↔ X = NLA.RA20.hollow (X 0 1) (X 0 2) (X 1 2) ∧ X 0 1 * X 0 2 * X 1 2 = 0 :=
⟨fun a b c => ⟨NLA.RA20.hollow_det a b c, NLA.RA20.hollow_mem_variety_iff a b c⟩, fun X =>
  {
    mp := fun h =>
      have he := NLA.RA20.matrix_eq_hollow_of_mem h;
      ⟨he, (NLA.RA20.hollow_mem_variety_iff (X 0 1) (X 0 2) (X 1 2)).mp (he ▸ h)⟩,
    mpr := fun a =>
      And.casesOn a fun he hz =>
        Eq.mpr (id (congrArg (fun _a => _a ∈ NLA.RA20.variety 3 3) he))
          ((NLA.RA20.hollow_mem_variety_iff (X 0 1) (X 0 2) (X 1 2)).mpr hz) }⟩
theorem NLA.RA20.abcIdeal_vanishing : MvPolynomial.vanishingIdeal ℂ {x | x 0 * x 1 * x 2 = 0} = NLA.RA20.abcIdeal :=
Eq.mpr
  (id (congrArg (fun _a => MvPolynomial.vanishingIdeal ℂ _a = NLA.RA20.abcIdeal) (Eq.symm NLA.RA20.abcIdeal_zeroLocus)))
  (Eq.mpr
    (id
      (congrArg (fun _a => _a = NLA.RA20.abcIdeal)
        (MvPolynomial.vanishingIdeal_zeroLocus_eq_radical NLA.RA20.abcIdeal)))
    (Ideal.IsRadical.radical NLA.RA20.abcIdeal_isRadical))
theorem NLA.RA20.definingIdeal_eq_comap_abcIdeal : NLA.RA20.definingIdeal 3 3 =
  Ideal.comap NLA.RA20.hollowPullback.toRingHom NLA.RA20.abcIdeal :=
Ideal.ext fun p =>
  Eq.mpr (id (congrArg (fun _a => p ∈ NLA.RA20.definingIdeal 3 3 ↔ _a) (propext Ideal.mem_comap)))
    (Eq.mpr
      (id
        (congrArg (fun _a => p ∈ NLA.RA20.definingIdeal 3 3 ↔ NLA.RA20.hollowPullback.toRingHom p ∈ _a)
          (Eq.symm NLA.RA20.abcIdeal_vanishing)))
      (id
        {
          mp := fun hp x hx =>
            Eq.mpr (id (congrArg (fun _a => _a = 0) (NLA.RA20.aeval_hollowPullback x p)))
              (hp (NLA.RA20.coordinates (NLA.RA20.hollow (x 0) (x 1) (x 2)))
                ((NLA.RA20.hollow_mem_variety_iff (x 0) (x 1) (x 2)).mpr hx)),
          mpr := fun hp x hx =>
            have h := NLA.RA20.matrix_eq_hollow_of_mem hx;
            have hz := (NLA.RA20.hollow_variety_semantics_proved.right (NLA.RA20.matrixOfCoordinates x)).mp hx;
            have he :=
              have he' := congrArg NLA.RA20.coordinates h;
              Eq.symm he';
            have hv := hp ![x (0, 1), x (0, 2), x (1, 2)] hz.right;
            id (fun hv => Eq.mp (congrArg (fun _a => (MvPolynomial.aeval _a) p = 0) he) hv)
              (Eq.mp (congrArg (fun _a => _a = 0) (NLA.RA20.aeval_hollowPullback ![x (0, 1), x (0, 2), x (1, 2)] p))
                hv) }))
theorem NLA.RA20.reduced_coordinate_ring_proved : ∃ e,
  ∀ (i j : Fin 3),
    e ((Ideal.Quotient.mk (NLA.RA20.definingIdeal 3 3)) (MvPolynomial.X (i, j))) =
      (Ideal.Quotient.mk NLA.RA20.abcIdeal) (NLA.RA20.polynomialHollow i j) :=
Exists.intro NLA.RA20.reducedCoordinateEquiv NLA.RA20.reducedCoordinateEquiv_mk_X
