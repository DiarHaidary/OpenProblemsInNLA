      (hollow a b c ∈ variety 3 3 ↔ a * b * c = 0)) ∧
    (∀ X : Mat 3, X ∈ variety 3 3 ↔
      X = hollow (X 0 1) (X 0 2) (X 1 2) ∧ X 0 1 * X 0 2 * X 1 2 = 0) := by
