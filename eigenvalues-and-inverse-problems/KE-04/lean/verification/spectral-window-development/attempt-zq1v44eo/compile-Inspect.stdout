        (@StarAddMonoid.toInvolutiveStar.{0} Real
          (@AddCommMonoid.toAddMonoid.{0} Real
            (@NonUnitalNonAssocSemiring.toAddCommMonoid.{0} Real
              (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring.{0} Real
                (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing.{0} Real
                  (@NonUnitalCommRing.toNonUnitalNonAssocCommRing.{0} Real
                    (@CommRing.toNonUnitalCommRing.{0} Real Real.commRing))))))
          (@StarRing.toStarAddMonoid.{0} Real
            (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring.{0} Real
              (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing.{0} Real
                (@NonUnitalCommRing.toNonUnitalNonAssocCommRing.{0} Real
                  (@CommRing.toNonUnitalCommRing.{0} Real Real.commRing))))
            instStarRingReal)))
      Q)
theorem NLA.KE04._proved.compression_basis_independent : ∀ {n m : ℕ} (A : NLA.KE04.Mat n) (hA : Matrix.IsHermitian A)
  (Q R : NLA.KE04.Rect n m),
  Matrix.transpose Q * Q = 1 →
    Matrix.transpose R * R = 1 →
      NLA.KE04.columnSpace Q = NLA.KE04.columnSpace R →
        (∃ O,
            Matrix.transpose O * O = 1 ∧
              R = Q * O ∧ NLA.KE04.compression A R = Matrix.transpose O * NLA.KE04.compression A Q * O) ∧
          Matrix.charpoly (NLA.KE04.compression A Q) = Matrix.charpoly (NLA.KE04.compression A R) ∧
            NLA.KE04.ritzValues A hA Q = NLA.KE04.ritzValues A hA R :=
fun {n m} A hA Q R hQ hR hspan =>
  let O := Matrix.transpose Q * R;
  have hrep :=
    LinearEquiv.injective Matrix.toEuclideanLin
      (LinearMap.ext fun x =>
        id
          (Eq.mpr
            (id (congrArg (fun _a => (NLA.KE04.act R) x = _a) (NLA.KE04._proved.act_mul Q (Matrix.transpose Q * R) x)))
            (Eq.mpr
              (id
                (congrArg (fun _a => (NLA.KE04.act R) x = (NLA.KE04.act Q) _a)
                  (NLA.KE04._proved.act_mul (Matrix.transpose Q) R x)))
              (Eq.mpr
                (id
                  (congrArg (fun _a => (NLA.KE04.act R) x = _a)
                    (Eq.symm (NLA.KE04._proved.frameProjection_act Q ((NLA.KE04.act R) x)))))
                (Eq.symm
                  ((NLA.KE04._proved.frameProjection_fixed_iff Q hQ ((NLA.KE04.act R) x)).mp
                    (Eq.mpr (id (congrArg (fun _a => (NLA.KE04.act R) x ∈ _a) hspan))
                      (Eq.mpr
                        (id
                          (congrArg (fun _a => (NLA.KE04.act R) x ∈ _a) (NLA.KE04._proved.columnSpace_eq_range_act R)))
                        (Exists.intro x rfl)))))))));
  have hO :=
    id
      (Eq.mpr (id (congrArg (fun _a => _a * O = 1) (Matrix.transpose_mul (Matrix.transpose Q) R)))
        (Eq.mpr (id (congrArg (fun _a => Matrix.transpose R * _a * O = 1) (Matrix.transpose_transpose Q)))
          (Eq.mpr (id (congrArg (fun _a => _a = 1) (Matrix.mul_assoc (Matrix.transpose R) Q O)))
            (Eq.mpr (id (congrArg (fun _a => Matrix.transpose R * _a = 1) (Eq.symm hrep)))
              (Eq.mpr (id (congrArg (fun _a => _a = 1) hR)) (Eq.refl 1))))));
  have hO' := mul_eq_one_comm.mp hO;
  have hsim :=
    Eq.mpr
      (id
        ((fun a a_1 e_a =>
            Eq.rec (motive := fun a_2 e_a => ∀ (a_3 : NLA.KE04.Mat m), (a = a_3) = (a_2 = a_3))
              (fun a_2 => Eq.refl (a = a_2)) e_a)
          (NLA.KE04.compression A R) (NLA.KE04.compression A (Q * O))
          (Eq.trans (congrArg (fun _a => NLA.KE04.compression A _a) hrep) (Eq.refl (NLA.KE04.compression A (Q * O))))
          (Matrix.transpose O * NLA.KE04.compression A Q * O)))
      (of_eq_true
        (Eq.trans
          (congr
            (congrArg Eq
              (Eq.trans
                (Eq.trans
                  (congrFun'
                    (congrArg HMul.hMul
                      (Eq.trans
                        (congrFun'
                          (congrArg HMul.hMul
                            (Eq.trans (Matrix.conjTranspose_eq_transpose_of_trivial (Q * O))
                              (Matrix.transpose_mul Q O)))
                          A)
                        (Matrix.mul_assoc (Matrix.transpose O) (Matrix.transpose Q) A)))
                    (Q * O))
                  (Matrix.mul_assoc (Matrix.transpose O) (Matrix.transpose Q * A) (Q * O)))
                (congrArg (HMul.hMul (Matrix.transpose O)) (Matrix.mul_assoc (Matrix.transpose Q) A (Q * O)))))
            (Eq.trans
              (Eq.trans
                (congrFun'
                  (congrArg HMul.hMul
                    (congrArg (HMul.hMul (Matrix.transpose O))
                      (Eq.trans
                        (congrFun'
                          (congrArg HMul.hMul
                            (congrFun' (congrArg HMul.hMul (Matrix.conjTranspose_eq_transpose_of_trivial Q)) A))
                          Q)
                        (Matrix.mul_assoc (Matrix.transpose Q) A Q))))
                  O)
                (Matrix.mul_assoc (Matrix.transpose O) (Matrix.transpose Q * (A * Q)) O))
              (congrArg (HMul.hMul (Matrix.transpose O))
                (Eq.trans (Matrix.mul_assoc (Matrix.transpose Q) (A * Q) O)
                  (congrArg (HMul.hMul (Matrix.transpose Q)) (Matrix.mul_assoc A Q O))))))
          (eq_self (Matrix.transpose O * (Matrix.transpose Q * (A * (Q * O)))))));
  have hchar :=
    Eq.mpr (id (congrArg (fun _a => Matrix.charpoly (NLA.KE04.compression A Q) = Matrix.charpoly _a) hsim))
      (Eq.mpr
        (id
          (congrArg (fun _a => Matrix.charpoly (NLA.KE04.compression A Q) = _a)
            (Matrix.charpoly_mul_comm (Matrix.transpose O * NLA.KE04.compression A Q) O)))
        (Eq.mpr
          (id
            (congrArg (fun _a => Matrix.charpoly (NLA.KE04.compression A Q) = _a.charpoly)
              (Eq.symm (Matrix.mul_assoc O (Matrix.transpose O) (NLA.KE04.compression A Q)))))
          (Eq.mpr
            (id
              (congrArg
                (fun _a => Matrix.charpoly (NLA.KE04.compression A Q) = (_a * NLA.KE04.compression A Q).charpoly) hO'))
            (Eq.mpr
              (id
                (congrArg (fun _a => Matrix.charpoly (NLA.KE04.compression A Q) = _a.charpoly)
                  (Matrix.one_mul (NLA.KE04.compression A Q))))
              (Eq.refl (Matrix.charpoly (NLA.KE04.compression A Q)))))));
  ⟨Exists.intro O ⟨hO, ⟨hrep, hsim⟩⟩,
    ⟨hchar,
      let hTQ := Matrix.isSymmetric_toEuclideanLin_iff.mpr (Matrix.isHermitian_conjTranspose_mul_mul Q hA);
      let hTR := Matrix.isSymmetric_toEuclideanLin_iff.mpr (Matrix.isHermitian_conjTranspose_mul_mul R hA);
      have hvalues :=
        (LinearMap.IsSymmetric.eigenvalues_eq_eigenvalues_iff hTQ finrank_euclideanSpace_fin hTR
              finrank_euclideanSpace_fin).mpr
          (Eq.mpr
            (id
              (congr
                (congrArg Eq
                  (Matrix.charpoly_toLin (Matrix.conjTranspose Q * A * Q) (EuclideanSpace.basisFun (Fin m) ℝ).toBasis))
                (Matrix.charpoly_toLin (Matrix.conjTranspose R * A * R) (EuclideanSpace.basisFun (Fin m) ℝ).toBasis)))
            hchar);
      funext fun r => congrFun hvalues r.rev⟩⟩
theorem NLA.KE04._proved.orthonormal_span_form_nonpos : ∀ {n q : ℕ} (M : NLA.KE04.Mat n) (v : Fin q → NLA.KE04.Vec n)
  (d : Fin q → ℝ),
  Orthonormal ℝ v →
    (∀ (j : Fin q), (NLA.KE04.act M) (v j) = d j • v j) →
      (∀ (j : Fin q), d j ≤ 0) → ∀ x ∈ Submodule.span ℝ (Set.range v), NLA.KE04.form M x ≤ 0 :=
fun {n q} M v d hv heig hd x hx =>
  Exists.casesOn ((Submodule.mem_span_range_iff_exists_fun ℝ).mp hx) fun c h =>
    Eq.ndrec (motive := fun x => x ∈ Submodule.span ℝ (Set.range v) → NLA.KE04.form M x ≤ 0)
      (fun hx =>
        have hform :=
          Eq.mpr
            (id
              (congrFun'
                (congrArg Eq
                  (congrArg (inner ℝ (∑ j, c j • v j))
                    (Eq.trans (map_sum (NLA.KE04.act M) (fun x => c x • v x) Finset.univ)
                      (Finset.sum_congr (Eq.refl Finset.univ) fun x a =>
                        Eq.trans (map_smul (NLA.KE04.act M) (c x) (v x))
                          (Eq.trans (congrArg (HSMul.hSMul (c x)) ((fun j => heig j) x))
                            (smul_smul (c x) (d x) (v x)))))))
                (∑ j, c j * c j * d j)))
            (Eq.mpr
              (id
                (congrArg (Eq (inner ℝ (∑ j, c j • v j) (∑ x, (c x * d x) • v x)))
                  (Finset.sum_congr (Eq.refl Finset.univ) fun x a => mul_assoc (c x) (c x) (d x))))
              (Eq.mp
                (congrArg (Eq (inner ℝ (∑ i, c i • v i) (∑ i, (c i * d i) • v i)))
                  (Finset.sum_congr (Eq.refl Finset.univ) fun x a =>
                    congrFun' (congrArg HMul.hMul (conj_trivial (c x))) (c x * d x)))
                (Orthonormal.inner_sum hv c (fun j => c j * d j) Finset.univ)));
        Eq.mpr (id (congrArg (fun _a => _a ≤ 0) hform))
          (Finset.sum_nonpos fun j x => mul_nonpos_of_nonneg_of_nonpos (mul_self_nonneg (c j)) (hd j)))
      h hx
theorem NLA.KE04._proved.spectral_window_subspace : ∀ {n m : ℕ} (A : NLA.KE04.Mat n) (hA : Matrix.IsHermitian A)
  (Q : NLA.KE04.Rect n m),
  Matrix.transpose Q * Q = 1 →
    ∀ (i p : ℕ),
      i + p < m →
        ∃ E ≤ NLA.KE04.columnSpace Q,
          Module.finrank ℝ ↥E = p + 1 ∧
            ∀ x ∈ E,
              NLA.KE04.form
                  (NLA.KE04.compressedQuadratic A Q (NLA.KE04.ritzValueAt A hA Q i)
                    (NLA.KE04.ritzValueAt A hA Q (i + p)))
                  x ≤
                0 :=
fun {n m} A hA Q hQ i p hi =>
  let M := NLA.KE04.compression A Q;
  let hM := Matrix.isHermitian_conjTranspose_mul_mul Q hA;
  let B := NLA.KE04.orderedEigenbasis M hM;
  let t := fun j =>
    ⟨i + ↑j, Decidable.byContradiction fun a => NLA.KE04._proved.spectral_window_subspace._proof_1_1 i p hi j a⟩;
  have ht := fun ⦃j k⦄ h =>
    Fin.ext
      (have this := congrArg Fin.val h;
      Decidable.byContradiction fun a => NLA.KE04._proved.spectral_window_subspace._proof_1_2 i p hi this a);
  let w := fun j => (NLA.KE04.act Q) (B (t j));
  have hw :=
    Eq.mpr (id (congrArg (fun _a => _a) (propext orthonormal_iff_ite))) fun j k =>
      id
        (Eq.mpr
          (id
            (congrArg (fun _a => _a = if j = k then 1 else 0)
              (NLA.KE04._proved.inner_act_left Q (B (t j)) ((NLA.KE04.act Q) (B (t k))))))
          (Eq.mpr
            (id
              (congrArg (fun _a => inner ℝ (B (t j)) _a = if j = k then 1 else 0)
                (NLA.KE04._proved.act_transpose_act Q hQ (B (t k)))))
            (orthonormal_iff_ite.mp (Orthonormal.comp (OrthonormalBasis.orthonormal B) t ht) j k)));
  let a := NLA.KE04.ritzValueAt A hA Q i;
  let b := NLA.KE04.ritzValueAt A hA Q (i + p);
  let d := fun j => (NLA.KE04.orderedEigenvalues M hM (t j) - a) * (NLA.KE04.orderedEigenvalues M hM (t j) - b);
  have hi0 := Decidable.byContradiction fun a => NLA.KE04._proved.spectral_window_subspace._proof_1_3 i p hi a;
  have ha :=
    of_eq_true
      (Eq.trans
        (congrFun' (congrArg Eq (Eq.trans (NLA.KE04.ritzValueAt.eq_1 A hA Q i) (dite_cond_eq_true (eq_true hi0))))
          (NLA.KE04.orderedEigenvalues (NLA.KE04.compression A Q) hM ⟨i, hi0⟩))
        (eq_self
          (NLA.KE04.orderedEigenvalues (NLA.KE04.compression A Q) (NLA.KE04.ritzValues._proof_1 A hA Q)
            ⟨i, of_eq_true (eq_true hi0)⟩)));
  have hb :=
    of_eq_true
      (Eq.trans
        (congrFun' (congrArg Eq (Eq.trans (NLA.KE04.ritzValueAt.eq_1 A hA Q (i + p)) (dite_cond_eq_true (eq_true hi))))
          (NLA.KE04.orderedEigenvalues (NLA.KE04.compression A Q) hM ⟨i + p, hi⟩))
        (eq_self
          (NLA.KE04.orderedEigenvalues (NLA.KE04.compression A Q) (NLA.KE04.ritzValues._proof_1 A hA Q)
            ⟨i + p, of_eq_true (eq_true hi)⟩)));
  have hd := fun j =>
    mul_nonpos_of_nonneg_of_nonpos
      (sub_nonneg.mpr
        (Eq.mpr (id (congrArg (fun _a => _a ≤ NLA.KE04.orderedEigenvalues M hM (t j)) ha))
          ((NLA.KE04._proved.orderedSpectrum_semantics M hM).left
            (id (Decidable.byContradiction fun a => NLA.KE04._proved.spectral_window_subspace._proof_1_5 i p j a)))))
      (sub_nonpos.mpr
        (Eq.mpr (id (congrArg (fun _a => NLA.KE04.orderedEigenvalues M hM (t j) ≤ _a) hb))
          ((NLA.KE04._proved.orderedSpectrum_semantics M hM).left
            (id (Decidable.byContradiction fun a => NLA.KE04._proved.spectral_window_subspace._proof_1_6 i p j a)))));
  have heig := fun j =>
    id
      (Eq.mpr
        (id
          (congrArg (fun _a => _a = d j • w j)
            (NLA.KE04._proved.act_mul (Q * NLA.KE04.quadraticMatrix M a b) (Matrix.conjTranspose Q)
              ((NLA.KE04.act Q) (B (t j))))))
        (Eq.mpr
          (id
            (congrArg (fun _a => _a = d j • w j)
              (NLA.KE04._proved.act_mul Q (NLA.KE04.quadraticMatrix M a b)
                ((NLA.KE04.act (Matrix.conjTranspose Q)) ((NLA.KE04.act Q) (B (t j)))))))
          (Eq.mpr
            (id
              (congrArg
                (fun _a =>
                  (NLA.KE04.act Q)
                      ((NLA.KE04.act (NLA.KE04.quadraticMatrix M a b))
                        ((NLA.KE04.act _a) ((NLA.KE04.act Q) (B (t j))))) =
                    d j • w j)
                (Matrix.conjTranspose_eq_transpose_of_trivial Q)))
            (Eq.mpr
              (id
                (congrArg (fun _a => (NLA.KE04.act Q) ((NLA.KE04.act (NLA.KE04.quadraticMatrix M a b)) _a) = d j • w j)
                  (NLA.KE04._proved.act_transpose_act Q hQ (B (t j)))))
              (Eq.mpr
                (id
                  (congrArg (fun _a => (NLA.KE04.act Q) _a = d j • w j)
                    (NLA.KE04._proved.quadratic_apply_eigenvector M a b (NLA.KE04.orderedEigenvalues M hM (t j))
                      ((NLA.KE04.orderedEigenbasis M hM) (t j))
                      ((NLA.KE04._proved.orderedSpectrum_semantics M hM).right.left (t j)))))
                (Eq.mpr
                  (id
                    (congrArg (fun _a => _a = d j • w j)
                      (map_smul (NLA.KE04.act Q)
                        ((NLA.KE04.orderedEigenvalues M hM (t j) - a) * (NLA.KE04.orderedEigenvalues M hM (t j) - b))
                        ((NLA.KE04.orderedEigenbasis M hM) (t j)))))
                  (Eq.refl
                    (((NLA.KE04.orderedEigenvalues M hM (t j) - a) * (NLA.KE04.orderedEigenvalues M hM (t j) - b)) •
                      (NLA.KE04.act Q) ((NLA.KE04.orderedEigenbasis M hM) (t j))))))))));
  Exists.intro (Submodule.span ℝ (Set.range w))
    ⟨Submodule.span_le.mpr fun ⦃a⦄ a_1 =>
        Exists.casesOn a_1 fun j h =>
          h ▸
            Eq.mpr (id (congrArg (fun _a => w j ∈ ↑_a) (NLA.KE04._proved.columnSpace_eq_range_act Q)))
              (Exists.intro (B (t j)) rfl),
      ⟨Eq.mp (congrArg (Eq (Module.finrank ℝ ↥(Submodule.span ℝ (Set.range w)))) (Fintype.card_fin (p + 1)))
          (finrank_span_eq_card (Orthonormal.linearIndependent hw)),
        NLA.KE04._proved.orthonormal_span_form_nonpos (NLA.KE04.compressedQuadratic A Q a b) w d hw heig hd⟩⟩
