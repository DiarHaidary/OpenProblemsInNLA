'NLA.KE04._proved.krylov_range_semantics' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04._proved.krylov_nesting_and_shift' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04._proved.fullBlockDimension_iff_independent' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04._proved.fullBlockDimension_prefix' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04._proved.lastFullBlockIteration_exists' depends on axioms: [propext, Classical.choice, Quot.sound]
EXACT_CONTRACT NLA.KE04._proved.krylov_range_semantics: ∀ {n p : ℕ} (A : Mat n) (V : Rect n p) (ell : ℕ),
  krylov A V ell = (krylovCombination A V ell).range ∧
    (∀ (x : Vec n), x ∈ krylov A V ell ↔ ∃ c, x = ∑ rc, c rc • column (A ^ ↑rc.1 * V) rc.2) ∧
      Module.finrank ℝ ↥(krylov A V ell) ≤ ell * p
EXACT_CONTRACT NLA.KE04._proved.krylov_nesting_and_shift: ∀ {n p : ℕ} (A : Mat n) (V : Rect n p),
  krylov A V 0 = ⊥ ∧ Monotone (krylov A V) ∧ ∀ (ell : ℕ), ∀ x ∈ krylov A V ell, (act A) x ∈ krylov A V (ell + 1)
EXACT_CONTRACT NLA.KE04._proved.fullBlockDimension_iff_independent: ∀ {n p : ℕ} (A : Mat n) (V : Rect n p) (ell : ℕ),
  (FullBlockDimension A V ell ↔ LinearIndependent ℝ (krylovColumns A V ell)) ∧
    (FullColumnRank V ↔ FullBlockDimension A V 1)
EXACT_CONTRACT NLA.KE04._proved.fullBlockDimension_prefix: ∀ {n p : ℕ} (A : Mat n) (V : Rect n p) (s : ℕ),
  FullBlockDimension A V s → ∀ ell ≤ s, FullBlockDimension A V ell ∧ Function.Injective ⇑(krylovCombination A V ell)
EXACT_CONTRACT NLA.KE04._proved.lastFullBlockIteration_exists: ∀ {n p : ℕ},
  0 < p → ∀ (A : Mat n) (V : Rect n p), FullColumnRank V → ∃ s, 1 ≤ s ∧ LastFullBlockIteration A V s
