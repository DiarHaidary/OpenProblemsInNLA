  rw [reducedCoordinateEquiv, AlgEquiv.trans_apply, Ideal.quotientEquivAlgOfEq_mk,
    Ideal.quotientKerAlgEquivOfSurjective_mk]
  simp [hollowQuotientMap, hollowPullback]

theorem reduced_coordinate_ring_proved :
    ∃ e : CoordinateRing 3 3 ≃ₐ[ℂ] ABCCoordinateRing,
      ∀ i j : Fin 3,
        e (Ideal.Quotient.mk (definingIdeal 3 3) (MvPolynomial.X (i, j))) =
