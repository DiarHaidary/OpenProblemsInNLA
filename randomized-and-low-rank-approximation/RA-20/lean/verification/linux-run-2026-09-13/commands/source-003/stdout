  constructor
  · intro h
    have he := matrix_eq_hollow_of_mem h
    exact ⟨he, (hollow_mem_variety_iff _ _ _).mp (he ▸ h)⟩
  · rintro ⟨he, hz⟩
    rw [he]
    exact (hollow_mem_variety_iff _ _ _).mpr hz

