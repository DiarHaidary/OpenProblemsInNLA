                   expected=1, markers=("Building Challenge", "Building Solution", marker))


def validated_tools(tool_dir: Path) -> tuple[dict, dict[str, str]]:
    linux_requirements()
    lock = load_lock()
    verify_sources(tool_dir, lock)
    receipt = read_json(tool_dir / "bootstrap.json")
