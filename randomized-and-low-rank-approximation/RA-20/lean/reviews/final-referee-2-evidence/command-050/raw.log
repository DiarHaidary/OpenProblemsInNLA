EXACT_REFERENCE_TYPE NLA.RA20.hollow_variety_semantics: (∀ (a b c : ℂ),
    (NLA.RA20.hollow a b c).det = 2 * a * b * c ∧ (NLA.RA20.hollow a b c ∈ NLA.RA20.variety 3 3 ↔ a * b * c = 0)) ∧
  ∀ (X : NLA.RA20.Mat 3),
    X ∈ NLA.RA20.variety 3 3 ↔ X = NLA.RA20.hollow (X 0 1) (X 0 2) (X 1 2) ∧ X 0 1 * X 0 2 * X 1 2 = 0
EXACT_REFERENCE_TYPE NLA.RA20.reduced_coordinate_ring: ∃ e,
  ∀ (i j : Fin 3),
    e ((Ideal.Quotient.mk (NLA.RA20.definingIdeal 3 3)) (MvPolynomial.X (i, j))) =
      (Ideal.Quotient.mk NLA.RA20.abcIdeal) (NLA.RA20.polynomialHollow i j)
EXACT_REFERENCE_TYPE NLA.RA20.algebraic_smooth_locus: ∀ (X : NLA.RA20.Mat 3),
  NLA.RA20.SmoothPoint 3 3 X ↔
    X = NLA.RA20.hollow (X 0 1) (X 0 2) (X 1 2) ∧ NLA.RA20.ExactlyOneZero (X 0 1) (X 0 2) (X 1 2)
EXACT_REFERENCE_TYPE NLA.RA20.algebraic_tangent_space: ∀ (a b c : ℂ),
  a * b * c = 0 →
    ∀ (Z : NLA.RA20.Mat 3),
      NLA.RA20.TangentVector 3 3 (NLA.RA20.hollow a b c) Z ↔
        Matrix.IsSymm Z ∧ (∀ (i : Fin 3), Z i i = 0) ∧ b * c * Z 0 1 + a * c * Z 0 2 + a * b * Z 1 2 = 0
EXACT_REFERENCE_TYPE NLA.RA20.full_frobenius_differential: ∀ (n : ℕ) (U X Z : NLA.RA20.Mat n),
  (fderiv ℂ (NLA.RA20.fullFrobeniusDistance U) X) Z = 2 * ∑ i, ∑ j, (X i j - U i j) * Z i j
EXACT_REFERENCE_TYPE NLA.RA20.hollow_distance_semantics: ∀ (U : NLA.RA20.Mat 3),
  Matrix.IsSymm U →
    ∀ (a b c : ℂ),
      NLA.RA20.fullFrobeniusDistance U (NLA.RA20.hollow a b c) =
        ∑ i, U i i ^ 2 + 2 * ((a - U 0 1) ^ 2 + (b - U 0 2) ^ 2 + (c - U 1 2) ^ 2)
EXACT_REFERENCE_TYPE NLA.RA20.generic_critical_locus: ∀ (U : NLA.RA20.Mat 3),
  NLA.RA20.GenericData U →
    NLA.RA20.criticalSet 3 3 U = Set.range (NLA.RA20.candidate U) ∧ Function.Injective (NLA.RA20.candidate U)
EXACT_REFERENCE_TYPE NLA.RA20.component_hessians: ∀ (U : NLA.RA20.Mat 3) (i : Fin 3) (z h v : Fin 2 → ℂ),
  ((fderiv ℂ (fun w => fderiv ℂ (fun y => NLA.RA20.fullFrobeniusDistance U (NLA.RA20.planeCoordinates i y)) w) z) h) v =
      4 * ∑ j, h j * v j ∧
    ((∀ (v : Fin 2 → ℂ), 4 * ∑ j, h j * v j = 0) → h = 0)
EXACT_REFERENCE_TYPE NLA.RA20.generic_data_intersection: ∀ (q : NLA.RA20.Poly 3),
  (∃ U, Matrix.IsSymm U ∧ (MvPolynomial.eval (NLA.RA20.coordinates U)) q ≠ 0) →
    ∃ U, NLA.RA20.GenericData U ∧ (MvPolynomial.eval (NLA.RA20.coordinates U)) q ≠ 0
EXACT_REFERENCE_TYPE NLA.RA20.generic_count_three: NLA.RA20.HasGenericCriticalCount 3 3 3
EXACT_REFERENCE_TYPE NLA.RA20.generic_count_not_four: ¬NLA.RA20.HasGenericCriticalCount 3 3 4
EXACT_REFERENCE_TYPE NLA.RA20.not_criticalCountConjecture: ¬NLA.RA20.criticalCountConjecture
