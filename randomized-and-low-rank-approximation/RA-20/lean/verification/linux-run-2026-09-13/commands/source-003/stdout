  · simpa only [symmetricParameter, symmetricParameterIndex, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_fin_one, Matrix.cons_val_two] using hcoords
  · change MvPolynomial.eval z f ≠ 0 at hfz
    rw [show f = MvPolynomial.rename symmetricParameterIndex q from rfl,
      eval_rename_symmetricParameter] at hfz
    exact hfz

