284-    (hμ : HasEigenvalue T μ) : ∃ i : Fin n, hT.eigenvalues hn i = μ := by
--
298-finite-dimensional inner product space `E`.  Eigenvectors are sorted in decreasing
299-order of their eigenvalues. -/
300:noncomputable irreducible_def eigenvectorBasis (hT : T.IsSymmetric) (hn : Module.finrank 𝕜 E = n) :
301-    OrthonormalBasis (Fin n) 𝕜 E :=
302-  (hT.direct_sum_isInternal.subordinateOrthonormalBasis
303-    hn hT.orthogonalFamily_eigenspaces').reindex
304-      (Tuple.sort (hT.unsortedEigenvalues hn) * @Fin.revPerm n).symm
