'NLA.KE04._proved.quadratic_forms_agree' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04._proved.later_quadratic_identity' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04._proved.interval_index_validity' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04._proved.fullPrefix_implies_canonical' depends on axioms: [propext, Classical.choice, Quot.sound]
EXACT_CONTRACT NLA.KE04._proved.quadratic_forms_agree: ∀ {n p : ℕ} (A : Mat n),
  Matrix.IsHermitian A →
    ∀ (V : Rect n p) (k j : ℕ),
      1 ≤ k →
        k < j →
          ∀ (Qk : Rect n (k * p)) (Qj : Rect n (j * p)),
            IsKrylovBasis A V k Qk →
              IsKrylovBasis A V j Qj →
                ∀ x ∈ krylov A V (k - 1),
                  ∀ (a b : ℝ), form (compressedQuadratic A Qk a b) x = form (compressedQuadratic A Qj a b) x
EXACT_CONTRACT NLA.KE04._proved.later_quadratic_identity: ∀ {n p : ℕ} (A : Mat n) (V : Rect n p) (k j : ℕ),
  1 ≤ k →
    k < j →
      ∀ (Qj : Rect n (j * p)),
        IsKrylovBasis A V j Qj →
          ∀ x ∈ krylov A V (k - 1),
            ∀ (a b : ℝ), (act (compressedQuadratic A Qj a b)) x = (act (quadraticMatrix A a b)) x
EXACT_CONTRACT NLA.KE04._proved.interval_index_validity: ∀ (k p i : ℕ),
  1 ≤ k → 1 ≤ i → i ≤ (k - 1) * p → 2 ≤ k ∧ 0 < p ∧ i - 1 < k * p ∧ i + p - 1 < k * p
EXACT_CONTRACT NLA.KE04._proved.fullPrefix_implies_canonical: FullPrefixBlockLanczosClaim → BlockLanczosConjecture
