  obtain ⟨g, hg⟩ := (Algebra.FormallySmooth.iff_split_surjection π hπ).mp hs
  obtain ⟨a', ha'⟩ := Ideal.Quotient.mk_surjective (g (π a))
  obtain ⟨b', hb'⟩ := Ideal.Quotient.mk_surjective (g (π b))
