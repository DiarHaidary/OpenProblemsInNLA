'NLA.IE05.firstGrowth' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.orthogonalGrowthSet : ℕ → Set ℝ :=
fun n => {r | ∃ A, NLA.IE05.Orthogonal A ∧ ∃ path, NLA.IE05.AdmissiblePath A path ∧ r = NLA.IE05.growth A path}
'NLA.IE05.orthogonalGrowthSet' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.orthogonalGrowthSup : ℕ → ℝ :=
fun n => sSup (NLA.IE05.orthogonalGrowthSet n)
'NLA.IE05.orthogonalGrowthSup' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.OrthogonalExtremizerConjecture : Prop :=
∀ (n : ℕ), 2 ≤ n → NLA.IE05.orthogonalGrowthSup n = NLA.IE05.firstGrowth (NLA.IE05.candidateQ n)
'NLA.IE05.OrthogonalExtremizerConjecture' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.scaledColumns : {n : ℕ} → NLA.IE05.Mat n → (Fin n → ℝ) → NLA.IE05.Mat n :=
