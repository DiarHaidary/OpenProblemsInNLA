def NLA.KE04.IterationOccupancy : {n p : Nat} →
  (A : NLA.KE04.Mat n) →
    (hA :
        @Matrix.IsHermitian.{0, 0} Real (Fin n)
          (@InvolutiveStar.toStar.{0} Real
            (@StarAddMonoid.toInvolutiveStar.{0} Real
              (@AddCommMonoid.toAddMonoid.{0} Real
                (@NonUnitalNonAssocSemiring.toAddCommMonoid.{0} Real
                  (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring.{0} Real
                    (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing.{0} Real
                      (@NonUnitalCommRing.toNonUnitalNonAssocCommRing.{0} Real
                        (@CommRing.toNonUnitalCommRing.{0} Real Real.commRing))))))
              (@StarRing.toStarAddMonoid.{0} Real
                (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring.{0} Real
                  (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing.{0} Real
                    (@NonUnitalCommRing.toNonUnitalNonAssocCommRing.{0} Real
                      (@CommRing.toNonUnitalCommRing.{0} Real Real.commRing))))
                instStarRingReal)))
          A) →
      (V : NLA.KE04.Rect n p) → (s : Nat) → Prop :=
fun {n p : Nat} (A : NLA.KE04.Mat n)
    (hA :
      @Matrix.IsHermitian.{0, 0} Real (Fin n)
        (@InvolutiveStar.toStar.{0} Real
          (@StarAddMonoid.toInvolutiveStar.{0} Real
            (@AddCommMonoid.toAddMonoid.{0} Real
              (@NonUnitalNonAssocSemiring.toAddCommMonoid.{0} Real
                (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring.{0} Real
                  (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing.{0} Real
                    (@NonUnitalCommRing.toNonUnitalNonAssocCommRing.{0} Real
                      (@CommRing.toNonUnitalCommRing.{0} Real Real.commRing))))))
            (@StarRing.toStarAddMonoid.{0} Real
              (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring.{0} Real
                (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing.{0} Real
                  (@NonUnitalCommRing.toNonUnitalNonAssocCommRing.{0} Real
                    (@CommRing.toNonUnitalCommRing.{0} Real Real.commRing))))
              instStarRingReal)))
        A)
    (V : NLA.KE04.Rect n p) (s : Nat) =>
  ∀ (k j : Nat),
    @LE.le.{0} Nat instLENat (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1))) k →
      @LT.lt.{0} Nat instLTNat k j →
        @LE.le.{0} Nat instLENat j s →
          ∀ (Qk : NLA.KE04.Rect n (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) k p))
            (Qj : NLA.KE04.Rect n (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) j p)),
            @NLA.KE04.IsKrylovBasis n p A V k Qk →
              @NLA.KE04.IsKrylovBasis n p A V j Qj →
                ∀ (i : Nat),
                  @LE.le.{0} Nat instLENat (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1))) i →
                    @LE.le.{0} Nat instLENat i
                        (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat)
                          (@HSub.hSub.{0, 0, 0} Nat Nat Nat (@instHSub.{0} Nat instSubNat) k
                            (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))
                          p) →
                      @Exists.{1} (Fin (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) j p))
                        fun (r : Fin (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) j p)) =>
                        And
                          (@LT.lt.{0} Real Real.instLT
                            (@NLA.KE04.ritzValueAt n
                              (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) k p) A hA Qk
                              (@HSub.hSub.{0, 0, 0} Nat Nat Nat (@instHSub.{0} Nat instSubNat) i
                                (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))))
                            (@NLA.KE04.ritzValues n
                              (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) j p) A hA Qj r))
                          (@LT.lt.{0} Real Real.instLT
                            (@NLA.KE04.ritzValues n
                              (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) j p) A hA Qj r)
                            (@NLA.KE04.ritzValueAt n
                              (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) k p) A hA Qk
                              (@HSub.hSub.{0, 0, 0} Nat Nat Nat (@instHSub.{0} Nat instSubNat)
                                (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) i p)
                                (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))))
def NLA.KE04.FullPrefixBlockLanczosClaim : Prop :=
∀ (n p : Nat) (A : NLA.KE04.Mat n)
  (hA :
    @Matrix.IsHermitian.{0, 0} Real (Fin n)
      (@InvolutiveStar.toStar.{0} Real
        (@StarAddMonoid.toInvolutiveStar.{0} Real
          (@AddCommMonoid.toAddMonoid.{0} Real
            (@NonUnitalNonAssocSemiring.toAddCommMonoid.{0} Real
              (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring.{0} Real
                (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing.{0} Real
                  (@NonUnitalCommRing.toNonUnitalNonAssocCommRing.{0} Real
                    (@CommRing.toNonUnitalCommRing.{0} Real Real.commRing))))))
          (@StarRing.toStarAddMonoid.{0} Real
            (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring.{0} Real
              (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing.{0} Real
                (@NonUnitalCommRing.toNonUnitalNonAssocCommRing.{0} Real
                  (@CommRing.toNonUnitalCommRing.{0} Real Real.commRing))))
            instStarRingReal)))
      A)
  (V : NLA.KE04.Rect n p),
  @NLA.KE04.FullColumnRank n p V →
    ∀ (s : Nat), @NLA.KE04.FullBlockDimension n p A V s → @NLA.KE04.IterationOccupancy n p A hA V s
def NLA.KE04.BlockLanczosConjecture : Prop :=
∀ (n p : Nat) (A : NLA.KE04.Mat n)
  (hA :
    @Matrix.IsHermitian.{0, 0} Real (Fin n)
      (@InvolutiveStar.toStar.{0} Real
        (@StarAddMonoid.toInvolutiveStar.{0} Real
          (@AddCommMonoid.toAddMonoid.{0} Real
            (@NonUnitalNonAssocSemiring.toAddCommMonoid.{0} Real
              (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring.{0} Real
                (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing.{0} Real
                  (@NonUnitalCommRing.toNonUnitalNonAssocCommRing.{0} Real
                    (@CommRing.toNonUnitalCommRing.{0} Real Real.commRing))))))
          (@StarRing.toStarAddMonoid.{0} Real
            (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring.{0} Real
              (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing.{0} Real
                (@NonUnitalCommRing.toNonUnitalNonAssocCommRing.{0} Real
                  (@CommRing.toNonUnitalCommRing.{0} Real Real.commRing))))
            instStarRingReal)))
      A)
  (V : NLA.KE04.Rect n p),
  @NLA.KE04.FullColumnRank n p V →
    ∀ (s : Nat), @NLA.KE04.LastFullBlockIteration n p A V s → @NLA.KE04.IterationOccupancy n p A hA V s
