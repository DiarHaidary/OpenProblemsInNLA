@[reducible] def NLA.IE05.Mat : ℕ → Type :=
fun n => Matrix (Fin n) (Fin n) ℝ
'NLA.IE05.Mat' depends on axioms: [propext, Classical.choice, Quot.sound]
@[reducible] def NLA.IE05.IntMat : ℕ → Type :=
fun n => Matrix (Fin n) (Fin n) ℤ
'NLA.IE05.IntMat' does not depend on any axioms
@[reducible] def NLA.IE05.PivotPath : ℕ → Type :=
fun n => Fin n → Fin n
'NLA.IE05.PivotPath' does not depend on any axioms
def NLA.IE05.Orthogonal : {n : ℕ} → NLA.IE05.Mat n → Prop :=
fun {n} A => Matrix.transpose A * A = 1
'NLA.IE05.Orthogonal' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.UpperTriangular.{u_1} : {n : ℕ} → {R : Type u_1} → [Zero R] → Matrix (Fin n) (Fin n) R → Prop :=
fun {n} {R} [Zero R] A => ∀ (i j : Fin n), j < i → A i j = 0
'NLA.IE05.UpperTriangular' does not depend on any axioms
def NLA.IE05.UnitLower.{u_1} : {n : ℕ} → {R : Type u_1} → [Zero R] → [One R] → Matrix (Fin n) (Fin n) R → Prop :=
fun {n} {R} [Zero R] [One R] A => (∀ (i : Fin n), A i i = 1) ∧ ∀ (i j : Fin n), i < j → A i j = 0
'NLA.IE05.UnitLower' does not depend on any axioms
def NLA.IE05.prescribedLower : (n : ℕ) → NLA.IE05.Mat n :=
fun n i j => if i = j then 1 else if j < i then -1 else 0
'NLA.IE05.prescribedLower' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.euclideanColumns : {n : ℕ} → NLA.IE05.Mat n → Fin n → EuclideanSpace ℝ (Fin n) :=
fun {n} A j => WithLp.toLp 2 fun i => A i j
'NLA.IE05.euclideanColumns' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.normalizedQRQ : {n : ℕ} → NLA.IE05.Mat n → NLA.IE05.Mat n :=
fun {n} A i j => (InnerProductSpace.gramSchmidtNormed ℝ (NLA.IE05.euclideanColumns A) j).ofLp i
'NLA.IE05.normalizedQRQ' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.candidateQ : (n : ℕ) → NLA.IE05.Mat n :=
fun n => NLA.IE05.normalizedQRQ (NLA.IE05.prescribedLower n)
'NLA.IE05.candidateQ' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.candidateR : (n : ℕ) → NLA.IE05.Mat n :=
fun n => Matrix.transpose (NLA.IE05.candidateQ n) * NLA.IE05.prescribedLower n
'NLA.IE05.candidateR' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.PositiveQR : {n : ℕ} → NLA.IE05.Mat n → NLA.IE05.Mat n → NLA.IE05.Mat n → Prop :=
fun {n} A Q R => NLA.IE05.Orthogonal Q ∧ A = Q * R ∧ NLA.IE05.UpperTriangular R ∧ ∀ (i : Fin n), 0 < R i i
'NLA.IE05.PositiveQR' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.rowSwap : {n : ℕ} → NLA.IE05.Mat n → Fin n → Fin n → NLA.IE05.Mat n :=
fun {n} S k p i j => S ((Equiv.swap k p) i) j
'NLA.IE05.rowSwap' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.schurStep : {n : ℕ} → NLA.IE05.Mat n → Fin n → Fin n → NLA.IE05.Mat n :=
fun {n} S k p =>
  have B := NLA.IE05.rowSwap S k p;
  fun i j => if k < i ∧ k < j then B i j - B i k / B k k * B k j else 0
'NLA.IE05.schurStep' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.trajectory : {n : ℕ} → NLA.IE05.Mat n → NLA.IE05.PivotPath n → ℕ → NLA.IE05.Mat n :=
fun {n} A path x => Nat.brecOn x (NLA.IE05.trajectory._f A path)
'NLA.IE05.trajectory' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.AdmissiblePivot : {n : ℕ} → NLA.IE05.Mat n → Fin n → Fin n → Prop :=
fun {n} S k p => k ≤ p ∧ S p k ≠ 0 ∧ ∀ (i : Fin n), k ≤ i → |S i k| ≤ |S p k|
'NLA.IE05.AdmissiblePivot' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.FirstAvailablePivot : {n : ℕ} → NLA.IE05.Mat n → Fin n → Fin n → Prop :=
fun {n} S k p => NLA.IE05.AdmissiblePivot S k p ∧ ∀ (i : Fin n), k ≤ i → |S i k| = |S p k| → p ≤ i
'NLA.IE05.FirstAvailablePivot' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.AdmissiblePath : {n : ℕ} → NLA.IE05.Mat n → NLA.IE05.PivotPath n → Prop :=
fun {n} A path => ∀ (k : Fin n), NLA.IE05.AdmissiblePivot (NLA.IE05.trajectory A path ↑k) k (path k)
'NLA.IE05.AdmissiblePath' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.FirstAvailablePath : {n : ℕ} → NLA.IE05.Mat n → NLA.IE05.PivotPath n → Prop :=
fun {n} A path => ∀ (k : Fin n), NLA.IE05.FirstAvailablePivot (NLA.IE05.trajectory A path ↑k) k (path k)
'NLA.IE05.FirstAvailablePath' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.firstPivotIndex : {n : ℕ} → NLA.IE05.Mat n → Fin n → Fin n :=
fun {n} S k => List.foldl (fun p i => if k ≤ i ∧ |S p k| < |S i k| then i else p) k (List.finRange n)
'NLA.IE05.firstPivotIndex' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.firstTrajectory : {n : ℕ} → NLA.IE05.Mat n → ℕ → NLA.IE05.Mat n :=
fun {n} A x => Nat.brecOn x (NLA.IE05.firstTrajectory._f A)
'NLA.IE05.firstTrajectory' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.firstPath : {n : ℕ} → NLA.IE05.Mat n → NLA.IE05.PivotPath n :=
fun {n} A k => NLA.IE05.firstPivotIndex (NLA.IE05.firstTrajectory A ↑k) k
'NLA.IE05.firstPath' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.noSwapPath : (n : ℕ) → NLA.IE05.PivotPath n :=
fun n k => k
'NLA.IE05.noSwapPath' does not depend on any axioms
def NLA.IE05.entryMaxNN : {n : ℕ} → NLA.IE05.Mat n → NNReal :=
fun {n} A => Finset.univ.sup fun ij => ‖A ij.1 ij.2‖₊
'NLA.IE05.entryMaxNN' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.entryMax : {n : ℕ} → NLA.IE05.Mat n → ℝ :=
fun {n} A => ↑(NLA.IE05.entryMaxNN A)
'NLA.IE05.entryMax' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.activeMaxNN : {n : ℕ} → NLA.IE05.Mat n → ℕ → NNReal :=
fun {n} S k => Finset.univ.sup fun ij => if k ≤ ↑ij.1 ∧ k ≤ ↑ij.2 then ‖S ij.1 ij.2‖₊ else 0
'NLA.IE05.activeMaxNN' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.activeMax : {n : ℕ} → NLA.IE05.Mat n → ℕ → ℝ :=
fun {n} S k => ↑(NLA.IE05.activeMaxNN S k)
'NLA.IE05.activeMax' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.growth : {n : ℕ} → NLA.IE05.Mat n → NLA.IE05.PivotPath n → ℝ :=
fun {n} A path =>
  ↑(Finset.univ.sup fun k => NLA.IE05.activeMaxNN (NLA.IE05.trajectory A path ↑k) ↑k) / NLA.IE05.entryMax A
'NLA.IE05.growth' depends on axioms: [propext, Classical.choice, Quot.sound]
def NLA.IE05.firstGrowth : {n : ℕ} → NLA.IE05.Mat n → ℝ :=
