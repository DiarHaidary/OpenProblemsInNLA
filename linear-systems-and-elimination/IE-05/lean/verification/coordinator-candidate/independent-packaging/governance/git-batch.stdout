{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/mathlib-initiative/formalization.yaml/main/schema/v0.4.schema.json",
  "title": "formalization.yaml (v0.4)",
  "description": "Repo-root metadata schema for formalization projects (v0.4). Validates a filled-in formalization.yaml.",
  "type": "object",
  "$comment": "Permissive: extra keys allowed everywhere. Required fields use minLength/minItems so a blank template is invalid.",
  "required": ["project", "sources", "automation", "review"],
  "properties": {
    "version": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "description": "the formalization itself (not the source)",
      "required": ["name", "authors", "license"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": {
          "type": "string",
          "description": "a concise account of the mathematical content and principal results of the formalization"
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "who did the formalization"
        },
        "responsible_maintainers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "people responsible for the formalization repository"
        },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "repository": {
      "type": "object",
      "description": "optional relationship to a separately pinned substantive formalization; omission means this repository is the substantive development",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["", "substantive-development", "thin-wrapper"]
        },
        "substantive_formalization": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "repository URL or another stable identifier"
            },
            "revision": {
              "type": "string",
              "description": "immutable commit or revision when available"
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "thin-wrapper" } }, "required": ["role"] },
          "then": { "required": ["substantive_formalization"] }
