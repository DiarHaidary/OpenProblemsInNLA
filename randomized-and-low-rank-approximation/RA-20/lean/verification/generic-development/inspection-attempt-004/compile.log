theorem NLA.RA20.generic_data_intersection_proved : ∀ (q : NLA.RA20.Poly 3),
  (∃ U, Matrix.IsSymm U ∧ (MvPolynomial.eval (NLA.RA20.coordinates U)) q ≠ 0) →
    ∃ U, NLA.RA20.GenericData U ∧ (MvPolynomial.eval (NLA.RA20.coordinates U)) q ≠ 0 :=
fun q hq =>
  Exists.casesOn hq fun U h =>
    And.casesOn h fun hU hqU =>
      let f := (MvPolynomial.rename NLA.RA20.symmetricParameterIndex) q;
      have hf := fun hfzero =>
        hqU
          (have h := NLA.RA20.eval_rename_symmetricParameter (NLA.RA20.symmetricDataCoordinates U) q;
          id
            (fun h =>
              Eq.symm
