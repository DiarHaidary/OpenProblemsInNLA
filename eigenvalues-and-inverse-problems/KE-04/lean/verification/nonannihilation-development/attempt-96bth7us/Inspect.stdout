'NLA.KE04._proved.fullRank_quadratic_nonannihilation' depends on axioms: [propext, Classical.choice, Quot.sound]
EXACT_CONTRACT NLA.KE04._proved.fullRank_quadratic_nonannihilation: ∀ {n p : ℕ} (A : Mat n) (V : Rect n p) (k : ℕ),
  2 ≤ k →
    FullBlockDimension A V (k + 1) → ∀ x ∈ krylov A V (k - 1), x ≠ 0 → ∀ (a b : ℝ), (act (quadraticMatrix A a b)) x ≠ 0
