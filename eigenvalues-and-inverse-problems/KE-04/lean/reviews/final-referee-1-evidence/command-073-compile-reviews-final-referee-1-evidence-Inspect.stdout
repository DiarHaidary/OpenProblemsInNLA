EXACT_ELABORATED_SIGNATURE NLA.KE04.real_matrix_semantics = NLA.KE04.FinalReferee1Reference.real_matrix_semantics
EXPORTED_TYPE NLA.KE04.real_matrix_semantics: ∀ {n m : ℕ} (A : NLA.KE04.Mat n) (M : NLA.KE04.Rect n m),
  (Matrix.IsHermitian A ↔ Matrix.transpose A = A) ∧
    (∀ (x : NLA.KE04.Vec m) (i : Fin n), ((NLA.KE04.act M) x).ofLp i = ∑ j, M i j * x.ofLp j) ∧
      (Matrix.transpose M * M = 1 ↔ Orthonormal ℝ (NLA.KE04.column M))
EXACT_ELABORATED_SIGNATURE NLA.KE04.krylov_range_semantics = NLA.KE04.FinalReferee1Reference.krylov_range_semantics
EXPORTED_TYPE NLA.KE04.krylov_range_semantics: ∀ {n p : ℕ} (A : NLA.KE04.Mat n) (V : NLA.KE04.Rect n p) (ell : ℕ),
  NLA.KE04.krylov A V ell = (NLA.KE04.krylovCombination A V ell).range ∧
    (∀ (x : NLA.KE04.Vec n), x ∈ NLA.KE04.krylov A V ell ↔ ∃ c, x = ∑ rc, c rc • NLA.KE04.column (A ^ ↑rc.1 * V) rc.2) ∧
      Module.finrank ℝ ↥(NLA.KE04.krylov A V ell) ≤ ell * p
EXACT_ELABORATED_SIGNATURE NLA.KE04.krylov_nesting_and_shift = NLA.KE04.FinalReferee1Reference.krylov_nesting_and_shift
EXPORTED_TYPE NLA.KE04.krylov_nesting_and_shift: ∀ {n p : ℕ} (A : NLA.KE04.Mat n) (V : NLA.KE04.Rect n p),
  NLA.KE04.krylov A V 0 = ⊥ ∧
    Monotone (NLA.KE04.krylov A V) ∧
      ∀ (ell : ℕ), ∀ x ∈ NLA.KE04.krylov A V ell, (NLA.KE04.act A) x ∈ NLA.KE04.krylov A V (ell + 1)
EXACT_ELABORATED_SIGNATURE NLA.KE04.fullBlockDimension_iff_independent = NLA.KE04.FinalReferee1Reference.fullBlockDimension_iff_independent
EXPORTED_TYPE NLA.KE04.fullBlockDimension_iff_independent: ∀ {n p : ℕ} (A : NLA.KE04.Mat n) (V : NLA.KE04.Rect n p)
  (ell : ℕ),
  (NLA.KE04.FullBlockDimension A V ell ↔ LinearIndependent ℝ (NLA.KE04.krylovColumns A V ell)) ∧
    (NLA.KE04.FullColumnRank V ↔ NLA.KE04.FullBlockDimension A V 1)
EXACT_ELABORATED_SIGNATURE NLA.KE04.fullBlockDimension_prefix = NLA.KE04.FinalReferee1Reference.fullBlockDimension_prefix
EXPORTED_TYPE NLA.KE04.fullBlockDimension_prefix: ∀ {n p : ℕ} (A : NLA.KE04.Mat n) (V : NLA.KE04.Rect n p) (s : ℕ),
  NLA.KE04.FullBlockDimension A V s →
    ∀ ell ≤ s, NLA.KE04.FullBlockDimension A V ell ∧ Function.Injective ⇑(NLA.KE04.krylovCombination A V ell)
EXACT_ELABORATED_SIGNATURE NLA.KE04.lastFullBlockIteration_exists = NLA.KE04.FinalReferee1Reference.lastFullBlockIteration_exists
EXPORTED_TYPE NLA.KE04.lastFullBlockIteration_exists: ∀ {n p : ℕ},
  0 < p →
    ∀ (A : NLA.KE04.Mat n) (V : NLA.KE04.Rect n p),
      NLA.KE04.FullColumnRank V → ∃ s, 1 ≤ s ∧ NLA.KE04.LastFullBlockIteration A V s
EXACT_ELABORATED_SIGNATURE NLA.KE04.krylovBasis_exists = NLA.KE04.FinalReferee1Reference.krylovBasis_exists
EXPORTED_TYPE NLA.KE04.krylovBasis_exists: ∀ {n p : ℕ} (A : NLA.KE04.Mat n) (V : NLA.KE04.Rect n p) (ell : ℕ),
  NLA.KE04.FullBlockDimension A V ell → ∃ Q, NLA.KE04.IsKrylovBasis A V ell Q
EXACT_ELABORATED_SIGNATURE NLA.KE04.frameProjection_semantics = NLA.KE04.FinalReferee1Reference.frameProjection_semantics
EXPORTED_TYPE NLA.KE04.frameProjection_semantics: ∀ {n m : ℕ} (Q : NLA.KE04.Rect n m),
  Matrix.transpose Q * Q = 1 →
    Matrix.IsHermitian (NLA.KE04.frameProjection Q) ∧
      NLA.KE04.frameProjection Q * NLA.KE04.frameProjection Q = NLA.KE04.frameProjection Q ∧
        (∀ (x : NLA.KE04.Vec n), x ∈ NLA.KE04.columnSpace Q ↔ (NLA.KE04.act (NLA.KE04.frameProjection Q)) x = x) ∧
          ∀ (x y : NLA.KE04.Vec n),
            y ∈ NLA.KE04.columnSpace Q → inner ℝ y (x - (NLA.KE04.act (NLA.KE04.frameProjection Q)) x) = 0
EXACT_ELABORATED_SIGNATURE NLA.KE04.compression_semantics = NLA.KE04.FinalReferee1Reference.compression_semantics
EXPORTED_TYPE NLA.KE04.compression_semantics: ∀ {n m : ℕ} (A : NLA.KE04.Mat n),
  Matrix.IsHermitian A →
    ∀ (Q : NLA.KE04.Rect n m),
      Matrix.transpose Q * Q = 1 →
        NLA.KE04.compression A Q = Matrix.transpose Q * A * Q ∧
          Matrix.IsHermitian (NLA.KE04.compression A Q) ∧
            ∀ x ∈ NLA.KE04.columnSpace Q,
              (NLA.KE04.act Q) ((NLA.KE04.act (NLA.KE04.compression A Q)) ((NLA.KE04.act (Matrix.transpose Q)) x)) =
                (NLA.KE04.act (NLA.KE04.frameProjection Q)) ((NLA.KE04.act A) x)
EXACT_ELABORATED_SIGNATURE NLA.KE04.orderedSpectrum_semantics = NLA.KE04.FinalReferee1Reference.orderedSpectrum_semantics
EXPORTED_TYPE NLA.KE04.orderedSpectrum_semantics: ∀ {m : ℕ} (M : NLA.KE04.Mat m) (hM : Matrix.IsHermitian M),
  Monotone (NLA.KE04.orderedEigenvalues M hM) ∧
    (∀ (r : Fin m),
        (NLA.KE04.act M) ((NLA.KE04.orderedEigenbasis M hM) r) =
          NLA.KE04.orderedEigenvalues M hM r • (NLA.KE04.orderedEigenbasis M hM) r) ∧
      (Matrix.charpoly M).roots = Multiset.map (NLA.KE04.orderedEigenvalues M hM) Finset.univ.val ∧
        ∀ (i : ℕ) (hi : i < m), NLA.KE04.eigenvalueAt M hM i = NLA.KE04.orderedEigenvalues M hM ⟨i, hi⟩
EXACT_ELABORATED_SIGNATURE NLA.KE04.compression_basis_independent = NLA.KE04.FinalReferee1Reference.compression_basis_independent
EXPORTED_TYPE NLA.KE04.compression_basis_independent: ∀ {n m : ℕ} (A : NLA.KE04.Mat n) (hA : Matrix.IsHermitian A)
  (Q R : NLA.KE04.Rect n m),
  Matrix.transpose Q * Q = 1 →
    Matrix.transpose R * R = 1 →
      NLA.KE04.columnSpace Q = NLA.KE04.columnSpace R →
        (∃ O,
            Matrix.transpose O * O = 1 ∧
              R = Q * O ∧ NLA.KE04.compression A R = Matrix.transpose O * NLA.KE04.compression A Q * O) ∧
          Matrix.charpoly (NLA.KE04.compression A Q) = Matrix.charpoly (NLA.KE04.compression A R) ∧
            NLA.KE04.ritzValues A hA Q = NLA.KE04.ritzValues A hA R
EXACT_ELABORATED_SIGNATURE NLA.KE04.interval_index_validity = NLA.KE04.FinalReferee1Reference.interval_index_validity
EXPORTED_TYPE NLA.KE04.interval_index_validity: ∀ (k p i : ℕ),
  1 ≤ k → 1 ≤ i → i ≤ (k - 1) * p → 2 ≤ k ∧ 0 < p ∧ i - 1 < k * p ∧ i + p - 1 < k * p
EXACT_ELABORATED_SIGNATURE NLA.KE04.quadratic_semantics = NLA.KE04.FinalReferee1Reference.quadratic_semantics
EXPORTED_TYPE NLA.KE04.quadratic_semantics: ∀ {m : ℕ} (M : NLA.KE04.Mat m) (a b : ℝ),
  (NLA.KE04.monicQuadratic a b).Monic ∧
    (NLA.KE04.monicQuadratic a b).natDegree = 2 ∧
      NLA.KE04.quadraticMatrix M a b = (Polynomial.aeval M) (NLA.KE04.monicQuadratic a b) ∧
        NLA.KE04.quadraticMatrix M a b = M ^ 2 - (a + b) • M + (a * b) • 1
EXACT_ELABORATED_SIGNATURE NLA.KE04.spectral_gap_quadratic_psd = NLA.KE04.FinalReferee1Reference.spectral_gap_quadratic_psd
EXPORTED_TYPE NLA.KE04.spectral_gap_quadratic_psd: ∀ {m : ℕ} (M : NLA.KE04.Mat m) (hM : Matrix.IsHermitian M) (a b : ℝ),
  a ≤ b →
    (∀ (r : Fin m), ¬(a < NLA.KE04.orderedEigenvalues M hM r ∧ NLA.KE04.orderedEigenvalues M hM r < b)) →
      Matrix.PosSemidef (NLA.KE04.quadraticMatrix M a b)
EXACT_ELABORATED_SIGNATURE NLA.KE04.spectral_window_subspace = NLA.KE04.FinalReferee1Reference.spectral_window_subspace
EXPORTED_TYPE NLA.KE04.spectral_window_subspace: ∀ {n m : ℕ} (A : NLA.KE04.Mat n) (hA : Matrix.IsHermitian A)
  (Q : NLA.KE04.Rect n m),
  Matrix.transpose Q * Q = 1 →
    ∀ (i p : ℕ),
      i + p < m →
        ∃ E ≤ NLA.KE04.columnSpace Q,
          Module.finrank ℝ ↥E = p + 1 ∧
            ∀ x ∈ E,
              NLA.KE04.form
                  (NLA.KE04.compressedQuadratic A Q (NLA.KE04.ritzValueAt A hA Q i)
                    (NLA.KE04.ritzValueAt A hA Q (i + p)))
                  x ≤
                0
EXACT_ELABORATED_SIGNATURE NLA.KE04.krylov_intersection_nonzero = NLA.KE04.FinalReferee1Reference.krylov_intersection_nonzero
EXPORTED_TYPE NLA.KE04.krylov_intersection_nonzero: ∀ {n p : ℕ} (A : NLA.KE04.Mat n) (V : NLA.KE04.Rect n p) (k : ℕ),
  1 ≤ k →
    NLA.KE04.FullBlockDimension A V k →
      NLA.KE04.FullBlockDimension A V (k - 1) →
        ∀ E ≤ NLA.KE04.krylov A V k, Module.finrank ℝ ↥E = p + 1 → ∃ x, x ≠ 0 ∧ x ∈ E ∧ x ∈ NLA.KE04.krylov A V (k - 1)
EXACT_ELABORATED_SIGNATURE NLA.KE04.psd_zero_form_iff_kernel = NLA.KE04.FinalReferee1Reference.psd_zero_form_iff_kernel
EXPORTED_TYPE NLA.KE04.psd_zero_form_iff_kernel: ∀ {m : ℕ} (M : NLA.KE04.Mat m),
  Matrix.PosSemidef M → ∀ (x : NLA.KE04.Vec m), NLA.KE04.form M x = 0 ↔ (NLA.KE04.act M) x = 0
EXACT_ELABORATED_SIGNATURE NLA.KE04.compressedQuadratic_semantics = NLA.KE04.FinalReferee1Reference.compressedQuadratic_semantics
EXPORTED_TYPE NLA.KE04.compressedQuadratic_semantics: ∀ {n m : ℕ} (A : NLA.KE04.Mat n) (Q : NLA.KE04.Rect n m)
  (a b : ℝ),
  (∀ (x : NLA.KE04.Vec n),
      NLA.KE04.form (NLA.KE04.compressedQuadratic A Q a b) x =
        NLA.KE04.form (NLA.KE04.quadraticMatrix (NLA.KE04.compression A Q) a b)
          ((NLA.KE04.act (Matrix.transpose Q)) x)) ∧
    (Matrix.PosSemidef (NLA.KE04.quadraticMatrix (NLA.KE04.compression A Q) a b) →
      Matrix.PosSemidef (NLA.KE04.compressedQuadratic A Q a b))
EXACT_ELABORATED_SIGNATURE NLA.KE04.quadratic_forms_agree = NLA.KE04.FinalReferee1Reference.quadratic_forms_agree
EXPORTED_TYPE NLA.KE04.quadratic_forms_agree: ∀ {n p : ℕ} (A : NLA.KE04.Mat n),
  Matrix.IsHermitian A →
    ∀ (V : NLA.KE04.Rect n p) (k j : ℕ),
      1 ≤ k →
        k < j →
          ∀ (Qk : NLA.KE04.Rect n (k * p)) (Qj : NLA.KE04.Rect n (j * p)),
            NLA.KE04.IsKrylovBasis A V k Qk →
              NLA.KE04.IsKrylovBasis A V j Qj →
                ∀ x ∈ NLA.KE04.krylov A V (k - 1),
                  ∀ (a b : ℝ),
                    NLA.KE04.form (NLA.KE04.compressedQuadratic A Qk a b) x =
                      NLA.KE04.form (NLA.KE04.compressedQuadratic A Qj a b) x
EXACT_ELABORATED_SIGNATURE NLA.KE04.later_quadratic_identity = NLA.KE04.FinalReferee1Reference.later_quadratic_identity
EXPORTED_TYPE NLA.KE04.later_quadratic_identity: ∀ {n p : ℕ} (A : NLA.KE04.Mat n) (V : NLA.KE04.Rect n p) (k j : ℕ),
  1 ≤ k →
    k < j →
      ∀ (Qj : NLA.KE04.Rect n (j * p)),
        NLA.KE04.IsKrylovBasis A V j Qj →
          ∀ x ∈ NLA.KE04.krylov A V (k - 1),
            ∀ (a b : ℝ),
              (NLA.KE04.act (NLA.KE04.compressedQuadratic A Qj a b)) x =
                (NLA.KE04.act (NLA.KE04.quadraticMatrix A a b)) x
EXACT_ELABORATED_SIGNATURE NLA.KE04.fullRank_quadratic_nonannihilation = NLA.KE04.FinalReferee1Reference.fullRank_quadratic_nonannihilation
EXPORTED_TYPE NLA.KE04.fullRank_quadratic_nonannihilation: ∀ {n p : ℕ} (A : NLA.KE04.Mat n) (V : NLA.KE04.Rect n p)
  (k : ℕ),
  2 ≤ k →
    NLA.KE04.FullBlockDimension A V (k + 1) →
      ∀ x ∈ NLA.KE04.krylov A V (k - 1), x ≠ 0 → ∀ (a b : ℝ), (NLA.KE04.act (NLA.KE04.quadraticMatrix A a b)) x ≠ 0
EXACT_ELABORATED_SIGNATURE NLA.KE04.strictIntervalOccupancy = NLA.KE04.FinalReferee1Reference.strictIntervalOccupancy
