                  (Mathlib.Tactic.Ring.Common.add_pf_add_zero
                    ((L j) h ^ Nat.rawCast 1 * ((L j) v ^ Nat.rawCast 1 * Nat.rawCast 2) + 0)))
                (Mathlib.Tactic.Ring.Common.zero_mul ((L j) v ^ Nat.rawCast 1 * Nat.rawCast 1 + 0))
                (Mathlib.Tactic.Ring.Common.add_pf_add_zero
                  ((L j) h ^ Nat.rawCast 1 * ((L j) v ^ Nat.rawCast 1 * Nat.rawCast 2) + 0))))
            (Mathlib.Tactic.Ring.Common.mul_congr
