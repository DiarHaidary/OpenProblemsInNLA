EXACT_FROZEN_TYPE NLA.IE05.entryMax_semantics_proved: ∀ {n : ℕ},
  1 ≤ n →
    ∀ (A : NLA.IE05.Mat n),
      0 ≤ NLA.IE05.entryMax A ∧ (∀ (i j : Fin n), |A i j| ≤ NLA.IE05.entryMax A) ∧ ∃ i j, NLA.IE05.entryMax A = |A i j|
EXACT_FROZEN_TYPE NLA.IE05.schurStep_bound_proved: ∀ {n : ℕ} (S : NLA.IE05.Mat n) (k p : Fin n),
  NLA.IE05.AdmissiblePivot S k p → NLA.IE05.activeMax (NLA.IE05.schurStep S k p) (↑k + 1) ≤ 2 * NLA.IE05.activeMax S ↑k
EXACT_FROZEN_TYPE NLA.IE05.gepp_growth_bound_proved: ∀ {n : ℕ},
  1 ≤ n →
    ∀ (A : NLA.IE05.Mat n) (path : NLA.IE05.PivotPath n),
      NLA.IE05.AdmissiblePath A path →
        0 < NLA.IE05.entryMax A ∧ 1 ≤ NLA.IE05.growth A path ∧ NLA.IE05.growth A path ≤ 2 ^ (n - 1)
EXACT_FROZEN_TYPE NLA.IE05.firstPath_semantics_proved: ∀ {n : ℕ} (A : NLA.IE05.Mat n),
  Matrix.det A ≠ 0 →
    NLA.IE05.FirstAvailablePath A (NLA.IE05.firstPath A) ∧
      (∀ (k : ℕ), NLA.IE05.trajectory A (NLA.IE05.firstPath A) k = NLA.IE05.firstTrajectory A k) ∧
        ∀ (path : NLA.IE05.PivotPath n), NLA.IE05.FirstAvailablePath A path → path = NLA.IE05.firstPath A
EXACT_FROZEN_TYPE NLA.IE05.orthogonalGrowthSet_bounded_proved: ∀ (n : ℕ),
  2 ≤ n →
    (NLA.IE05.orthogonalGrowthSet n).Nonempty ∧
      BddAbove (NLA.IE05.orthogonalGrowthSet n) ∧ ∀ r ∈ NLA.IE05.orthogonalGrowthSet n, 1 ≤ r ∧ r ≤ 2 ^ (n - 1)
