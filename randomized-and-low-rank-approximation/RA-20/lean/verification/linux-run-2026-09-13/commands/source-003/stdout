    let x : Fin 3 → ℂ := ![X 0 1, X 0 2, X 1 2]
    have hz : x 0 * x 1 * x 2 = 0 := by
      change X 0 1 * X 0 2 * X 1 2 = 0
      rcases hone with h | h | h
