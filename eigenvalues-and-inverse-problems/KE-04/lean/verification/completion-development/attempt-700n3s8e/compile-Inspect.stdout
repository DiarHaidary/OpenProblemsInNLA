    (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) ell p)
def NLA.KE04.FullColumnRank : {n p : Nat} → (V : NLA.KE04.Rect n p) → Prop :=
fun {n p : Nat} (V : NLA.KE04.Rect n p) =>
  @LinearIndependent.{0, 0, 0} (Fin p) Real (NLA.KE04.Vec n) (@NLA.KE04.column n p V) Real.semiring
    (@AddCommGroup.toAddCommMonoid.{0} (NLA.KE04.Vec n)
      (@WithLp.instAddCommGroup.{0}
        (@OfNat.ofNat.{0} ENNReal (nat_lit 2)
          (@instOfNatAtLeastTwo.{0} ENNReal (nat_lit 2)
            (@AddMonoidWithOne.toNatCast.{0} ENNReal
              (@AddCommMonoidWithOne.toAddMonoidWithOne.{0} ENNReal ENNReal.instAddCommMonoidWithOne))
            PiLp.innerProductSpace._proof_1))
        ((i : Fin n) → (fun (x : Fin n) => Real) i)
        (@Pi.addCommGroup.{0, 0} (Fin n) (fun (x : Fin n) => Real) fun (i : Fin n) => Real.instAddCommGroup)))
    (@WithLp.instModule.{0, 0}
      (@OfNat.ofNat.{0} ENNReal (nat_lit 2)
        (@instOfNatAtLeastTwo.{0} ENNReal (nat_lit 2)
          (@AddMonoidWithOne.toNatCast.{0} ENNReal
            (@AddCommMonoidWithOne.toAddMonoidWithOne.{0} ENNReal ENNReal.instAddCommMonoidWithOne))
          PiLp.innerProductSpace._proof_1))
      Real ((i : Fin n) → (fun (x : Fin n) => Real) i) Real.semiring
      (@Pi.addCommGroup.{0, 0} (Fin n) (fun (x : Fin n) => Real) fun (i : Fin n) => Real.instAddCommGroup)
      (@Pi.Function.module.{0, 0, 0} (Fin n) Real Real Real.semiring
        (@Semiring.toAddCommMonoid.{0} Real (@Ring.toSemiring.{0} Real Real.instRing))
        (@Semiring.toModule.{0} Real Real.semiring)))
def NLA.KE04.LastFullBlockIteration : {n p : Nat} → (A : NLA.KE04.Mat n) → (V : NLA.KE04.Rect n p) → (s : Nat) → Prop :=
fun {n p : Nat} (A : NLA.KE04.Mat n) (V : NLA.KE04.Rect n p) (s : Nat) =>
  And (@NLA.KE04.FullBlockDimension n p A V s)
    (∀ (t : Nat), @NLA.KE04.FullBlockDimension n p A V t → @LE.le.{0} Nat instLENat t s)
def NLA.KE04.IsKrylovBasis : {n p : Nat} →
  (A : NLA.KE04.Mat n) →
    (V : NLA.KE04.Rect n p) →
      (ell : Nat) →
        (Q : NLA.KE04.Rect n (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) ell p)) → Prop :=
fun {n p : Nat} (A : NLA.KE04.Mat n) (V : NLA.KE04.Rect n p) (ell : Nat)
    (Q : NLA.KE04.Rect n (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) ell p)) =>
  And
    (@Eq.{1}
      (Matrix.{0, 0, 0} (Fin (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) ell p))
        (Fin (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) ell p)) Real)
      (@HMul.hMul.{0, 0, 0}
        (Matrix.{0, 0, 0} (Fin (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) ell p)) (Fin n) Real)
        (NLA.KE04.Rect n (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) ell p))
        (Matrix.{0, 0, 0} (Fin (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) ell p))
          (Fin (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) ell p)) Real)
        (@Matrix.instHMulOfFintypeOfMulOfAddCommMonoid.{0, 0, 0, 0}
          (Fin (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) ell p)) (Fin n)
          (Fin (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) ell p)) Real (Fin.fintype n)
          Real.instMul Real.instAddCommMonoid)
        (@Matrix.transpose.{0, 0, 0} (Fin n)
          (Fin (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) ell p)) Real Q)
        Q)
      (@OfNat.ofNat.{0}
        (Matrix.{0, 0, 0} (Fin (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) ell p))
          (Fin (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) ell p)) Real)
        (nat_lit 1)
        (@One.toOfNat1.{0}
          (Matrix.{0, 0, 0} (Fin (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) ell p))
            (Fin (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) ell p)) Real)
          (@Matrix.one.{0, 0} (Fin (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) ell p)) Real
            (instDecidableEqFin (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) ell p)) Real.instZero
            Real.instOne))))
    (@Eq.{1}
      (@Submodule.{0, 0} Real (NLA.KE04.Vec n) Real.semiring
        (@AddCommGroup.toAddCommMonoid.{0} (NLA.KE04.Vec n)
          (@WithLp.instAddCommGroup.{0}
            (@OfNat.ofNat.{0} ENNReal (nat_lit 2)
              (@instOfNatAtLeastTwo.{0} ENNReal (nat_lit 2)
                (@AddMonoidWithOne.toNatCast.{0} ENNReal
                  (@AddCommMonoidWithOne.toAddMonoidWithOne.{0} ENNReal ENNReal.instAddCommMonoidWithOne))
                PiLp.innerProductSpace._proof_1))
            ((i : Fin n) → (fun (x : Fin n) => Real) i)
            (@Pi.addCommGroup.{0, 0} (Fin n) (fun (x : Fin n) => Real) fun (i : Fin n) => Real.instAddCommGroup)))
        (@WithLp.instModule.{0, 0}
          (@OfNat.ofNat.{0} ENNReal (nat_lit 2)
            (@instOfNatAtLeastTwo.{0} ENNReal (nat_lit 2)
              (@AddMonoidWithOne.toNatCast.{0} ENNReal
                (@AddCommMonoidWithOne.toAddMonoidWithOne.{0} ENNReal ENNReal.instAddCommMonoidWithOne))
              PiLp.innerProductSpace._proof_1))
          Real ((i : Fin n) → (fun (x : Fin n) => Real) i) Real.semiring
          (@Pi.addCommGroup.{0, 0} (Fin n) (fun (x : Fin n) => Real) fun (i : Fin n) => Real.instAddCommGroup)
          (@Pi.Function.module.{0, 0, 0} (Fin n) Real Real Real.semiring
            (@Semiring.toAddCommMonoid.{0} Real (@Ring.toSemiring.{0} Real Real.instRing))
            (@Semiring.toModule.{0} Real Real.semiring))))
      (@NLA.KE04.columnSpace n (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) ell p) Q)
      (@NLA.KE04.krylov n p A V ell))
theorem NLA.KE04._proved.strictIntervalOccupancy : NLA.KE04.FullPrefixBlockLanczosClaim :=
fun n p A hA V _hV s hs k j hk hkj hjs Qk Qj hQk hQj i hi hu =>
  And.casesOn (NLA.KE04._proved.interval_index_validity k p i hk hi hu) fun hk2 right =>
    And.casesOn right fun _hp right =>
      And.casesOn right fun hia hib =>
        let a := NLA.KE04.ritzValueAt A hA Qk (i - 1);
        let b := NLA.KE04.ritzValueAt A hA Qk (i + p - 1);
        have hidx :=
          Decidable.byContradiction fun a => NLA.KE04._proved.strictIntervalOccupancy._proof_1_1 p s k j i hi _hp a;
        have hab :=
          have hmon :=
            (NLA.KE04._proved.orderedSpectrum_semantics (NLA.KE04.compression A Qk)
                (Matrix.isHermitian_conjTranspose_mul_mul Qk hA)).left;
          have horder :=
            id
              (Decidable.byContradiction fun a =>
                NLA.KE04._proved.strictIntervalOccupancy._proof_1_2 p s k j i _hp hidx a);
          Eq.mpr
            (id
              (congr
                (congrArg LE.le
                  (Eq.trans (NLA.KE04.ritzValueAt.eq_1 A hA Qk (i - 1))
                    ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => dif_pos hia) x_0 x_1 x_2 x_3)
                      ((i - 1).decLt (k * p)) ℝ
                      (fun h =>
                        NLA.KE04.orderedEigenvalues (NLA.KE04.compression A Qk) (NLA.KE04.ritzValues._proof_1 A hA Qk)
                          ⟨i - 1, h⟩)
                      fun h => 0)))
                (Eq.trans (NLA.KE04.ritzValueAt.eq_1 A hA Qk (i + p - 1))
                  ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => dif_pos hib) x_0 x_1 x_2 x_3)
                    ((i + p - 1).decLt (k * p)) ℝ
                    (fun h =>
                      NLA.KE04.orderedEigenvalues (NLA.KE04.compression A Qk) (NLA.KE04.ritzValues._proof_1 A hA Qk)
                        ⟨i + p - 1, h⟩)
                    fun h => 0))))
            (hmon horder);
        Decidable.byContradiction fun hno =>
          have hgap := fun r hr => hno (Exists.intro r hr);
          have hsmall :=
            NLA.KE04._proved.spectral_gap_quadratic_psd (NLA.KE04.compression A Qj)
              (Matrix.isHermitian_conjTranspose_mul_mul Qj hA) a b hab hgap;
          have hpsd := (NLA.KE04._proved.compressedQuadratic_semantics A Qj a b).right hsmall;
          Exists.casesOn
            (NLA.KE04._proved.spectral_window_subspace A hA Qk hQk.left (i - 1) p
              (Decidable.byContradiction fun a =>
                NLA.KE04._proved.strictIntervalOccupancy._proof_1_3 p s k j i hib hidx a))
            fun E h =>
            And.casesOn h fun hE right =>
              And.casesOn right fun hdim hform =>
                have hEk := Eq.mpr (id (congrArg (fun _a => E ≤ _a) (Eq.symm hQk.right))) hE;
                have hfullk :=
                  (NLA.KE04._proved.fullBlockDimension_prefix A V s hs k
                      (Decidable.byContradiction fun a =>
                        NLA.KE04._proved.strictIntervalOccupancy._proof_1_4 n p s k j hkj hjs i E a)).left;
                have hprev :=
                  (NLA.KE04._proved.fullBlockDimension_prefix A V s hs (k - 1)
                      (Decidable.byContradiction fun a =>
                        NLA.KE04._proved.strictIntervalOccupancy._proof_1_5 n p s k j hkj hjs i hk2 E a)).left;
                Exists.casesOn (NLA.KE04._proved.krylov_intersection_nonzero A V k hk hfullk hprev E hEk hdim)
                  fun x h =>
                  And.casesOn h fun hne right =>
                    And.casesOn right fun hxE hx =>
                      have hle :=
                        id
                          (Eq.mp
                            (congrFun'
                              (congrArg LE.le
                                (congrFun'
                                  (congrArg NLA.KE04.form
                                    (congrArg (NLA.KE04.compressedQuadratic A Qk (NLA.KE04.ritzValueAt A hA Qk (i - 1)))
                                      (NLA.KE04.ritzValueAt.congr_simp A A (Eq.refl A) hA Qk Qk (Eq.refl Qk) (i - 1 + p)
                                        (i + p - 1) hidx)))
                                  x))
                              0)
                            (hform x hxE));
                      have hzero :=
                        le_antisymm
                          (Eq.mp
                            (congrArg (fun _a => _a ≤ 0)
                              (NLA.KE04._proved.quadratic_forms_agree A hA V k j hk hkj Qk Qj hQk hQj x hx a b))
                            hle)
                          (NLA.KE04._proved.psd_form_nonneg (NLA.KE04.compressedQuadratic A Qj a b) hpsd x);
                      have hkernel :=
                        (NLA.KE04._proved.psd_zero_form_iff_kernel (NLA.KE04.compressedQuadratic A Qj a b) hpsd x).mp
                          hzero;
                      have hfullnext :=
                        (NLA.KE04._proved.fullBlockDimension_prefix A V s hs (k + 1)
                            (Decidable.byContradiction fun a =>
                              NLA.KE04._proved.strictIntervalOccupancy._proof_1_7 n p s k j hkj hjs i E a)).left;
                      NLA.KE04._proved.fullRank_quadratic_nonannihilation A V k hk2 hfullnext x hx hne a b
                        (Eq.mp
                          (congrArg (fun _a => _a = 0)
                            (NLA.KE04._proved.later_quadratic_identity A V k j hk hkj Qj hQj x hx a b))
                          hkernel)
theorem NLA.KE04._proved.blockLanczosConjecture : NLA.KE04.BlockLanczosConjecture :=
NLA.KE04._proved.fullPrefix_implies_canonical NLA.KE04._proved.strictIntervalOccupancy
theorem NLA.KE04._proved.psd_form_nonneg : ∀ {m : ℕ} (M : NLA.KE04.Mat m),
  Matrix.PosSemidef M → ∀ (x : NLA.KE04.Vec m), 0 ≤ NLA.KE04.form M x :=
fun {m} M hM x => LinearMap.IsPositive.inner_nonneg_right (Matrix.isPositive_toEuclideanLin_iff.mpr hM) x
