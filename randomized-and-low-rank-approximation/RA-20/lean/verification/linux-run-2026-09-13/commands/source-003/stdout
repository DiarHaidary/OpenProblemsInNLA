    let L : Matrix (Fin 3) (Fin 2) ℂ := !![1, 0; 0, a; 0, b]
    let R : Matrix (Fin 2) (Fin 3) ℂ := !![0, a, b; 1, 0, 0]
    have heq : hollow a b 0 = L * R := by
