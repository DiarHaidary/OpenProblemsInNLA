def NLA.RA20.variety : (n s : Nat) → Set.{0} (NLA.RA20.Mat n) :=
fun (n s : Nat) =>
  @Set.ofPred.{0} (NLA.RA20.Mat n) fun (X : NLA.RA20.Mat n) =>
    And (@Matrix.IsSymm.{0, 0} Complex (Fin n) X)
      (And
        (@LE.le.{0} Nat instLENat
          (@Matrix.rank.{0, 0, 0} (Fin n) (Fin n) Complex (Fin.fintype n) Complex.instCommSemiring X)
          (@OfNat.ofNat.{0} Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
        (∀ (i : Fin n),
          @LT.lt.{0} Nat instLTNat (@Fin.val n i) s →
            @Eq.{1} Complex (X i i)
              (@OfNat.ofNat.{0} Complex (nat_lit 0) (@Zero.toOfNat0.{0} Complex Complex.instZero))))
def NLA.RA20.definingIdeal : (n s : Nat) →
  @Ideal.{0} (NLA.RA20.Poly n)
    (@AddMonoidAlgebra.semiring.{0, 0} Complex
