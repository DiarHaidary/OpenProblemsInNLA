                  (Eq.mpr
                    (id
                      (congrArg (fun _a => (L j) h ^ Nat.rawCast 1 * Nat.rawCast 1 = (L j) h ^ Nat.rawCast 1 * _a)
                        (Eq.symm rfl)))
                    (Eq.refl ((L j) h ^ Nat.rawCast 1 * Nat.rawCast 1))))
                (Mathlib.Tactic.Ring.Common.add_mul
                  (Mathlib.Tactic.Ring.Common.mul_add
                    (Mathlib.Tactic.Ring.Common.mul_pf_right ((L j) h) (Nat.rawCast 1)
                      (Mathlib.Meta.NormNum.IsNat.to_raw_eq
                        (Mathlib.Meta.NormNum.isNat_mul (Eq.refl HMul.hMul) (Mathlib.Meta.NormNum.IsNat.of_raw ℂ 2)
                          (Mathlib.Meta.NormNum.IsNat.of_raw ℂ 1) (Eq.refl 2))))
                    (Mathlib.Tactic.Ring.Common.mul_zero (Nat.rawCast 2))
                    (Mathlib.Tactic.Ring.Common.add_pf_add_zero ((L j) h ^ Nat.rawCast 1 * Nat.rawCast 2 + 0)))
                  (Mathlib.Tactic.Ring.Common.zero_mul ((L j) h ^ Nat.rawCast 1 * Nat.rawCast 1 + 0))
                  (Mathlib.Tactic.Ring.Common.add_pf_add_zero ((L j) h ^ Nat.rawCast 1 * Nat.rawCast 2 + 0))))
