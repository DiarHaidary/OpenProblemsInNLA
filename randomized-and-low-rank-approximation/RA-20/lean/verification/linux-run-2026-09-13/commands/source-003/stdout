        pruneSolvedGoals
        return result
    | .rejected | .failed _ =>
        saved.restore
        return result
  catch e =>
    saved.restore
    let detail ←
      try e.toMessageData.toString
      catch _ => pure "an exception escaped the verification implementation"
    return .failed <| .internalError detail

