                  (NLA.IE05.castIntegerMatrix (NLA.IE05.integerT b)) (fun j => ↑(NLA.IE05.integerD b j)) hL hLb hT hTp
                  hd;
              Eq.mpr
                (id
                  (congr
                    (congrArg And
                      (congrFun'
                        (congrArg NLA.IE05.FirstAvailablePath
                          (congrFun' (congrArg NLA.IE05.scaledColumns hLU) fun j => ↑(NLA.IE05.integerD b j)))
                        (NLA.IE05.noSwapPath 8)))
                    (congr
                      (congrArg And
                        (congrFun'
                          (congrArg Eq
                            (congrArg NLA.IE05.firstPath
                              (congrFun' (congrArg NLA.IE05.scaledColumns hLU) fun j => ↑(NLA.IE05.integerD b j))))
                          (NLA.IE05.noSwapPath 8)))
                      (forall_congr fun k =>
                        implies_congr (Eq.refl (k ≤ 8))
                          (congr
                            (congrArg Eq
                              (congrFun'
                                (congrFun'
                                  (congrArg NLA.IE05.trajectory
                                    (congrFun' (congrArg NLA.IE05.scaledColumns hLU) fun j => ↑(NLA.IE05.integerD b j)))
                                  (NLA.IE05.noSwapPath 8))
                                k))
                            (congrFun'
                              (congrArg NLA.IE05.scaledColumns
                                (NLA.IE05._proved.castIntegerMatrix_tailProduct (NLA.IE05.integerLower b)
                                  (NLA.IE05.integerT b) k))
                              fun j => ↑(NLA.IE05.integerD b j)))))))
                h
theorem NLA.IE05._proved.normalizedInteger_trajectory_entry : ∀ (b : Bool),
  ∀ k ≤ 8,
    ∀ (i j : Fin 8),
      NLA.IE05.trajectory (NLA.IE05.normalizedInteger b) (NLA.IE05.noSwapPath 8) k i j =
        ↑(NLA.IE05.tailProduct (NLA.IE05.integerLower b) (NLA.IE05.integerT b) k i j) / √↑(NLA.IE05.integerD b j) :=
fun b k hk i j =>
  Eq.mpr
    (id
      (congrArg
        (fun _a =>
          _a i j =
            ↑(NLA.IE05.tailProduct (NLA.IE05.integerLower b) (NLA.IE05.integerT b) k i j) / √↑(NLA.IE05.integerD b j))
        ((NLA.IE05._proved.normalizedInteger_path_trajectory b).right.right k hk)))
    (Eq.refl
      (NLA.IE05.scaledColumns
        (NLA.IE05.castIntegerMatrix (NLA.IE05.tailProduct (NLA.IE05.integerLower b) (NLA.IE05.integerT b) k))
        (fun j => ↑(NLA.IE05.integerD b j)) i j))
theorem NLA.IE05._proved.canonical_integer_identification : NLA.IE05.candidateQ 8 = NLA.IE05.normalizedInteger false ∧
  NLA.IE05.firstPath (NLA.IE05.candidateQ 8) = NLA.IE05.noSwapPath 8 :=
And.casesOn (NLA.IE05._proved.real_factor_certificates false) fun hGram right =>
  And.casesOn right fun hLU right =>
    And.casesOn right fun left right =>
      And.casesOn right fun hT right =>
        And.casesOn right fun left right =>
          And.casesOn right fun hTp hd =>
            have hQ :=
              id
                (Eq.mpr
                  (id
                    (congrArg
                      (fun _a =>
                        NLA.IE05.normalizedQRQ _a =
                          NLA.IE05.scaledColumns (NLA.IE05.castIntegerMatrix (NLA.IE05.integerH false)) fun j =>
                            ↑(NLA.IE05.integerD false j))
                      (Eq.symm NLA.IE05._proved.integerLower_false_prescribed)))
                  (NLA.IE05._proved.normalizedQRQ_of_gram_lu (NLA.IE05.castIntegerMatrix (NLA.IE05.integerLower false))
                    (NLA.IE05.castIntegerMatrix (NLA.IE05.integerH false))
                    (NLA.IE05.castIntegerMatrix (NLA.IE05.integerT false)) (fun j => ↑(NLA.IE05.integerD false j)) hd
                    hGram hLU hT hTp));
            ⟨hQ,
              Eq.mpr (id (congrArg (fun _a => NLA.IE05.firstPath _a = NLA.IE05.noSwapPath 8) hQ))
                (NLA.IE05._proved.normalizedInteger_path_trajectory false).right.left⟩
theorem NLA.IE05._proved.witness_orthogonal_path : NLA.IE05.Orthogonal NLA.IE05.witnessQ ∧
  NLA.IE05.firstPath NLA.IE05.witnessQ = NLA.IE05.noSwapPath 8 ∧
    NLA.IE05.FirstAvailablePath NLA.IE05.witnessQ (NLA.IE05.noSwapPath 8) ∧
      NLA.IE05.AdmissiblePath NLA.IE05.witnessQ (NLA.IE05.noSwapPath 8) :=
And.casesOn (NLA.IE05._proved.normalizedInteger_path_trajectory true) fun hpath right =>
  And.casesOn right fun hfirst right =>
    ⟨NLA.IE05._proved.normalizedInteger_orthogonal true, ⟨hfirst, ⟨hpath, fun k => (hpath k).left⟩⟩⟩
