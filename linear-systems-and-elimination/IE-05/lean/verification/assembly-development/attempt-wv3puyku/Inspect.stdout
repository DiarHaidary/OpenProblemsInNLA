EXACT_FROZEN_TYPE NLA.IE05.entryMax_semantics: ∀ {n : ℕ},
  1 ≤ n →
    ∀ (A : NLA.IE05.Mat n),
      0 ≤ NLA.IE05.entryMax A ∧ (∀ (i j : Fin n), |A i j| ≤ NLA.IE05.entryMax A) ∧ ∃ i j, NLA.IE05.entryMax A = |A i j|
EXACT_FROZEN_TYPE NLA.IE05.schurStep_bound: ∀ {n : ℕ} (S : NLA.IE05.Mat n) (k p : Fin n),
  NLA.IE05.AdmissiblePivot S k p → NLA.IE05.activeMax (NLA.IE05.schurStep S k p) (↑k + 1) ≤ 2 * NLA.IE05.activeMax S ↑k
EXACT_FROZEN_TYPE NLA.IE05.gepp_growth_bound: ∀ {n : ℕ},
  1 ≤ n →
    ∀ (A : NLA.IE05.Mat n) (path : NLA.IE05.PivotPath n),
      NLA.IE05.AdmissiblePath A path →
        0 < NLA.IE05.entryMax A ∧ 1 ≤ NLA.IE05.growth A path ∧ NLA.IE05.growth A path ≤ 2 ^ (n - 1)
EXACT_FROZEN_TYPE NLA.IE05.firstPath_semantics: ∀ {n : ℕ} (A : NLA.IE05.Mat n),
  Matrix.det A ≠ 0 →
    NLA.IE05.FirstAvailablePath A (NLA.IE05.firstPath A) ∧
      (∀ (k : ℕ), NLA.IE05.trajectory A (NLA.IE05.firstPath A) k = NLA.IE05.firstTrajectory A k) ∧
        ∀ (path : NLA.IE05.PivotPath n), NLA.IE05.FirstAvailablePath A path → path = NLA.IE05.firstPath A
EXACT_FROZEN_TYPE NLA.IE05.orthogonalGrowthSet_bounded: ∀ (n : ℕ),
  2 ≤ n →
    (NLA.IE05.orthogonalGrowthSet n).Nonempty ∧
      BddAbove (NLA.IE05.orthogonalGrowthSet n) ∧ ∀ r ∈ NLA.IE05.orthogonalGrowthSet n, 1 ≤ r ∧ r ≤ 2 ^ (n - 1)
EXACT_FROZEN_TYPE NLA.IE05.candidate_positiveQR: ∀ (n : ℕ),
  2 ≤ n →
    NLA.IE05.PositiveQR (NLA.IE05.prescribedLower n) (NLA.IE05.candidateQ n) (NLA.IE05.candidateR n) ∧
      ∀ (Q R : NLA.IE05.Mat n),
        NLA.IE05.PositiveQR (NLA.IE05.prescribedLower n) Q R → Q = NLA.IE05.candidateQ n ∧ R = NLA.IE05.candidateR n
EXACT_FROZEN_TYPE NLA.IE05.scaledColumns_orthogonal: ∀ {n : ℕ} (H : NLA.IE05.Mat n) (d : Fin n → ℝ),
  (∀ (j : Fin n), 0 < d j) →
    Matrix.transpose H * H = Matrix.diagonal d → NLA.IE05.Orthogonal (NLA.IE05.scaledColumns H d)
EXACT_FROZEN_TYPE NLA.IE05.scaledLU_trajectory: ∀ {n : ℕ} (L T : NLA.IE05.Mat n) (d : Fin n → ℝ),
  NLA.IE05.UnitLower L →
    (∀ (i j : Fin n), j < i → |L i j| ≤ 1) →
      NLA.IE05.UpperTriangular T →
        (∀ (i : Fin n), 0 < T i i) →
          (∀ (j : Fin n), 0 < d j) →
            NLA.IE05.FirstAvailablePath (NLA.IE05.scaledColumns (L * T) d) (NLA.IE05.noSwapPath n) ∧
              NLA.IE05.firstPath (NLA.IE05.scaledColumns (L * T) d) = NLA.IE05.noSwapPath n ∧
                ∀ k ≤ n,
                  NLA.IE05.trajectory (NLA.IE05.scaledColumns (L * T) d) (NLA.IE05.noSwapPath n) k =
                    NLA.IE05.scaledColumns (NLA.IE05.tailProduct L T k) d
EXACT_FROZEN_TYPE NLA.IE05.integer_factor_certificates: ∀ (b : Bool),
  Matrix.transpose (NLA.IE05.integerH b) * NLA.IE05.integerH b = Matrix.diagonal (NLA.IE05.integerD b) ∧
    NLA.IE05.integerH b = NLA.IE05.integerLower b * NLA.IE05.integerT b ∧
      NLA.IE05.UnitLower (NLA.IE05.integerLower b) ∧
        NLA.IE05.UpperTriangular (NLA.IE05.integerT b) ∧
          (∀ (i j : Fin 8), j < i → |NLA.IE05.integerLower b i j| ≤ 1) ∧
            (∀ (i : Fin 8), 0 < NLA.IE05.integerT b i i) ∧ ∀ (j : Fin 8), 0 < NLA.IE05.integerD b j
EXACT_FROZEN_TYPE NLA.IE05.integer_entry_certificates: (∀ (i j : Fin 8),
    5272 * NLA.IE05.integerH true i j ^ 2 ≤ 3969 * NLA.IE05.integerD true j) ∧
  NLA.IE05.integerD true 7 = 5272 ∧
    NLA.IE05.integerH false 2 2 = 51 ∧
      NLA.IE05.integerD false 2 = 3286 ∧
        (∀ (k i j : Fin 8),
            k ≤ i →
              k ≤ j →
                NLA.IE05.tailProduct (NLA.IE05.integerLower false) (NLA.IE05.integerT false) (↑k) i j ^ 2 ≤
                  5462 * NLA.IE05.integerD false j) ∧
          NLA.IE05.tailProduct (NLA.IE05.integerLower true) (NLA.IE05.integerT true) 7 7 7 = 5272
EXACT_FROZEN_TYPE NLA.IE05.canonical_integer_identification: NLA.IE05.candidateQ 8 = NLA.IE05.normalizedInteger false ∧
  NLA.IE05.firstPath (NLA.IE05.candidateQ 8) = NLA.IE05.noSwapPath 8
EXACT_FROZEN_TYPE NLA.IE05.witness_orthogonal_path: NLA.IE05.Orthogonal NLA.IE05.witnessQ ∧
  NLA.IE05.firstPath NLA.IE05.witnessQ = NLA.IE05.noSwapPath 8 ∧
    NLA.IE05.FirstAvailablePath NLA.IE05.witnessQ (NLA.IE05.noSwapPath 8) ∧
      NLA.IE05.AdmissiblePath NLA.IE05.witnessQ (NLA.IE05.noSwapPath 8)
EXACT_FROZEN_TYPE NLA.IE05.bounded_growth_data: NLA.IE05.entryMax NLA.IE05.witnessQ ≤ 63 / √5272 ∧
  5272 / 63 ≤ NLA.IE05.firstGrowth NLA.IE05.witnessQ ∧
    51 / √3286 ≤ NLA.IE05.entryMax (NLA.IE05.candidateQ 8) ∧
      0 ≤ NLA.IE05.firstGrowth (NLA.IE05.candidateQ 8) ∧
        NLA.IE05.firstGrowth (NLA.IE05.candidateQ 8) ^ 2 ≤ 17948132 / 2601
EXACT_FROZEN_TYPE NLA.IE05.numerical_gap_positive: (5272 / 63) ^ 2 - 17948132 / 2601 = 117335164 / 1147041 ∧
  0 < 117335164 / 1147041
EXACT_FROZEN_TYPE NLA.IE05.witness_strict_growth: NLA.IE05.firstGrowth (NLA.IE05.candidateQ 8) <
  NLA.IE05.firstGrowth NLA.IE05.witnessQ
EXACT_FROZEN_TYPE NLA.IE05.supremum_strict_gap: NLA.IE05.firstGrowth (NLA.IE05.candidateQ 8) <
  NLA.IE05.orthogonalGrowthSup 8
EXACT_FROZEN_TYPE NLA.IE05.orthogonalExtremizerConjecture: ¬NLA.IE05.OrthogonalExtremizerConjecture
