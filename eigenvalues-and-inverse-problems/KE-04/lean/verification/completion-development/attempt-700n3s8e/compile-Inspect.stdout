            ((i : Fin n) → (fun (x : Fin n) => Real) i)
            (@Pi.addCommGroup.{0, 0} (Fin n) (fun (x : Fin n) => Real) fun (i : Fin n) => Real.instAddCommGroup)))
        (@WithLp.instModule.{0, 0}
