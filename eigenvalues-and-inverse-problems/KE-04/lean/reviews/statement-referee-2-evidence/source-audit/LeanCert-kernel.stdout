49-open Lean Meta Elab Tactic
50-
51:register_option leancert.trust : String := {
52-  defValue := "native"
53-  descr := "LeanCert certificate verification route: \"native\" (native_decide; \
54-    trusts the compiler/runtime), \"kernel\" (decide +kernel; kernel-only \
55-    trusted base, never falls back), or \"auto\" (try kernel first within \
56-    leancert.trust.kernelHeartbeats, fall back to native_decide and report)"
57-}
58-
59:register_option leancert.trust.kernelHeartbeats : Nat := {
60-  defValue := 400000
61-  descr := "heartbeat budget for the kernel verification attempt in \
62-    leancert.trust = \"auto\" mode (same units as maxHeartbeats)"
63-}
64-
65:register_option leancert.trust.autoGate : Bool := {
66-  defValue := true
67-  descr := "in leancert.trust = \"auto\" mode, skip the kernel attempt for \
68-    certificates whose size predictably exceeds the calibrated kernel/native \
69-    crossover (finite-sum term count, integration partition count, \
70-    optimization iterations) and go straight to native_decide; see \
71-    scripts/bench-trust/README.md for the calibration data"
72-}
73-
74:register_option leancert.trust.autoMaxSumTerms : Nat := {
75-  defValue := 2000
76-  descr := "auto-mode gate: maximum finite-sum term count for which the \
77-    kernel attempt is made (crossover ≈ 10^4 terms at ~35s/+1.5 GiB; \
78-    ≤2×10^3 costs under a second)"
79-}
80-
81:register_option leancert.trust.autoMaxPartitions : Nat := {
82-  defValue := 500
83-  descr := "auto-mode gate: maximum integration partition count for which \
84-    the kernel attempt is made (500 partitions ≈ +2.5s)"
85-}
86-
87:register_option leancert.trust.autoMaxOptIterations : Nat := {
88-  defValue := 100
89-  descr := "auto-mode gate: maximum branch-and-bound iteration limit for \
90-    which the kernel attempt is made (a conservative policy threshold; the \
91-    v4.32.2 calibration matrix measures comparable routes through 50 iterations)"
92-}
