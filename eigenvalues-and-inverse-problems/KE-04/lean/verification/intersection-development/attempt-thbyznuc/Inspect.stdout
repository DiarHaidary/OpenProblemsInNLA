'NLA.KE04._proved.krylov_intersection_nonzero' depends on axioms: [propext, Classical.choice, Quot.sound]
EXACT_CONTRACT NLA.KE04._proved.krylov_intersection_nonzero: ∀ {n p : ℕ} (A : Mat n) (V : Rect n p) (k : ℕ),
  1 ≤ k →
    FullBlockDimension A V k →
      FullBlockDimension A V (k - 1) →
        ∀ E ≤ krylov A V k, Module.finrank ℝ ↥E = p + 1 → ∃ x, x ≠ 0 ∧ x ∈ E ∧ x ∈ krylov A V (k - 1)
