EXACT_FROZEN_TYPE NLA.RA20.full_frobenius_differential_proved: ∀ (n : ℕ) (U X Z : NLA.RA20.Mat n),
  (fderiv ℂ (NLA.RA20.fullFrobeniusDistance U) X) Z = 2 * ∑ i, ∑ j, (X i j - U i j) * Z i j
EXACT_FROZEN_TYPE NLA.RA20.hollow_distance_semantics_proved: ∀ (U : NLA.RA20.Mat 3),
  Matrix.IsSymm U →
    ∀ (a b c : ℂ),
      NLA.RA20.fullFrobeniusDistance U (NLA.RA20.hollow a b c) =
        ∑ i, U i i ^ 2 + 2 * ((a - U 0 1) ^ 2 + (b - U 0 2) ^ 2 + (c - U 1 2) ^ 2)
EXACT_FROZEN_TYPE NLA.RA20.component_hessians_proved: ∀ (U : NLA.RA20.Mat 3) (i : Fin 3) (z h v : Fin 2 → ℂ),
  ((fderiv ℂ (fun w => fderiv ℂ (fun y => NLA.RA20.fullFrobeniusDistance U (NLA.RA20.planeCoordinates i y)) w) z) h) v =
      4 * ∑ j, h j * v j ∧
    ((∀ (v : Fin 2 → ℂ), 4 * ∑ j, h j * v j = 0) → h = 0)
