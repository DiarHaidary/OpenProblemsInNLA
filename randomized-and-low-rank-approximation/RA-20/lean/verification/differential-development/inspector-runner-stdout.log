                                                      x))
                                                (Fin.sum_univ_succ fun i =>
                                                  Matrix.vecCons (![0, h 0] i)
                                                      (fun i_1 =>
                                                        Matrix.vecCons (![0, h 1] i) (fun i_2 => ![h 1, 0] i) i_1)
                                                      x *
