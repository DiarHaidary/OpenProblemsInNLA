NLA.KE04.real_matrix_semantics {n m : Nat} (A : NLA.KE04.Mat n) (M : NLA.KE04.Rect n m) :
  And
    (Iff
      (@Matrix.IsHermitian.{0, 0} Real (Fin n)
        (@InvolutiveStar.toStar.{0} Real
          (@StarAddMonoid.toInvolutiveStar.{0} Real
            (@AddCommMonoid.toAddMonoid.{0} Real
              (@NonUnitalNonAssocSemiring.toAddCommMonoid.{0} Real
                (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring.{0} Real
                  (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing.{0} Real
                    (@NonUnitalCommRing.toNonUnitalNonAssocCommRing.{0} Real
                      (@CommRing.toNonUnitalCommRing.{0} Real Real.commRing))))))
            (@StarRing.toStarAddMonoid.{0} Real
              (@NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring.{0} Real
                (@NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing.{0} Real
                  (@NonUnitalCommRing.toNonUnitalNonAssocCommRing.{0} Real
                    (@CommRing.toNonUnitalCommRing.{0} Real Real.commRing))))
              instStarRingReal)))
        A)
      (@Eq.{1} (Matrix.{0, 0, 0} (Fin n) (Fin n) Real) (@Matrix.transpose.{0, 0, 0} (Fin n) (Fin n) Real A) A))
    (And
      (∀ (x : NLA.KE04.Vec m) (i : Fin n),
        @Eq.{1} ((fun (x : Fin n) => Real) i)
          (@WithLp.ofLp.{0}
            (@OfNat.ofNat.{0} ENNReal (nat_lit 2)
              (@instOfNatAtLeastTwo.{0} ENNReal (nat_lit 2)
                (@AddMonoidWithOne.toNatCast.{0} ENNReal
                  (@AddCommMonoidWithOne.toAddMonoidWithOne.{0} ENNReal ENNReal.instAddCommMonoidWithOne))
                PiLp.innerProductSpace._proof_1))
            ((i : Fin n) → (fun (x : Fin n) => Real) i)
            (@DFunLike.coe.{1, 1, 1}
              (@LinearMap.{0, 0, 0, 0} Real Real Real.semiring Real.semiring
                (@RingHom.id.{0} Real (@Semiring.toNonAssocSemiring.{0} Real Real.semiring)) (NLA.KE04.Vec m)
                (NLA.KE04.Vec n)
                (@AddCommGroup.toAddCommMonoid.{0} (NLA.KE04.Vec m)
                  (@WithLp.instAddCommGroup.{0}
                    (@OfNat.ofNat.{0} ENNReal (nat_lit 2)
                      (@instOfNatAtLeastTwo.{0} ENNReal (nat_lit 2)
                        (@AddMonoidWithOne.toNatCast.{0} ENNReal
                          (@AddCommMonoidWithOne.toAddMonoidWithOne.{0} ENNReal ENNReal.instAddCommMonoidWithOne))
                        PiLp.innerProductSpace._proof_1))
                    ((i : Fin m) → (fun (x : Fin m) => Real) i)
                    (@Pi.addCommGroup.{0, 0} (Fin m) (fun (x : Fin m) => Real) fun (i : Fin m) =>
                      Real.instAddCommGroup)))
                (@AddCommGroup.toAddCommMonoid.{0} (NLA.KE04.Vec n)
                  (@WithLp.instAddCommGroup.{0}
                    (@OfNat.ofNat.{0} ENNReal (nat_lit 2)
                      (@instOfNatAtLeastTwo.{0} ENNReal (nat_lit 2)
                        (@AddMonoidWithOne.toNatCast.{0} ENNReal
                          (@AddCommMonoidWithOne.toAddMonoidWithOne.{0} ENNReal ENNReal.instAddCommMonoidWithOne))
                        PiLp.innerProductSpace._proof_1))
                    ((i : Fin n) → (fun (x : Fin n) => Real) i)
                    (@Pi.addCommGroup.{0, 0} (Fin n) (fun (x : Fin n) => Real) fun (i : Fin n) =>
                      Real.instAddCommGroup)))
                (@WithLp.instModule.{0, 0}
                  (@OfNat.ofNat.{0} ENNReal (nat_lit 2)
                    (@instOfNatAtLeastTwo.{0} ENNReal (nat_lit 2)
                      (@AddMonoidWithOne.toNatCast.{0} ENNReal
                        (@AddCommMonoidWithOne.toAddMonoidWithOne.{0} ENNReal ENNReal.instAddCommMonoidWithOne))
                      PiLp.innerProductSpace._proof_1))
                  Real ((i : Fin m) → (fun (x : Fin m) => Real) i) Real.semiring
                  (@Pi.addCommGroup.{0, 0} (Fin m) (fun (x : Fin m) => Real) fun (i : Fin m) => Real.instAddCommGroup)
                  (@Pi.Function.module.{0, 0, 0} (Fin m) Real Real Real.semiring
                    (@Semiring.toAddCommMonoid.{0} Real (@Ring.toSemiring.{0} Real Real.instRing))
                    (@Semiring.toModule.{0} Real Real.semiring)))
                (@WithLp.instModule.{0, 0}
                  (@OfNat.ofNat.{0} ENNReal (nat_lit 2)
                    (@instOfNatAtLeastTwo.{0} ENNReal (nat_lit 2)
                      (@AddMonoidWithOne.toNatCast.{0} ENNReal
                        (@AddCommMonoidWithOne.toAddMonoidWithOne.{0} ENNReal ENNReal.instAddCommMonoidWithOne))
                      PiLp.innerProductSpace._proof_1))
                  Real ((i : Fin n) → (fun (x : Fin n) => Real) i) Real.semiring
                  (@Pi.addCommGroup.{0, 0} (Fin n) (fun (x : Fin n) => Real) fun (i : Fin n) => Real.instAddCommGroup)
                  (@Pi.Function.module.{0, 0, 0} (Fin n) Real Real Real.semiring
                    (@Semiring.toAddCommMonoid.{0} Real (@Ring.toSemiring.{0} Real Real.instRing))
                    (@Semiring.toModule.{0} Real Real.semiring))))
              (NLA.KE04.Vec m) (fun (x : NLA.KE04.Vec m) => NLA.KE04.Vec n)
              (@LinearMap.instFunLike.{0, 0, 0, 0} Real Real (NLA.KE04.Vec m) (NLA.KE04.Vec n) Real.semiring
                Real.semiring
                (@AddCommGroup.toAddCommMonoid.{0} (NLA.KE04.Vec m)
