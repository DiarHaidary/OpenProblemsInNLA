theorem NLA.IE05._proved.scaled_tail_firstAvailable : ∀ {n : ℕ} (L T : NLA.IE05.Mat n) (d : Fin n → ℝ),
  NLA.IE05.UnitLower L →
    (∀ (i j : Fin n), j < i → |L i j| ≤ 1) →
      NLA.IE05.UpperTriangular T →
        (∀ (i : Fin n), 0 < T i i) →
          (∀ (j : Fin n), 0 < d j) →
            ∀ (k : Fin n), NLA.IE05.FirstAvailablePivot (NLA.IE05.scaledColumns (NLA.IE05.tailProduct L T ↑k) d) k k :=
fun {n} L T d hL hLb hT hTp hd k =>
  have hrow := NLA.IE05._proved.tailProduct_pivot_row L T hL k k le_rfl;
  have hpos := div_pos (hTp k) (Real.sqrt_pos.mpr (hd k));
  ⟨⟨le_rfl,
      ⟨id (Eq.mpr (id (congrArg (fun _a => _a / √(d k) ≠ 0) hrow)) (ne_of_gt hpos)), fun i hi =>
        have hl :=
          if hik : i = k then
            Eq.ndrec (motive := fun i => k ≤ i → |L i k| ≤ 1)
              (fun hi =>
                of_eq_true
                  (Eq.trans (congrFun' (congrArg LE.le (Eq.trans (congrArg abs (hL.left k)) abs_one)) 1)
                    (Std.le_refl._simp_1 1)))
              (Eq.symm hik) hi
          else hLb i k (lt_of_le_of_ne hi (Ne.symm hik));
        id
          (Eq.mpr
            (id
              (congrArg (fun _a => |_a / √(d k)| ≤ |NLA.IE05.tailProduct L T (↑k) k k / √(d k)|)
                (NLA.IE05._proved.tailProduct_pivot_column L T hT k i hi)))
            (Eq.mpr (id (congrArg (fun _a => |L i k * T k k / √(d k)| ≤ |_a / √(d k)|) hrow))
              (Eq.mpr (id (congrArg (fun _a => |_a| ≤ |T k k / √(d k)|) (mul_div_assoc (L i k) (T k k) √(d k))))
                (Eq.mpr (id (congrArg (fun _a => _a ≤ |T k k / √(d k)|) (abs_mul (L i k) (T k k / √(d k)))))
                  (Eq.mpr (id (congrArg (fun _a => |L i k| * _a ≤ _a) (abs_of_pos hpos)))
                    (Eq.mp (congrArg (LE.le (|L i k| * (T k k / √(d k)))) (one_mul (T k k / √(d k))))
                      (mul_le_mul_of_nonneg_right hl (LT.lt.le hpos))))))))⟩⟩,
    fun i hi a => hi⟩
theorem NLA.IE05._proved.scaled_noSwap_trajectory : ∀ {n : ℕ} (L T : NLA.IE05.Mat n) (d : Fin n → ℝ),
  NLA.IE05.UnitLower L →
    NLA.IE05.UpperTriangular T →
      (∀ (i : Fin n), 0 < T i i) →
        (∀ (j : Fin n), 0 < d j) →
          ∀ k ≤ n,
            NLA.IE05.trajectory (NLA.IE05.scaledColumns (L * T) d) (NLA.IE05.noSwapPath n) k =
              NLA.IE05.scaledColumns (NLA.IE05.tailProduct L T k) d :=
fun {n} L T d hL hT hTp hd k hk =>
  Nat.recAux (motive := fun k =>
    k ≤ n →
      NLA.IE05.trajectory (NLA.IE05.scaledColumns (L * T) d) (NLA.IE05.noSwapPath n) k =
        NLA.IE05.scaledColumns (NLA.IE05.tailProduct L T k) d)
    (fun hk =>
      of_eq_true
        (Eq.trans
          (congrArg (Eq (NLA.IE05.scaledColumns (L * T) d))
            (congrFun' (congrArg NLA.IE05.scaledColumns (NLA.IE05._proved.tailProduct_zero L T)) d))
          (eq_self (NLA.IE05.scaledColumns (L * T) d))))
    (fun k ih hk =>
      have hkn := Decidable.byContradiction fun a => NLA.IE05._proved.scaled_noSwap_trajectory._proof_1_1 k hk a;
      Eq.mpr
        (id
          (congrArg (fun _a => _a = NLA.IE05.scaledColumns (NLA.IE05.tailProduct L T (k + 1)) d)
            (NLA.IE05.trajectory.eq_2 (NLA.IE05.scaledColumns (L * T) d) (NLA.IE05.noSwapPath n) k)))
        (Eq.mpr
          (id (congrArg (fun _a => _a = NLA.IE05.scaledColumns (NLA.IE05.tailProduct L T (k + 1)) d) (dif_pos hkn)))
          (Eq.mpr
            (id
              (congrArg
                (fun _a =>
                  NLA.IE05.schurStep _a ⟨k, hkn⟩ (NLA.IE05.noSwapPath n ⟨k, hkn⟩) =
                    NLA.IE05.scaledColumns (NLA.IE05.tailProduct L T (k + 1)) d)
                (ih (Decidable.byContradiction fun a => NLA.IE05._proved.scaled_noSwap_trajectory._proof_1_2 k hk a))))
            (NLA.IE05._proved.scaled_tail_schur L T d hL hT hTp hd ⟨k, hkn⟩))))
    k hk
theorem NLA.IE05._proved.scaledLU_trajectory : ∀ {n : ℕ} (L T : NLA.IE05.Mat n) (d : Fin n → ℝ),
  NLA.IE05.UnitLower L →
    (∀ (i j : Fin n), j < i → |L i j| ≤ 1) →
      NLA.IE05.UpperTriangular T →
        (∀ (i : Fin n), 0 < T i i) →
          (∀ (j : Fin n), 0 < d j) →
            NLA.IE05.FirstAvailablePath (NLA.IE05.scaledColumns (L * T) d) (NLA.IE05.noSwapPath n) ∧
              NLA.IE05.firstPath (NLA.IE05.scaledColumns (L * T) d) = NLA.IE05.noSwapPath n ∧
                ∀ k ≤ n,
                  NLA.IE05.trajectory (NLA.IE05.scaledColumns (L * T) d) (NLA.IE05.noSwapPath n) k =
                    NLA.IE05.scaledColumns (NLA.IE05.tailProduct L T k) d :=
fun {n} L T d hL hLb hT hTp hd =>
  have htraj := NLA.IE05._proved.scaled_noSwap_trajectory L T d hL hT hTp hd;
  have hp := fun k =>
    Eq.mpr
      (id
        (congrArg (fun _a => NLA.IE05.FirstAvailablePivot _a k (NLA.IE05.noSwapPath n k))
          (htraj (↑k) (Nat.le_of_lt k.isLt))))
      (NLA.IE05._proved.scaled_tail_firstAvailable L T d hL hLb hT hTp hd k);
  ⟨hp,
    ⟨Eq.symm
        (NLA.IE05.firstPath_eq_of_firstAvailable_proved (NLA.IE05.scaledColumns (L * T) d) (NLA.IE05.noSwapPath n) hp),
      htraj⟩⟩
