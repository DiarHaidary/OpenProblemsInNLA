    polyDirectional x z (MvPolynomial.C r) = 0 := by
  simp [polyDirectional]

theorem polyDirectional_add {σ : Type*} [Fintype σ] (x z : σ → ℂ)
    (p q : MvPolynomial σ ℂ) :
