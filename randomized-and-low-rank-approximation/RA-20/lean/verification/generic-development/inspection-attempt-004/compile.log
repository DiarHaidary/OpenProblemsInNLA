                          (mul_assoc f (MvPolynomial.X 3) (MvPolynomial.X 4 * MvPolynomial.X 5))))
                      (map_mul (MvPolynomial.eval z) f (MvPolynomial.X 3 * (MvPolynomial.X 4 * MvPolynomial.X 5))))
                    (congrArg (HMul.hMul ((MvPolynomial.eval z) f))
                      (Eq.trans (map_mul (MvPolynomial.eval z) (MvPolynomial.X 3) (MvPolynomial.X 4 * MvPolynomial.X 5))
                        (congr (congrArg HMul.hMul (MvPolynomial.eval_X 3))
                          (Eq.trans (map_mul (MvPolynomial.eval z) (MvPolynomial.X 4) (MvPolynomial.X 5))
                            (congr (congrArg HMul.hMul (MvPolynomial.eval_X 4)) (MvPolynomial.eval_X 5))))))))
                0)
              hz);
