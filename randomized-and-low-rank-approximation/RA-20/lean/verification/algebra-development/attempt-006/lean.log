EXACT_FROZEN_TYPE NLA.RA20.hollow_variety_semantics_proved: (∀ (a b c : ℂ),
    (NLA.RA20.hollow a b c).det = 2 * a * b * c ∧ (NLA.RA20.hollow a b c ∈ NLA.RA20.variety 3 3 ↔ a * b * c = 0)) ∧
  ∀ (X : NLA.RA20.Mat 3),
    X ∈ NLA.RA20.variety 3 3 ↔ X = NLA.RA20.hollow (X 0 1) (X 0 2) (X 1 2) ∧ X 0 1 * X 0 2 * X 1 2 = 0
EXACT_FROZEN_TYPE NLA.RA20.reduced_coordinate_ring_proved: ∃ e,
  ∀ (i j : Fin 3),
    e ((Ideal.Quotient.mk (NLA.RA20.definingIdeal 3 3)) (MvPolynomial.X (i, j))) =
      (Ideal.Quotient.mk NLA.RA20.abcIdeal) (NLA.RA20.polynomialHollow i j)
