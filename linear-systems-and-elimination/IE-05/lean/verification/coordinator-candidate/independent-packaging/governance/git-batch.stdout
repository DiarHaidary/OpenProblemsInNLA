c1cc4d369d93f6efe64cb01e847e7874aafc74bd blob 5940
name: Lean verification

on:
  pull_request:
  push:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  select:
    runs-on: ubuntu-24.04
    outputs:
      matrix: ${{ steps.projects.outputs.matrix }}
      count: ${{ steps.projects.outputs.count }}
      tools_changed: ${{ steps.projects.outputs.tools_changed }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: Install metadata validators
        run: python3 -m pip install -r tools/lean/requirements.txt
      - name: Test project selection and metadata gates
        run: python3 -m unittest discover -s tests -p 'test_lean_verification.py' -v
      - name: Test pinned harness gates
        run: python3 -m unittest discover -s tools/lean -p 'test_*.py' -v
      - name: Select changed projects
        id: projects
        env:
          BASE_REF: ${{ github.event.pull_request.base.sha || github.event.before }}
          EVENT_NAME: ${{ github.event_name }}
        run: |
          if [ "$EVENT_NAME" = "workflow_dispatch" ] || [ -z "$BASE_REF" ] || [ "$BASE_REF" = "0000000000000000000000000000000000000000" ]; then
            python3 tools/lean/projects.py --all --github-output "$GITHUB_OUTPUT"
            echo "tools_changed=true" >> "$GITHUB_OUTPUT"
          else
            python3 tools/lean/projects.py --base-ref "$BASE_REF" --github-output "$GITHUB_OUTPUT"
            python3 - "$BASE_REF" "$GITHUB_OUTPUT" <<'PY'
          import pathlib, subprocess, sys
          changed = subprocess.check_output(['git','diff','--name-only','--no-renames','-z',sys.argv[1],'HEAD','--'], text=True).split('\0')
          needs_tools = any(p.startswith(('tools/lean/', 'docs/lean/ci-toolchain/')) or p == '.github/workflows/lean-verification.yml' for p in changed)
          with pathlib.Path(sys.argv[2]).open('a') as stream:
              stream.write('tools_changed=' + str(needs_tools).lower() + '\n')
          PY
          fi

  checker-controls:
    needs: select
    if: needs.select.outputs.tools_changed == 'true'
    runs-on: ubuntu-24.04
    timeout-minutes: 35
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16 # v6
        with:
          go-version: '1.27.1'
          cache: false
      - uses: leanprover/lean-action@96e06131c0e9943c780388fd166f55d1e2fa0433
        with:
          lake-package-directory: docs/lean/ci-toolchain
          auto-config: false
          build: false
          test: false
          lint: false
          use-mathlib-cache: false
          use-github-cache: false
      - name: Prepare unprivileged Linux isolation
        run: |
          sudo apt-get update
          sudo apt-get install -y bubblewrap dbus-user-session
          sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
          sudo loginctl enable-linger "$(id -un)"
          sudo systemctl start "user@$(id -u).service"
          echo "XDG_RUNTIME_DIR=/run/user/$(id -u)" >> "$GITHUB_ENV"
          echo "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus" >> "$GITHUB_ENV"
      - name: Build pinned checker and run rejection controls
        run: |
          ulimit -n 65536
          tools/lean/bootstrap.sh "$RUNNER_TEMP/nla-lean-tools"
          tools/lean/selftest.sh "$RUNNER_TEMP/nla-lean-tools"
      - name: Retain checker logs
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: lean-checker-controls
          path: ${{ runner.temp }}/nla-lean-tools/logs/
          if-no-files-found: warn

  verify:
    needs: select
    if: needs.select.outputs.count != '0'
    strategy:
      fail-fast: false
      matrix: ${{ fromJSON(needs.select.outputs.matrix) }}
    runs-on: ubuntu-24.04
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - name: Validate formalization manifest
        env:
          LEAN_PROJECT: ${{ matrix.project }}
        run: |
          python3 -m pip install -r tools/lean/requirements.txt
          python3 tools/lean/validate_manifest.py "$LEAN_PROJECT"
      - uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16 # v6
        with:
          go-version: '1.27.1'
          cache: false
      - uses: leanprover/lean-action@96e06131c0e9943c780388fd166f55d1e2fa0433
        with:
          lake-package-directory: ${{ matrix.project }}
          auto-config: false
          build: false
          test: false
          lint: false
          use-mathlib-cache: false
          use-github-cache: false
      - name: Prepare unprivileged Linux isolation
        run: |
          sudo apt-get update
          sudo apt-get install -y bubblewrap dbus-user-session
          sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
          sudo loginctl enable-linger "$(id -un)"
          sudo systemctl start "user@$(id -u).service"
          echo "XDG_RUNTIME_DIR=/run/user/$(id -u)" >> "$GITHUB_ENV"
          echo "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus" >> "$GITHUB_ENV"
      - name: Fresh sandboxed statement, axiom and kernel verification
        env:
          LEAN_PROJECT: ${{ matrix.project }}
        run: |
          ulimit -n 65536
          tools/lean/bootstrap.sh "$RUNNER_TEMP/nla-lean-tools"
          tools/lean/verify.sh "$LEAN_PROJECT" "$RUNNER_TEMP/nla-lean-tools"
      - name: Retain verification logs
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: lean-${{ matrix.id }}
          path: ${{ runner.temp }}/nla-lean-tools/logs/
          if-no-files-found: warn

