def NLA.RA20.fullFrobeniusDistance : {n : Nat} → (U X : NLA.RA20.Mat n) → Complex :=
fun {n : Nat} (U X : NLA.RA20.Mat n) =>
  @Finset.sum.{0, 0} (Fin n) Complex Complex.instAddCommMonoid (@Finset.univ.{0} (Fin n) (Fin.fintype n))
    fun (i : Fin n) =>
    @Finset.sum.{0, 0} (Fin n) Complex Complex.instAddCommMonoid (@Finset.univ.{0} (Fin n) (Fin.fintype n))
      fun (j : Fin n) =>
      @HPow.hPow.{0, 0, 0} Complex Nat Complex
        (@instHPow.{0, 0} Complex Nat
          (@NPow.toPow.{0} Complex (@Monoid.toNPow.{0} Complex (@Semiring.toMonoid.{0} Complex Complex.instSemiring))))
        (@HSub.hSub.{0, 0, 0} Complex Complex Complex (@instHSub.{0} Complex Complex.instSub) (X i j) (U i j))
        (@OfNat.ofNat.{0} Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))
