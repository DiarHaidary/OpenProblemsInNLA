  (Ideal.quotientEquivAlgOfEq ℂ hollowQuotientMap_ker.symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective hollowQuotientMap_surjective)

theorem reducedCoordinateEquiv_mk_X (i j : Fin 3) :
    reducedCoordinateEquiv
