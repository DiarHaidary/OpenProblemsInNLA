EXACT_EXPECTED_TYPE NLA.IE05._proved.integer_factor_certificates: ∀ (b : Bool),
  Matrix.transpose (NLA.IE05.integerH b) * NLA.IE05.integerH b = Matrix.diagonal (NLA.IE05.integerD b) ∧
    NLA.IE05.integerH b = NLA.IE05.integerLower b * NLA.IE05.integerT b ∧
      NLA.IE05.UnitLower (NLA.IE05.integerLower b) ∧
        NLA.IE05.UpperTriangular (NLA.IE05.integerT b) ∧
          (∀ (i j : Fin 8), j < i → |NLA.IE05.integerLower b i j| ≤ 1) ∧
            (∀ (i : Fin 8), 0 < NLA.IE05.integerT b i i) ∧ ∀ (j : Fin 8), 0 < NLA.IE05.integerD b j
EXACT_EXPECTED_TYPE NLA.IE05._proved.integer_entry_certificates: (∀ (i j : Fin 8),
    5272 * NLA.IE05.integerH true i j ^ 2 ≤ 3969 * NLA.IE05.integerD true j) ∧
  NLA.IE05.integerD true 7 = 5272 ∧
    NLA.IE05.integerH false 2 2 = 51 ∧
      NLA.IE05.integerD false 2 = 3286 ∧
        (∀ (k i j : Fin 8),
            k ≤ i →
              k ≤ j →
                NLA.IE05.tailProduct (NLA.IE05.integerLower false) (NLA.IE05.integerT false) (↑k) i j ^ 2 ≤
                  5462 * NLA.IE05.integerD false j) ∧
          NLA.IE05.tailProduct (NLA.IE05.integerLower true) (NLA.IE05.integerT true) 7 7 7 = 5272
EXACT_EXPECTED_TYPE NLA.IE05._proved.numerical_gap_positive: (5272 / 63) ^ 2 - 17948132 / 2601 = 117335164 / 1147041 ∧
  0 < 117335164 / 1147041
EXACT_EXPECTED_TYPE NLA.IE05._proved.normalizedQRQ_of_gram_lu: ∀ {n : ℕ} (L H T : NLA.IE05.Mat n) (d : Fin n → ℝ),
  (∀ (j : Fin n), 0 < d j) →
    Matrix.transpose H * H = Matrix.diagonal d →
      H = L * T →
        NLA.IE05.UpperTriangular T → (∀ (i : Fin n), 0 < T i i) → NLA.IE05.normalizedQRQ L = NLA.IE05.scaledColumns H d
