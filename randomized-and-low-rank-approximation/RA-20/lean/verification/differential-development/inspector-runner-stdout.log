theorem NLA.RA20.full_frobenius_differential_proved : ∀ (n : ℕ) (U X Z : NLA.RA20.Mat n),
  (fderiv ℂ (NLA.RA20.fullFrobeniusDistance U) X) Z = 2 * ∑ i, ∑ j, (X i j - U i j) * Z i j :=
fun n U X Z =>
  have he :=
    funext fun Y =>
      of_eq_true
        (Eq.trans
          (congrArg (Eq (∑ i, ∑ j, (Y i j - U i j) ^ 2))
            (Eq.trans (Fintype.sum_prod_type fun x => (Y x.1 x.2 - U x.1 x.2) ^ 2)
              (Finset.sum_congr (Eq.refl Finset.univ) fun x a =>
                Finset.sum_congr (Eq.refl Finset.univ) fun x_1 a => Eq.refl ((Y x x_1 - U x x_1) ^ 2))))
          (eq_self (∑ i, ∑ j, (Y i j - U i j) ^ 2)));
  Eq.mpr (id (congrArg (fun _a => (fderiv ℂ _a X) Z = 2 * ∑ i, ∑ j, (X i j - U i j) * Z i j) he))
    (have ht := NLA.RA20.sum_squares_fderiv (NLA.RA20.matrixEntry n) (NLA.RA20.coordinates U) X Z;
    Eq.mpr
      (id
        (congrFun'
          (congrArg Eq
            (congrFun'
              (congrArg DFunLike.coe
                (congrFun'
                  (congrArg (fderiv ℂ)
                    (funext fun Y =>
                      Eq.trans (Fintype.sum_prod_type fun x => (Y x.1 x.2 - U x.1 x.2) ^ 2)
                        (Finset.sum_congr (Eq.refl Finset.univ) fun x a =>
                          Finset.sum_congr (Eq.refl Finset.univ) fun x_1 a => Eq.refl ((Y x x_1 - U x x_1) ^ 2))))
                  X))
              Z))
          (2 * ∑ i, ∑ j, (X i j - U i j) * Z i j)))
      (Eq.mp
        (congr
          (congrArg Eq
            (congrFun'
              (congrArg DFunLike.coe
                (congrFun'
                  (congrArg (fderiv ℂ)
                    (funext fun y =>
                      Eq.trans (Fintype.sum_prod_type fun x => (y x.1 x.2 - U x.1 x.2) ^ 2)
                        (Finset.sum_congr (Eq.refl Finset.univ) fun x a =>
                          Finset.sum_congr (Eq.refl Finset.univ) fun x_1 a => Eq.refl ((y x x_1 - U x x_1) ^ 2))))
                  X))
              Z))
          (congrArg (HMul.hMul 2)
            (Eq.trans (Fintype.sum_prod_type fun x => (X x.1 x.2 - U x.1 x.2) * Z x.1 x.2)
              (Finset.sum_congr (Eq.refl Finset.univ) fun x a =>
                Finset.sum_congr (Eq.refl Finset.univ) fun x_1 a => Eq.refl ((X x x_1 - U x x_1) * Z x x_1)))))
        ht))
theorem NLA.RA20.component_hessians_proved : ∀ (U : NLA.RA20.Mat 3) (i : Fin 3) (z h v : Fin 2 → ℂ),
  ((fderiv ℂ (fun w => fderiv ℂ (fun y => NLA.RA20.fullFrobeniusDistance U (NLA.RA20.planeCoordinates i y)) w) z) h) v =
      4 * ∑ j, h j * v j ∧
    ((∀ (v : Fin 2 → ℂ), 4 * ∑ j, h j * v j = 0) → h = 0) :=
fun U i z h v =>
  ⟨have he :=
      funext fun y =>
        of_eq_true
          (Eq.trans
            (congrArg (Eq (∑ i_1, ∑ j, (NLA.RA20.planeCoordinates i y i_1 j - U i_1 j) ^ 2))
              (Eq.trans
                (Eq.trans
                  (Finset.sum_congr (Eq.refl Finset.univ) fun x a =>
                    congrFun'
                      (congrArg HPow.hPow
                        (congrFun' (congrArg HSub.hSub (NLA.RA20.planeEntry_apply i x.1 x.2 y)) (U x.1 x.2)))
                      2)
                  (Fintype.sum_prod_type fun x => (NLA.RA20.planeCoordinates i y x.1 x.2 - U x.1 x.2) ^ 2))
                (Finset.sum_congr (Eq.refl Finset.univ) fun x a =>
                  Finset.sum_congr (Eq.refl Finset.univ) fun x_1 a =>
                    Eq.refl ((NLA.RA20.planeCoordinates i y x x_1 - U x x_1) ^ 2))))
            (eq_self (∑ i_1, ∑ j, (NLA.RA20.planeCoordinates i y i_1 j - U i_1 j) ^ 2)));
    Eq.mpr (id (congrArg (fun _a => ((fderiv ℂ (fun w => fderiv ℂ _a w) z) h) v = 4 * ∑ j, h j * v j) he))
      (Eq.mpr
        (id
          (congrArg (fun _a => _a = 4 * ∑ j, h j * v j)
            (NLA.RA20.sum_squares_hessian (fun rc => NLA.RA20.planeEntry i rc.1 rc.2) (NLA.RA20.coordinates U) z h v)))
        (Eq.mpr
          (id
            (congrFun'
              (congrArg Eq
                (congrArg (HMul.hMul 2)
                  (Eq.trans
                    (Eq.trans
                      (Finset.sum_congr (Eq.refl Finset.univ) fun x a =>
                        congr (congrArg HMul.hMul (NLA.RA20.planeEntry_apply i x.1 x.2 h))
                          (NLA.RA20.planeEntry_apply i x.1 x.2 v))
                      (Fintype.sum_prod_type fun x =>
                        NLA.RA20.planeCoordinates i h x.1 x.2 * NLA.RA20.planeCoordinates i v x.1 x.2))
                    (Finset.sum_congr (Eq.refl Finset.univ) fun x a =>
                      Finset.sum_congr (Eq.refl Finset.univ) fun x_1 a =>
                        Eq.refl (NLA.RA20.planeCoordinates i h x x_1 * NLA.RA20.planeCoordinates i v x x_1)))))
              (4 * ∑ j, h j * v j)))
          (List.Mem.casesOn (motive := fun a x =>
            List.finRange 3 = a →
              Fintype.complete i ≍ x →
                2 * ∑ x, ∑ x_1, NLA.RA20.planeCoordinates i h x x_1 * NLA.RA20.planeCoordinates i v x x_1 =
                  4 * ∑ j, h j * v j)
            (Fintype.complete i)
            (fun as h_1 =>
              List.cons.noConfusion h_1 fun head_eq =>
                Eq.ndrec (motive := fun i =>
                  ((fun y => NLA.RA20.fullFrobeniusDistance U (NLA.RA20.planeCoordinates i y)) = fun y =>
                      ∑ rc, ((NLA.RA20.planeEntry i rc.1 rc.2) y - NLA.RA20.coordinates U rc) ^ 2) →
                    ∀ (this : i ∈ Fintype.elems),
                      (fun x1 x2 => (fun i => i) x1 :: x2) ⟨1, Nat.le_of_lt (Nat.le_refl 3)⟩
                            ((fun x1 x2 => (fun i => i) x1 :: x2) ⟨2, Nat.le_refl 3⟩ []) ≍
                          as →
                        this ≍ List.Mem.head as →
                          2 * ∑ x, ∑ x_1, NLA.RA20.planeCoordinates i h x x_1 * NLA.RA20.planeCoordinates i v x x_1 =
                            4 * ∑ j, h j * v j)
                  (fun he this tail_eq =>
                    Eq.ndrec (motive := fun as =>
                      this ≍ List.Mem.head as →
                        2 *
                            ∑ x,
                              ∑ x_1,
                                NLA.RA20.planeCoordinates
                                    ((fun i => i) ⟨0, Nat.le_of_lt (Nat.le_of_lt (Nat.le_refl 3))⟩) h x x_1 *
                                  NLA.RA20.planeCoordinates
                                    ((fun i => i) ⟨0, Nat.le_of_lt (Nat.le_of_lt (Nat.le_refl 3))⟩) v x x_1 =
                          4 * ∑ j, h j * v j)
                      (fun h_2 =>
                        Eq.mpr
                          (id
                            (congr
                              (congrArg Eq
                                (congrArg (HMul.hMul 2)
                                  (Eq.trans
                                    (Eq.trans
                                      (Finset.sum_congr (Eq.refl Finset.univ) fun x a =>
                                        Eq.trans
                                          (Eq.trans
                                            (Finset.sum_congr (Eq.refl Finset.univ) fun x_1 a =>
                                              congr
                                                (congrArg HMul.hMul
                                                  (Eq.trans
                                                    (congrArg (fun x_2 => x_2 x x_1)
                                                      (ite_cond_eq_true (NLA.RA20.hollow 0 (h 0) (h 1))
                                                        (if
                                                            (fun i => i)
                                                                ⟨0, Nat.le_of_lt (Nat.le_of_lt (Nat.le_refl 3))⟩ =
                                                              1 then
                                                          NLA.RA20.hollow (h 0) 0 (h 1)
                                                        else NLA.RA20.hollow (h 0) (h 1) 0)
                                                        (eq_self 0)))
                                                    (Eq.trans
                                                      (Matrix.cons_val' ![0, 0, h 0] ![![0, 0, h 1], ![h 0, h 1, 0]] x
                                                        x_1)
                                                      (congrFun'
                                                        (congrArg (Matrix.vecCons (![0, 0, h 0] x_1))
                                                          (funext fun i =>
                                                            Eq.trans
                                                              (Matrix.cons_val' ![0, 0, h 1] ![![h 0, h 1, 0]] i x_1)
                                                              (congrFun'
                                                                (congrArg (Matrix.vecCons (![0, 0, h 1] x_1))
                                                                  (funext fun i =>
                                                                    Eq.trans (Matrix.cons_val' ![h 0, h 1, 0] ![] i x_1)
                                                                      (Matrix.cons_val_fin_one (![h 0, h 1, 0] x_1)
                                                                        (fun i => ![] i x_1) i)))
                                                                i)))
                                                        x))))
                                                (Eq.trans
                                                  (congrArg (fun x_2 => x_2 x x_1)
                                                    (ite_cond_eq_true (NLA.RA20.hollow 0 (v 0) (v 1))
                                                      (if
                                                          (fun i => i)
                                                              ⟨0, Nat.le_of_lt (Nat.le_of_lt (Nat.le_refl 3))⟩ =
                                                            1 then
                                                        NLA.RA20.hollow (v 0) 0 (v 1)
