def InnerProductSpace.gramSchmidtNormed.{u_1, u_2, u_3} : (𝕜 : Type u_1) →
  {E : Type u_2} →
    [inst : RCLike 𝕜] →
      [inst_1 : NormedAddCommGroup E] →
        [InnerProductSpace 𝕜 E] →
          {ι : Type u_3} → [inst : LinearOrder ι] → [LocallyFiniteOrderBot ι] → [WellFoundedLT ι] → (ι → E) → ι → E :=
fun 𝕜 {E} [RCLike 𝕜] [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] {ι} [LinearOrder ι] [LocallyFiniteOrderBot ι]
    [WellFoundedLT ι] f n =>
  (↑‖InnerProductSpace.gramSchmidt 𝕜 f n‖)⁻¹ • InnerProductSpace.gramSchmidt 𝕜 f n
InnerProductSpace.gramSchmidtNormed_orthonormal.{u_1, u_2, u_3} {𝕜 : Type u_1} {E : Type u_2} [RCLike 𝕜]
  [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] {ι : Type u_3} [LinearOrder ι] [LocallyFiniteOrderBot ι]
