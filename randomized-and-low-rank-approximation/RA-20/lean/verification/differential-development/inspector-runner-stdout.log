                                                        (funext fun i =>
                                                          congrFun'
                                                            (congr
                                                              (congrArg Matrix.vecCons
                                                                (Matrix.cons_val_succ 0 ![0, v 1] x_1))
                                                              (funext fun i =>
                                                                Matrix.cons_val_succ (v 0) ![v 1, 0] x_1))
