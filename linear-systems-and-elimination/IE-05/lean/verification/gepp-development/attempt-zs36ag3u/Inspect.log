theorem NLA.IE05.gepp_growth_bound_proved : ∀ {n : ℕ},
  1 ≤ n →
    ∀ (A : NLA.IE05.Mat n) (path : NLA.IE05.PivotPath n),
      NLA.IE05.AdmissiblePath A path →
        0 < NLA.IE05.entryMax A ∧ 1 ≤ NLA.IE05.growth A path ∧ NLA.IE05.growth A path ≤ 2 ^ (n - 1) :=
fun {n} hn A path hp =>
  let z := ⟨0, Decidable.byContradiction fun a => NLA.IE05.gepp_growth_bound_proved._proof_1_1 hn a⟩;
  have hz := id (hp z).right.left;
  have hE := lt_of_lt_of_le (abs_pos.mpr hz) (NLA.IE05.abs_le_entryMax_proved A (path z) z);
  have hpeak :=
    NLA.IE05.peakMax_le_proved A path (2 ^ (n - 1) * NLA.IE05.entryMax A)
      (mul_nonneg
        (le_of_lt
          (pow_pos
            (Mathlib.Meta.Positivity.pos_of_isNat (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 2))
              (Eq.refl (Nat.ble 1 2)))
            (n - 1)))
        (LT.lt.le hE))
      fun k =>
      LE.le.trans (NLA.IE05.gepp_stage_bound_proved A path hp (↑k) k.isLt)
        (mul_le_mul_of_nonneg_right
          (pow_le_pow_right₀
            (Mathlib.Meta.NormNum.isNat_le_true (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_one)
              (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 2)) (Eq.refl true))
            (Decidable.byContradiction fun a => NLA.IE05.gepp_growth_bound_proved._proof_1_2 hn k a))
          (LT.lt.le hE));
  ⟨hE,
    ⟨id
        ((le_div_iff₀ hE).mpr
          (Eq.mpr (id (congrFun' (congrArg LE.le (one_mul (NLA.IE05.entryMax A))) (NLA.IE05.peakMax A path)))
            (NLA.IE05.entryMax_le_peakMax_proved hn A path))),
      id ((div_le_iff₀ hE).mpr hpeak)⟩⟩
theorem NLA.IE05.firstPath_semantics_proved : ∀ {n : ℕ} (A : NLA.IE05.Mat n),
  Matrix.det A ≠ 0 →
    NLA.IE05.FirstAvailablePath A (NLA.IE05.firstPath A) ∧
      (∀ (k : ℕ), NLA.IE05.trajectory A (NLA.IE05.firstPath A) k = NLA.IE05.firstTrajectory A k) ∧
        ∀ (path : NLA.IE05.PivotPath n), NLA.IE05.FirstAvailablePath A path → path = NLA.IE05.firstPath A :=
fun {n} A hA =>
  ⟨fun k =>
    have hp :=
      NLA.IE05.firstPivotIndex_firstAvailable_proved (NLA.IE05.firstTrajectory A ↑k) k
        (NLA.IE05.activeInjective_nonzero_column_proved (NLA.IE05.firstTrajectory A ↑k) k
          (NLA.IE05.firstTrajectory_activeInjective_proved A hA (↑k) (Nat.le_of_lt k.isLt)));
    Eq.mpr
      (id
        (congrFun' (congrFun' (congrArg NLA.IE05.FirstAvailablePivot (NLA.IE05.trajectory_firstPath_eq_proved A ↑k)) k)
          (NLA.IE05.firstPivotIndex (NLA.IE05.firstTrajectory A ↑k) k)))
      hp,
    ⟨NLA.IE05.trajectory_firstPath_eq_proved A, NLA.IE05.firstPath_eq_of_firstAvailable_proved A⟩⟩
theorem NLA.IE05.orthogonalGrowthSet_bounded_proved : ∀ (n : ℕ),
  2 ≤ n →
    (NLA.IE05.orthogonalGrowthSet n).Nonempty ∧
      BddAbove (NLA.IE05.orthogonalGrowthSet n) ∧ ∀ r ∈ NLA.IE05.orthogonalGrowthSet n, 1 ≤ r ∧ r ≤ 2 ^ (n - 1) :=
fun n hn =>
  have hbounds := fun r a =>
    Exists.casesOn a fun A h =>
      And.casesOn h fun left right =>
        Exists.casesOn right fun path h =>
          And.casesOn h fun hp right =>
            Eq.symm right ▸
              (NLA.IE05.gepp_growth_bound_proved
                  (Decidable.byContradiction fun a => NLA.IE05.orthogonalGrowthSet_bounded_proved._proof_1_1 n hn a) A
                  path hp).right;
  ⟨have hp :=
      (NLA.IE05.firstPath_semantics_proved 1
          (of_eq_true
            (Eq.trans (congrFun' (congrArg Ne Matrix.det_one) 0)
              (Eq.trans (congrArg Not one_ne_zero._simp_1) not_false_eq_true)))).left;
    Exists.intro (NLA.IE05.growth 1 (NLA.IE05.firstPath 1))
      (Exists.intro 1
        ⟨of_eq_true
            (Eq.trans
              (congrFun' (congrArg Eq (Eq.trans (congrFun' (congrArg HMul.hMul Matrix.transpose_one) 1) (mul_one 1))) 1)
              (eq_self 1)),
          Exists.intro (NLA.IE05.firstPath 1) ⟨fun k => (hp k).left, rfl⟩⟩),
    ⟨Exists.intro (2 ^ (n - 1)) fun r hr => (hbounds r hr).right, hbounds⟩⟩
