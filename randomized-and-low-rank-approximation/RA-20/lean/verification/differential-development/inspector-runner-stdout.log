                                (Mathlib.Meta.NormNum.isInt_add (Eq.refl HAdd.hAdd)
                                  (Mathlib.Meta.NormNum.IsInt.of_raw ℂ (Int.negOfNat 1))
                                  (Mathlib.Meta.NormNum.IsInt.of_raw ℂ (Int.negOfNat 1)) (Eq.refl (Int.negOfNat 2))))))
                          (Mathlib.Tactic.Ring.Common.add_pf_zero_add 0)))))))
        x))
