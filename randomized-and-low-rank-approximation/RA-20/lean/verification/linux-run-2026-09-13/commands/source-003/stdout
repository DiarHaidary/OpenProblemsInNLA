theorem abcPolynomial_squarefree : Squarefree abcPolynomial := by
  have hp (i : Fin 3) : Prime (MvPolynomial.X i : ABCPoly) := MvPolynomial.X_prime
  have hrel (i j : Fin 3) (hij : i ≠ j) :
