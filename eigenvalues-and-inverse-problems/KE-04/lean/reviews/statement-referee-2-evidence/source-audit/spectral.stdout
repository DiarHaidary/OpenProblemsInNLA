378:theorem eigenvalues_eq_eigenvalues_iff {E' : Type*} [NormedAddCommGroup E'] [InnerProductSpace 𝕜 E']
379-    [FiniteDimensional 𝕜 E'] {T' : E' →ₗ[𝕜] E'} (hT : T.IsSymmetric) (hn : Module.finrank 𝕜 E = n)
380-    (hT' : T'.IsSymmetric) (hn' : Module.finrank 𝕜 E' = n) :
381-    hT.eigenvalues hn = hT'.eigenvalues hn' ↔ T.charpoly = T'.charpoly where
382-  mp h := by rw [hT.charpoly_eq hn, hT'.charpoly_eq hn', h]
383-  mpr h := by
384:    rw [← List.ofFn_inj, ← sort_roots_charpoly_eq_eigenvalues, ← sort_roots_charpoly_eq_eigenvalues,
385-      h]
