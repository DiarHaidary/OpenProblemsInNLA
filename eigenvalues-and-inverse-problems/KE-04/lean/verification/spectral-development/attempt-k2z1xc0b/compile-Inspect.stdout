theorem NLA.KE04._proved.orderedSpectrum_semantics : ∀ {m : ℕ} (M : NLA.KE04.Mat m) (hM : Matrix.IsHermitian M),
  Monotone (NLA.KE04.orderedEigenvalues M hM) ∧
    (∀ (r : Fin m),
        (NLA.KE04.act M) ((NLA.KE04.orderedEigenbasis M hM) r) =
          NLA.KE04.orderedEigenvalues M hM r • (NLA.KE04.orderedEigenbasis M hM) r) ∧
      (Matrix.charpoly M).roots = Multiset.map (NLA.KE04.orderedEigenvalues M hM) Finset.univ.val ∧
        ∀ (i : ℕ) (hi : i < m), NLA.KE04.eigenvalueAt M hM i = NLA.KE04.orderedEigenvalues M hM ⟨i, hi⟩ :=
fun {m} M hM =>
  let hT := Matrix.isSymmetric_toEuclideanLin_iff.mpr hM;
  ⟨fun ⦃i j⦄ hij => LinearMap.IsSymmetric.eigenvalues_antitone hT finrank_euclideanSpace_fin (Fin.rev_le_rev.mpr hij),
    ⟨fun r =>
      of_eq_true
        (Eq.trans
          (congr
            (congrArg Eq
              (Eq.trans
                (congrArg (⇑(Matrix.toEuclideanLin M))
                  (Eq.trans
                    (congrFun
                      (OrthonormalBasis.coe_reindex
                        ((NLA.KE04.orderedEigenvalues._proof_2 M hM).eigenvectorBasis finrank_euclideanSpace_fin)
                        Fin.revPerm)
                      r)
                    (congrArg
                      (⇑((NLA.KE04.orderedEigenvalues._proof_2 M hM).eigenvectorBasis finrank_euclideanSpace_fin))
                      (Fin.revPerm_apply r))))
                (LinearMap.IsSymmetric.apply_eigenvectorBasis (NLA.KE04.orderedEigenvalues._proof_2 M hM)
                  finrank_euclideanSpace_fin r.rev)))
            (congrArg
              (HSMul.hSMul ((NLA.KE04.orderedEigenvalues._proof_2 M hM).eigenvalues finrank_euclideanSpace_fin r.rev))
              (Eq.trans
                (congrFun
                  (OrthonormalBasis.coe_reindex
                    ((NLA.KE04.orderedEigenvalues._proof_2 M hM).eigenvectorBasis finrank_euclideanSpace_fin)
                    Fin.revPerm)
