    · rw [reducedPoint_comap, hm]
    · apply (smoothLocus_comap_algEquiv reducedCoordinateEquiv (abcPoint x hz)).mpr
      exact (abc_smooth_locus_iff (abcPoint x hz) x (abcPoint_comap x hz)).mpr hone

