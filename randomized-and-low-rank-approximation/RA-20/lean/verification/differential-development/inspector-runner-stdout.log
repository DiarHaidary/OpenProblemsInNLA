theorem NLA.RA20.sum_squares_hessian.{u_1, u_2} : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℂ E] {ι : Type u_2} [inst_2 : Fintype ι] (L : ι → E →L[ℂ] ℂ) (a : ι → ℂ) (x h v : E),
  ((fderiv ℂ (fun w => fderiv ℂ (fun y => ∑ j, ((L j) y - a j) ^ 2) w) x) h) v = 2 * ∑ j, (L j) h * (L j) v :=
fun {E} [NormedAddCommGroup E] [NormedSpace ℂ E] {ι} [Fintype ι] L a x h v =>
  have he := funext fun w => HasFDerivAt.fderiv (NLA.RA20.hasFDerivAt_sum_squares L a w);
  Eq.mpr (id (congrArg (fun _a => ((fderiv ℂ _a x) h) v = 2 * ∑ j, (L j) h * (L j) v) he))
    (Eq.mpr
      (id
        (congrArg (fun _a => (_a h) v = 2 * ∑ j, (L j) h * (L j) v)
          (HasFDerivAt.fderiv (NLA.RA20.hasFDerivAt_quadraticGradient L a x))))
