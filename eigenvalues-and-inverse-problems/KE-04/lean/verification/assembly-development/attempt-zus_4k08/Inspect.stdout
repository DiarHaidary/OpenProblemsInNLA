'NLA.KE04.real_matrix_semantics' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.krylov_range_semantics' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.krylov_nesting_and_shift' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.fullBlockDimension_iff_independent' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.fullBlockDimension_prefix' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.lastFullBlockIteration_exists' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.krylovBasis_exists' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.frameProjection_semantics' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.compression_semantics' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.orderedSpectrum_semantics' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.compression_basis_independent' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.interval_index_validity' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.quadratic_semantics' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.spectral_gap_quadratic_psd' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.spectral_window_subspace' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.krylov_intersection_nonzero' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.psd_zero_form_iff_kernel' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.compressedQuadratic_semantics' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.quadratic_forms_agree' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.later_quadratic_identity' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.fullRank_quadratic_nonannihilation' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.strictIntervalOccupancy' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.fullPrefix_implies_canonical' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLA.KE04.blockLanczosConjecture' depends on axioms: [propext, Classical.choice, Quot.sound]
EXACT_CONTRACT NLA.KE04.real_matrix_semantics: ∀ {n m : ℕ} (A : Mat n) (M : Rect n m),
  (Matrix.IsHermitian A ↔ Matrix.transpose A = A) ∧
    (∀ (x : Vec m) (i : Fin n), ((act M) x).ofLp i = ∑ j, M i j * x.ofLp j) ∧
      (Matrix.transpose M * M = 1 ↔ Orthonormal ℝ (column M))
EXACT_CONTRACT NLA.KE04.krylov_range_semantics: ∀ {n p : ℕ} (A : Mat n) (V : Rect n p) (ell : ℕ),
  krylov A V ell = (krylovCombination A V ell).range ∧
    (∀ (x : Vec n), x ∈ krylov A V ell ↔ ∃ c, x = ∑ rc, c rc • column (A ^ ↑rc.1 * V) rc.2) ∧
      Module.finrank ℝ ↥(krylov A V ell) ≤ ell * p
EXACT_CONTRACT NLA.KE04.krylov_nesting_and_shift: ∀ {n p : ℕ} (A : Mat n) (V : Rect n p),
  krylov A V 0 = ⊥ ∧ Monotone (krylov A V) ∧ ∀ (ell : ℕ), ∀ x ∈ krylov A V ell, (act A) x ∈ krylov A V (ell + 1)
EXACT_CONTRACT NLA.KE04.fullBlockDimension_iff_independent: ∀ {n p : ℕ} (A : Mat n) (V : Rect n p) (ell : ℕ),
  (FullBlockDimension A V ell ↔ LinearIndependent ℝ (krylovColumns A V ell)) ∧
    (FullColumnRank V ↔ FullBlockDimension A V 1)
EXACT_CONTRACT NLA.KE04.fullBlockDimension_prefix: ∀ {n p : ℕ} (A : Mat n) (V : Rect n p) (s : ℕ),
  FullBlockDimension A V s → ∀ ell ≤ s, FullBlockDimension A V ell ∧ Function.Injective ⇑(krylovCombination A V ell)
EXACT_CONTRACT NLA.KE04.lastFullBlockIteration_exists: ∀ {n p : ℕ},
  0 < p → ∀ (A : Mat n) (V : Rect n p), FullColumnRank V → ∃ s, 1 ≤ s ∧ LastFullBlockIteration A V s
EXACT_CONTRACT NLA.KE04.krylovBasis_exists: ∀ {n p : ℕ} (A : Mat n) (V : Rect n p) (ell : ℕ),
  FullBlockDimension A V ell → ∃ Q, IsKrylovBasis A V ell Q
EXACT_CONTRACT NLA.KE04.frameProjection_semantics: ∀ {n m : ℕ} (Q : Rect n m),
  Matrix.transpose Q * Q = 1 →
    Matrix.IsHermitian (frameProjection Q) ∧
      frameProjection Q * frameProjection Q = frameProjection Q ∧
        (∀ (x : Vec n), x ∈ columnSpace Q ↔ (act (frameProjection Q)) x = x) ∧
          ∀ (x y : Vec n), y ∈ columnSpace Q → inner ℝ y (x - (act (frameProjection Q)) x) = 0
EXACT_CONTRACT NLA.KE04.compression_semantics: ∀ {n m : ℕ} (A : Mat n),
  Matrix.IsHermitian A →
    ∀ (Q : Rect n m),
      Matrix.transpose Q * Q = 1 →
        compression A Q = Matrix.transpose Q * A * Q ∧
          Matrix.IsHermitian (compression A Q) ∧
            ∀ x ∈ columnSpace Q,
              (act Q) ((act (compression A Q)) ((act (Matrix.transpose Q)) x)) = (act (frameProjection Q)) ((act A) x)
EXACT_CONTRACT NLA.KE04.orderedSpectrum_semantics: ∀ {m : ℕ} (M : Mat m) (hM : Matrix.IsHermitian M),
  Monotone (orderedEigenvalues M hM) ∧
    (∀ (r : Fin m), (act M) ((orderedEigenbasis M hM) r) = orderedEigenvalues M hM r • (orderedEigenbasis M hM) r) ∧
      (Matrix.charpoly M).roots = Multiset.map (orderedEigenvalues M hM) Finset.univ.val ∧
        ∀ (i : ℕ) (hi : i < m), eigenvalueAt M hM i = orderedEigenvalues M hM ⟨i, hi⟩
EXACT_CONTRACT NLA.KE04.compression_basis_independent: ∀ {n m : ℕ} (A : Mat n) (hA : Matrix.IsHermitian A)
  (Q R : Rect n m),
  Matrix.transpose Q * Q = 1 →
    Matrix.transpose R * R = 1 →
      columnSpace Q = columnSpace R →
        (∃ O, Matrix.transpose O * O = 1 ∧ R = Q * O ∧ compression A R = Matrix.transpose O * compression A Q * O) ∧
          Matrix.charpoly (compression A Q) = Matrix.charpoly (compression A R) ∧ ritzValues A hA Q = ritzValues A hA R
EXACT_CONTRACT NLA.KE04.interval_index_validity: ∀ (k p i : ℕ),
  1 ≤ k → 1 ≤ i → i ≤ (k - 1) * p → 2 ≤ k ∧ 0 < p ∧ i - 1 < k * p ∧ i + p - 1 < k * p
EXACT_CONTRACT NLA.KE04.quadratic_semantics: ∀ {m : ℕ} (M : Mat m) (a b : ℝ),
  (monicQuadratic a b).Monic ∧
    (monicQuadratic a b).natDegree = 2 ∧
      quadraticMatrix M a b = (Polynomial.aeval M) (monicQuadratic a b) ∧
        quadraticMatrix M a b = M ^ 2 - (a + b) • M + (a * b) • 1
EXACT_CONTRACT NLA.KE04.spectral_gap_quadratic_psd: ∀ {m : ℕ} (M : Mat m) (hM : Matrix.IsHermitian M) (a b : ℝ),
  a ≤ b →
    (∀ (r : Fin m), ¬(a < orderedEigenvalues M hM r ∧ orderedEigenvalues M hM r < b)) →
      Matrix.PosSemidef (quadraticMatrix M a b)
EXACT_CONTRACT NLA.KE04.spectral_window_subspace: ∀ {n m : ℕ} (A : Mat n) (hA : Matrix.IsHermitian A) (Q : Rect n m),
  Matrix.transpose Q * Q = 1 →
    ∀ (i p : ℕ),
      i + p < m →
        ∃ E ≤ columnSpace Q,
          Module.finrank ℝ ↥E = p + 1 ∧
            ∀ x ∈ E, form (compressedQuadratic A Q (ritzValueAt A hA Q i) (ritzValueAt A hA Q (i + p))) x ≤ 0
EXACT_CONTRACT NLA.KE04.krylov_intersection_nonzero: ∀ {n p : ℕ} (A : Mat n) (V : Rect n p) (k : ℕ),
  1 ≤ k →
    FullBlockDimension A V k →
      FullBlockDimension A V (k - 1) →
        ∀ E ≤ krylov A V k, Module.finrank ℝ ↥E = p + 1 → ∃ x, x ≠ 0 ∧ x ∈ E ∧ x ∈ krylov A V (k - 1)
EXACT_CONTRACT NLA.KE04.psd_zero_form_iff_kernel: ∀ {m : ℕ} (M : Mat m),
  Matrix.PosSemidef M → ∀ (x : Vec m), form M x = 0 ↔ (act M) x = 0
EXACT_CONTRACT NLA.KE04.compressedQuadratic_semantics: ∀ {n m : ℕ} (A : Mat n) (Q : Rect n m) (a b : ℝ),
  (∀ (x : Vec n),
      form (compressedQuadratic A Q a b) x =
        form (quadraticMatrix (compression A Q) a b) ((act (Matrix.transpose Q)) x)) ∧
    (Matrix.PosSemidef (quadraticMatrix (compression A Q) a b) → Matrix.PosSemidef (compressedQuadratic A Q a b))
EXACT_CONTRACT NLA.KE04.quadratic_forms_agree: ∀ {n p : ℕ} (A : Mat n),
  Matrix.IsHermitian A →
    ∀ (V : Rect n p) (k j : ℕ),
      1 ≤ k →
        k < j →
          ∀ (Qk : Rect n (k * p)) (Qj : Rect n (j * p)),
            IsKrylovBasis A V k Qk →
              IsKrylovBasis A V j Qj →
                ∀ x ∈ krylov A V (k - 1),
                  ∀ (a b : ℝ), form (compressedQuadratic A Qk a b) x = form (compressedQuadratic A Qj a b) x
EXACT_CONTRACT NLA.KE04.later_quadratic_identity: ∀ {n p : ℕ} (A : Mat n) (V : Rect n p) (k j : ℕ),
  1 ≤ k →
    k < j →
      ∀ (Qj : Rect n (j * p)),
        IsKrylovBasis A V j Qj →
          ∀ x ∈ krylov A V (k - 1),
            ∀ (a b : ℝ), (act (compressedQuadratic A Qj a b)) x = (act (quadraticMatrix A a b)) x
EXACT_CONTRACT NLA.KE04.fullRank_quadratic_nonannihilation: ∀ {n p : ℕ} (A : Mat n) (V : Rect n p) (k : ℕ),
  2 ≤ k →
    FullBlockDimension A V (k + 1) → ∀ x ∈ krylov A V (k - 1), x ≠ 0 → ∀ (a b : ℝ), (act (quadraticMatrix A a b)) x ≠ 0
EXACT_CONTRACT NLA.KE04.strictIntervalOccupancy: FullPrefixBlockLanczosClaim
EXACT_CONTRACT NLA.KE04.fullPrefix_implies_canonical: FullPrefixBlockLanczosClaim → BlockLanczosConjecture
EXACT_CONTRACT NLA.KE04.blockLanczosConjecture: BlockLanczosConjecture
