277-/-- The eigenvalues for a self-adjoint operator `T` on a
278-finite-dimensional inner product space `E`, sorted in decreasing order -/
279:noncomputable irreducible_def eigenvalues (hT : T.IsSymmetric) (hn : Module.finrank 𝕜 E = n) :
280-    Fin n → ℝ :=
281-  (hT.unsortedEigenvalues hn) ∘ Tuple.sort (hT.unsortedEigenvalues hn) ∘ @Fin.revPerm n
