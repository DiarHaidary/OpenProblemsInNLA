NLA.RA20.generic_critical_locus_proved (U : Mat 3) (hU : GenericData U) :
  criticalSet 3 3 U = Set.range (candidate U) ∧ Function.Injective (candidate U)
NLA.RA20.smoothCritical_hollow_iff (U : Mat 3) (hU : Matrix.IsSymm U) (a b c : ℂ) :
  SmoothCriticalPoint 3 3 U (hollow a b c) ↔
    ExactlyOneZero a b c ∧
      ∀ (u v w : ℂ), b * c * u + a * c * v + a * b * w = 0 → (a - U 0 1) * u + (b - U 0 2) * v + (c - U 1 2) * w = 0
NLA.RA20.algebraic_tangent_space_proved (a b c : ℂ) (h : a * b * c = 0) (Z : Mat 3) :
  TangentVector 3 3 (hollow a b c) Z ↔
    Matrix.IsSymm Z ∧ (∀ (i : Fin 3), Z i i = 0) ∧ b * c * Z 0 1 + a * c * Z 0 2 + a * b * Z 1 2 = 0
NLA.RA20.full_frobenius_differential_proved (n : ℕ) (U X Z : Mat n) :
  (fderiv ℂ (fullFrobeniusDistance U) X) Z = 2 * ∑ i, ∑ j, (X i j - U i j) * Z i j
NLA.RA20.generic_critical_exhaustion (U : Mat 3) (hU : GenericData U) (X : Mat 3) (hX : SmoothCriticalPoint 3 3 U X) :
  ∃ i, candidate U i = X
