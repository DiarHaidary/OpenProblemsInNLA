@[reducible] def NLA.KE04.Mat : (n : Nat) → Type :=
fun (n : Nat) => NLA.KE04.Rect n n
def NLA.KE04.column : {n m : Nat} → (M : NLA.KE04.Rect n m) → (j : Fin m) → NLA.KE04.Vec n :=
fun {n m : Nat} (M : NLA.KE04.Rect n m) (j : Fin m) =>
  @WithLp.toLp.{0}
    (@OfNat.ofNat.{0} ENNReal (nat_lit 2)
