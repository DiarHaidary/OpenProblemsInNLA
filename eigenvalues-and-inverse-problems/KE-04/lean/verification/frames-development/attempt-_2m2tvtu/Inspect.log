theorem NLA.KE04._proved.real_matrix_semantics : ∀ {n m : ℕ} (A : NLA.KE04.Mat n) (M : NLA.KE04.Rect n m),
  (Matrix.IsHermitian A ↔ Matrix.transpose A = A) ∧
    (∀ (x : NLA.KE04.Vec m) (i : Fin n), ((NLA.KE04.act M) x).ofLp i = ∑ j, M i j * x.ofLp j) ∧
      (Matrix.transpose M * M = 1 ↔ Orthonormal ℝ (NLA.KE04.column M)) :=
fun {n m} A M =>
  ⟨of_eq_true
      (Eq.trans
        (congrFun' (congrArg Iff (congrFun' (congrArg Eq (Matrix.conjTranspose_eq_transpose_of_trivial A)) A))
          (Matrix.transpose A = A))
        (iff_self (Matrix.transpose A = A))),
    ⟨NLA.KE04._proved.act_apply M, NLA.KE04._proved.frame_iff_orthonormal M⟩⟩
theorem NLA.KE04._proved.krylovBasis_exists : ∀ {n p : ℕ} (A : NLA.KE04.Mat n) (V : NLA.KE04.Rect n p) (ell : ℕ),
  NLA.KE04.FullBlockDimension A V ell → ∃ Q, NLA.KE04.IsKrylovBasis A V ell Q :=
fun {n p} A V ell hfull => NLA.KE04._proved.submodule_frame_exists (NLA.KE04.krylov A V ell) hfull
theorem NLA.KE04._proved.frameProjection_semantics : ∀ {n m : ℕ} (Q : NLA.KE04.Rect n m),
  Matrix.transpose Q * Q = 1 →
    Matrix.IsHermitian (NLA.KE04.frameProjection Q) ∧
      NLA.KE04.frameProjection Q * NLA.KE04.frameProjection Q = NLA.KE04.frameProjection Q ∧
        (∀ (x : NLA.KE04.Vec n), x ∈ NLA.KE04.columnSpace Q ↔ (NLA.KE04.act (NLA.KE04.frameProjection Q)) x = x) ∧
          ∀ (x y : NLA.KE04.Vec n),
            y ∈ NLA.KE04.columnSpace Q → inner ℝ y (x - (NLA.KE04.act (NLA.KE04.frameProjection Q)) x) = 0 :=
fun {n m} Q hQ =>
  ⟨of_eq_true
      (Eq.trans
        (congr
          (congrArg Eq
            (Eq.trans
              (Eq.trans
                (congrArg Matrix.conjTranspose
                  (congrArg (HMul.hMul Q) (Matrix.conjTranspose_eq_transpose_of_trivial Q)))
                (Matrix.conjTranspose_eq_transpose_of_trivial (Q * Matrix.transpose Q)))
              (Eq.trans (Matrix.transpose_mul Q (Matrix.transpose Q))
                (congrFun' (congrArg HMul.hMul (Matrix.transpose_transpose Q)) (Matrix.transpose Q)))))
          (congrArg (HMul.hMul Q) (Matrix.conjTranspose_eq_transpose_of_trivial Q)))
        (eq_self (Q * Matrix.transpose Q))),
    ⟨Eq.mpr
        (id
          (congr
            (congrArg Eq
              (congr (congrArg HMul.hMul (congrArg (HMul.hMul Q) (Matrix.conjTranspose_eq_transpose_of_trivial Q)))
                (congrArg (HMul.hMul Q) (Matrix.conjTranspose_eq_transpose_of_trivial Q))))
            (congrArg (HMul.hMul Q) (Matrix.conjTranspose_eq_transpose_of_trivial Q))))
        (Trans.trans
          (of_eq_true
            (Eq.trans
              (congr (congrArg Eq (Matrix.mul_assoc Q (Matrix.transpose Q) (Q * Matrix.transpose Q)))
                (Eq.trans (Matrix.mul_assoc Q (Matrix.transpose Q * Q) (Matrix.transpose Q))
                  (congrArg (HMul.hMul Q) (Matrix.mul_assoc (Matrix.transpose Q) Q (Matrix.transpose Q)))))
              (eq_self (Q * (Matrix.transpose Q * (Q * Matrix.transpose Q))))))
          (Eq.mpr (id (congrArg (fun _a => Q * _a * Matrix.transpose Q = Q * Matrix.transpose Q) hQ))
            (Eq.mpr (id (congrArg (fun _a => _a * Matrix.transpose Q = Q * Matrix.transpose Q) (Matrix.mul_one Q)))
              (Eq.refl (Q * Matrix.transpose Q))))),
      ⟨NLA.KE04._proved.frameProjection_fixed_iff Q hQ, fun x y hy =>
        Exists.casesOn (Eq.mp (congrArg (fun _a => y ∈ _a) (NLA.KE04._proved.columnSpace_eq_range_act Q)) hy) fun z h =>
          h ▸
            Eq.mpr
              (id
                (congrArg (fun _a => _a = 0)
                  (NLA.KE04._proved.inner_act_left Q z (x - (NLA.KE04.act (NLA.KE04.frameProjection Q)) x))))
              (Eq.mpr
                (id
                  (congrArg (fun _a => inner ℝ z _a = 0)
                    (map_sub (NLA.KE04.act (Matrix.transpose Q)) x ((NLA.KE04.act (NLA.KE04.frameProjection Q)) x))))
                (Eq.mpr
                  (id
                    (congrArg
                      (fun _a =>
                        inner ℝ z ((NLA.KE04.act (Matrix.transpose Q)) x - (NLA.KE04.act (Matrix.transpose Q)) _a) = 0)
                      (NLA.KE04._proved.frameProjection_act Q x)))
                  (Eq.mpr
                    (id
                      (congrArg (fun _a => inner ℝ z ((NLA.KE04.act (Matrix.transpose Q)) x - _a) = 0)
                        (NLA.KE04._proved.act_transpose_act Q hQ ((NLA.KE04.act (Matrix.transpose Q)) x))))
                    (Eq.mpr
                      (id (congrArg (fun _a => inner ℝ z _a = 0) (sub_self ((NLA.KE04.act (Matrix.transpose Q)) x))))
                      (Eq.mpr (id (congrArg (fun _a => _a = 0) (inner_zero_right z))) (Eq.refl 0))))))⟩⟩⟩
theorem NLA.KE04._proved.compression_semantics : ∀ {n m : ℕ} (A : NLA.KE04.Mat n),
  Matrix.IsHermitian A →
    ∀ (Q : NLA.KE04.Rect n m),
      Matrix.transpose Q * Q = 1 →
        NLA.KE04.compression A Q = Matrix.transpose Q * A * Q ∧
          Matrix.IsHermitian (NLA.KE04.compression A Q) ∧
            ∀ x ∈ NLA.KE04.columnSpace Q,
              (NLA.KE04.act Q) ((NLA.KE04.act (NLA.KE04.compression A Q)) ((NLA.KE04.act (Matrix.transpose Q)) x)) =
                (NLA.KE04.act (NLA.KE04.frameProjection Q)) ((NLA.KE04.act A) x) :=
fun {n m} A hA Q hQ =>
  ⟨of_eq_true
      (Eq.trans
        (congrFun'
          (congrArg Eq
            (congrFun'
              (congrArg HMul.hMul (congrFun' (congrArg HMul.hMul (Matrix.conjTranspose_eq_transpose_of_trivial Q)) A))
              Q))
          (Matrix.transpose Q * A * Q))
        (eq_self (Matrix.transpose Q * A * Q))),
    ⟨Matrix.isHermitian_conjTranspose_mul_mul Q hA, fun x hx =>
      have hrep :=
        Eq.trans (Eq.symm (NLA.KE04._proved.frameProjection_act Q x))
          ((NLA.KE04._proved.frameProjection_fixed_iff Q hQ x).mp hx);
      of_eq_true
        (Eq.trans
          (congr
            (congrArg Eq
              (congrArg (⇑(NLA.KE04.act Q))
                (Eq.trans
                  (Eq.trans
                    (congrFun'
                      (congrArg DFunLike.coe
                        (congrArg NLA.KE04.act
                          (congrFun'
                            (congrArg HMul.hMul
                              (congrFun' (congrArg HMul.hMul (Matrix.conjTranspose_eq_transpose_of_trivial Q)) A))
                            Q)))
                      ((NLA.KE04.act (Matrix.transpose Q)) x))
                    (NLA.KE04._proved.act_mul (Matrix.transpose Q * A) Q ((NLA.KE04.act (Matrix.transpose Q)) x)))
                  (Eq.trans (congrArg (⇑(NLA.KE04.act (Matrix.transpose Q * A))) hrep)
                    (NLA.KE04._proved.act_mul (Matrix.transpose Q) A x)))))
            (NLA.KE04._proved.frameProjection_act Q ((NLA.KE04.act A) x)))
          (eq_self ((NLA.KE04.act Q) ((NLA.KE04.act (Matrix.transpose Q)) ((NLA.KE04.act A) x)))))⟩⟩
theorem NLA.KE04._proved.compressedQuadratic_semantics : ∀ {n m : ℕ} (A : NLA.KE04.Mat n) (Q : NLA.KE04.Rect n m)
  (a b : ℝ),
  (∀ (x : NLA.KE04.Vec n),
      NLA.KE04.form (NLA.KE04.compressedQuadratic A Q a b) x =
        NLA.KE04.form (NLA.KE04.quadraticMatrix (NLA.KE04.compression A Q) a b)
          ((NLA.KE04.act (Matrix.transpose Q)) x)) ∧
    (Matrix.PosSemidef (NLA.KE04.quadraticMatrix (NLA.KE04.compression A Q) a b) →
      Matrix.PosSemidef (NLA.KE04.compressedQuadratic A Q a b)) :=
fun {n m} A Q a b =>
  ⟨fun x =>
    of_eq_true
      (Eq.trans
        (congr
          (congrArg Eq
            (Eq.trans
              (Eq.trans
                (congrArg (inner ℝ x)
                  (Eq.trans
                    (Eq.trans
                      (congrFun'
                        (congrArg DFunLike.coe
                          (congrArg NLA.KE04.act
                            (congrArg (HMul.hMul (Q * NLA.KE04.quadraticMatrix (NLA.KE04.compression A Q) a b))
                              (Matrix.conjTranspose_eq_transpose_of_trivial Q))))
                        x)
                      (NLA.KE04._proved.act_mul (Q * NLA.KE04.quadraticMatrix (NLA.KE04.compression A Q) a b)
                        (Matrix.transpose Q) x))
                    (NLA.KE04._proved.act_mul Q (NLA.KE04.quadraticMatrix (NLA.KE04.compression A Q) a b)
                      ((NLA.KE04.act (Matrix.transpose Q)) x))))
                (NLA.KE04._proved.inner_act_transpose Q x
                  ((NLA.KE04.act (NLA.KE04.quadraticMatrix (NLA.KE04.compression A Q) a b))
                    ((NLA.KE04.act (Matrix.transpose Q)) x))))
              (Eq.trans
                (NLA.KE04._proved.inner_act_transpose (NLA.KE04.quadraticMatrix (NLA.KE04.compression A Q) a b)
                  ((NLA.KE04.act (Matrix.transpose Q)) x) ((NLA.KE04.act (Matrix.transpose Q)) x))
                (NLA.KE04._proved.inner_act_transpose (Matrix.transpose Q)
                  ((NLA.KE04.act (Matrix.transpose (NLA.KE04.quadraticMatrix (NLA.KE04.compression A Q) a b)))
                    ((NLA.KE04.act (Matrix.transpose Q)) x))
                  x))))
          (Eq.trans
            (NLA.KE04._proved.inner_act_transpose (NLA.KE04.quadraticMatrix (NLA.KE04.compression A Q) a b)
              ((NLA.KE04.act (Matrix.transpose Q)) x) ((NLA.KE04.act (Matrix.transpose Q)) x))
            (NLA.KE04._proved.inner_act_transpose (Matrix.transpose Q)
              ((NLA.KE04.act (Matrix.transpose (NLA.KE04.quadraticMatrix (NLA.KE04.compression A Q) a b)))
                ((NLA.KE04.act (Matrix.transpose Q)) x))
              x)))
        (eq_self
          (inner ℝ
            ((NLA.KE04.act (Matrix.transpose Q).transpose)
              ((NLA.KE04.act (Matrix.transpose (NLA.KE04.quadraticMatrix (NLA.KE04.compression A Q) a b)))
                ((NLA.KE04.act (Matrix.transpose Q)) x)))
            x))),
    fun h => Matrix.PosSemidef.mul_mul_conjTranspose_same h Q⟩
theorem NLA.KE04._proved.submodule_frame_exists : ∀ {n m : ℕ} (S : Submodule ℝ (NLA.KE04.Vec n)),
  Module.finrank ℝ ↥S = m → ∃ Q, Matrix.transpose Q * Q = 1 ∧ NLA.KE04.columnSpace Q = S :=
fun {n m} S hS =>
  let b := (stdOrthonormalBasis ℝ ↥S).reindex (finCongr hS);
  let Q := fun i j => (↑(b j)).ofLp i;
  have hc := funext fun j => PiLp.ext fun i => Eq.refl ((NLA.KE04.column Q j).ofLp i);
  Exists.intro Q
    ⟨(NLA.KE04._proved.frame_iff_orthonormal Q).mpr
        (Eq.mpr (id (congrArg (fun _a => Orthonormal ℝ _a) hc))
          (Orthonormal.comp_linearIsometry (OrthonormalBasis.orthonormal b) S.subtypeₗᵢ)),
      id
        (Eq.mpr (id (congrArg (fun _a => Submodule.span ℝ (Set.range _a) = S) hc))
          (have hmap := congrArg (Submodule.map S.subtype) (Module.Basis.span_eq b.toBasis);
          Eq.mp
            (congr
              (congrArg Eq
                (Eq.trans (Submodule.map_span S.subtype (Set.range ⇑b))
                  (congrArg (Submodule.span ℝ) (NLA.KE04._proved.submodule_frame_exists._simp_1_1 ⇑S.subtype ⇑b))))
              (Submodule.map_subtype_top S))
            hmap))⟩
