    hv
theorem NLA.KE04._proved.spectral_gap_quadratic_psd : ∀ {m : ℕ} (M : NLA.KE04.Mat m) (hM : Matrix.IsHermitian M)
  (a b : ℝ),
  a ≤ b →
    (∀ (r : Fin m), ¬(a < NLA.KE04.orderedEigenvalues M hM r ∧ NLA.KE04.orderedEigenvalues M hM r < b)) →
      Matrix.PosSemidef (NLA.KE04.quadraticMatrix M a b) :=
fun {m} M hM a b hab hgap =>
  let B := NLA.KE04.orderedEigenbasis M hM;
  let d := fun r => (NLA.KE04.orderedEigenvalues M hM r - a) * (NLA.KE04.orderedEigenvalues M hM r - b);
  have hd := fun r =>
    if h : NLA.KE04.orderedEigenvalues M hM r ≤ a then
      mul_nonneg_of_nonpos_of_nonpos (sub_nonpos.mpr h) (sub_nonpos.mpr (LE.le.trans h hab))
    else
      have hb := Decidable.byContradiction fun hn => hgap r ⟨lt_of_not_ge h, lt_of_not_ge hn⟩;
      mul_nonneg (sub_nonneg.mpr (LE.le.trans hab hb)) (sub_nonneg.mpr hb);
  have heig := fun r =>
    NLA.KE04._proved.quadratic_apply_eigenvector M a b (NLA.KE04.orderedEigenvalues M hM r) (B r)
      ((NLA.KE04._proved.orderedSpectrum_semantics M hM).right.left r);
  have hdiag :=
    Matrix.ext fun i j =>
      Eq.mpr
        (id
          (congrFun'
            (congrArg Eq
              (Eq.trans
                (LinearMap.toMatrix_apply B.toBasis B.toBasis (NLA.KE04.act (NLA.KE04.quadraticMatrix M a b)) i j)
                (Eq.trans
                  (congrFun'
                    (congrArg DFunLike.coe
                      (Eq.trans (congrArg (⇑B.toBasis.repr) ((fun r => heig r) j))
                        (map_smul B.toBasis.repr (d j) (B j))))
                    i)
                  (Eq.trans
                    (congrArg (HSMul.hSMul (d j))
                      (Eq.trans (OrthonormalBasis.coe_toBasis_repr_apply B (B j) i)
                        (Eq.trans (congrFun (congrArg WithLp.ofLp (OrthonormalBasis.repr_self B j)) i)
                          (PiLp.single_apply 2 ℝ j 1 i))))
                    (Eq.trans (mul_ite (i = j) (d j) 1 0)
                      (ite_congr (Eq.refl (i = j)) (fun a => mul_one (d j)) fun a => mul_zero (d j)))))))
            (if i = j then d i else 0)))
        (if h : i = j then
          Eq.mpr (id (congr (congrArg Eq (if_pos h)) (if_pos h)))
            (of_eq_true (Eq.trans (congrArg (Eq (d j)) (congrArg d h)) (eq_self (d j))))
        else Eq.mpr (id (congr (congrArg Eq (if_neg h)) (if_neg h))) (of_eq_true (eq_self 0)));
  Matrix.isPositive_toEuclideanLin_iff.mp
    ((LinearMap.posSemidef_toMatrix_iff B).mp
      (Eq.mpr
        (id
          (congrArg (fun _a => ((LinearMap.toMatrix B.toBasis B.toBasis) _a).PosSemidef)
            (have this := rfl;
            this)))
        (Eq.mpr (id (congrArg (fun _a => _a.PosSemidef) hdiag)) (Matrix.PosSemidef.diagonal hd))))
theorem NLA.KE04._proved.psd_zero_form_iff_kernel : ∀ {m : ℕ} (M : NLA.KE04.Mat m),
  Matrix.PosSemidef M → ∀ (x : NLA.KE04.Vec m), NLA.KE04.form M x = 0 ↔ (NLA.KE04.act M) x = 0 :=
fun {m} M hM x =>
  Eq.mpr
    (id
      (congr
        (congrArg Iff
          (congrFun'
            (congrArg Eq
              (Eq.trans (congrArg (dotProduct (Matrix.mulVec M x.ofLp)) (star_trivial x.ofLp))
                (dotProduct_comm (Matrix.mulVec M x.ofLp) x.ofLp)))
            0))
        (NLA.KE04._proved.psd_zero_form_iff_kernel._simp_1_3 2)))
    (Eq.mp
      (congrFun'
        (congrArg Iff
          (congrFun' (congrArg Eq (congrFun' (congrArg dotProduct (star_trivial x.ofLp)) (Matrix.mulVec M x.ofLp))) 0))
        (Matrix.mulVec M x.ofLp = 0))
      (Matrix.PosSemidef.dotProduct_mulVec_zero_iff hM x.ofLp))
