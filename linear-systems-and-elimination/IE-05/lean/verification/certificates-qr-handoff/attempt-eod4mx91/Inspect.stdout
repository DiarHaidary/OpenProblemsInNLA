@[instance_reducible] def Int.instDecidableEq : DecidableEq ℤ :=
Int.decEq
@[implicit_reducible] protected def Int.decEq : (a b : ℤ) → Decidable (a = b) :=
fun a b =>
  match a, b with
  | Int.ofNat a, Int.ofNat b =>
    match decEq a b with
    | isTrue h => isTrue ⋯
    | isFalse h => isFalse ⋯
  | Int.ofNat a, Int.negSucc a_1 => isFalse ⋯
  | Int.negSucc a, Int.ofNat a_1 => isFalse ⋯
  | Int.negSucc a, Int.negSucc b =>
    match decEq a b with
    | isTrue h => isTrue ⋯
    | isFalse h => isFalse ⋯
