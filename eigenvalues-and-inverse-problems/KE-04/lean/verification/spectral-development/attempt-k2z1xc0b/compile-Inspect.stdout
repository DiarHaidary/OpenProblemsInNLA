EXACT_FROZEN_TYPE NLA.KE04._proved.orderedSpectrum_semantics: ∀ {m : ℕ} (M : NLA.KE04.Mat m)
  (hM : Matrix.IsHermitian M),
  Monotone (NLA.KE04.orderedEigenvalues M hM) ∧
    (∀ (r : Fin m),
        (NLA.KE04.act M) ((NLA.KE04.orderedEigenbasis M hM) r) =
          NLA.KE04.orderedEigenvalues M hM r • (NLA.KE04.orderedEigenbasis M hM) r) ∧
      (Matrix.charpoly M).roots = Multiset.map (NLA.KE04.orderedEigenvalues M hM) Finset.univ.val ∧
        ∀ (i : ℕ) (hi : i < m), NLA.KE04.eigenvalueAt M hM i = NLA.KE04.orderedEigenvalues M hM ⟨i, hi⟩
EXACT_FROZEN_TYPE NLA.KE04._proved.quadratic_semantics: ∀ {m : ℕ} (M : NLA.KE04.Mat m) (a b : ℝ),
  (NLA.KE04.monicQuadratic a b).Monic ∧
    (NLA.KE04.monicQuadratic a b).natDegree = 2 ∧
      NLA.KE04.quadraticMatrix M a b = (Polynomial.aeval M) (NLA.KE04.monicQuadratic a b) ∧
        NLA.KE04.quadraticMatrix M a b = M ^ 2 - (a + b) • M + (a * b) • 1
EXACT_FROZEN_TYPE NLA.KE04._proved.spectral_gap_quadratic_psd: ∀ {m : ℕ} (M : NLA.KE04.Mat m)
  (hM : Matrix.IsHermitian M) (a b : ℝ),
  a ≤ b →
    (∀ (r : Fin m), ¬(a < NLA.KE04.orderedEigenvalues M hM r ∧ NLA.KE04.orderedEigenvalues M hM r < b)) →
      Matrix.PosSemidef (NLA.KE04.quadraticMatrix M a b)
EXACT_FROZEN_TYPE NLA.KE04._proved.psd_zero_form_iff_kernel: ∀ {m : ℕ} (M : NLA.KE04.Mat m),
  Matrix.PosSemidef M → ∀ (x : NLA.KE04.Vec m), NLA.KE04.form M x = 0 ↔ (NLA.KE04.act M) x = 0
