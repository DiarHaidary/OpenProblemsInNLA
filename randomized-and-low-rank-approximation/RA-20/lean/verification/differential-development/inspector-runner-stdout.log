        (id
          (congr
            (congrArg Eq
              (Eq.trans
                (Eq.trans
                  (congrFun'
                    (congrArg DFunLike.coe
                      (Eq.trans (sum_apply Finset.univ (fun i => (2 • L i).smulRight (L i)) h)
                        (congrArg Finset.univ.sum
                          (funext fun i => congrFun' (congrArg HSMul.hSMul (smul_apply (L i) 2 h)) (L i)))))
